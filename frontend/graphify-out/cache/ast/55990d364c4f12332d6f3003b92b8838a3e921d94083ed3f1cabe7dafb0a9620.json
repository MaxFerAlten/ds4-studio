on": "L141"}, {"caller_nid": "research_researchruntime_researchruntime_launch", "callee": "catch", "is_member_call": true, "source_file": "/mnt/samsung_ai/COPARATOR/ds4-studio/frontend/server/research/researchRuntime.mjs", "source_location": "L141"}, {"caller_nid": "research_researchruntime_researchruntime_launch", "callee": "(async () => {\n      // Load the session RAG corpus (if any uploaded documents) before the graph\n      // runs, so the background investigator and researchers can retrieve from it.\n      ctx.rag = await this.store.loadRagIndex(state.sessionId).catch(() => null);\n      // Web search layer (no-op unless research.search.enabled and a provider is\n      // configured).\n      try {\n        ctx.searchService = this.searchServiceFactory(ctx.config);\n      } catch (err) {\n        this.logger?.warn?.(`research: search service unavailable: ${err.message}`);\n        ctx.searchService = null;\n      }\n      const engineName = this.engines[state.engine] ? state.engine : \"local\";\n      const engine = this.engines[engineName];\n      if (engineName === \"gemini\") {\n        const geminiConfig = ctx.config.gemini || {};\n        ctx.gemini = new GeminiResearchClient({\n          apiKey: resolveApiKey(geminiConfig),\n          baseUrl: geminiConfig.baseUrl,\n          timeoutMs: geminiConfig.timeoutMs\n        });\n        // A feedback-resume launch carries an accepted plan + an interaction id;\n        // Gemini resumes the stored interaction instead of starting fresh.\n        if (state.feedback?.accepted && state.interactionId) {\n          return engine.submitFeedback(ctx, state.feedback.action);\n        }\n      } else if (engineName === \"prism\") {\n        const prismConfig = ctx.config.prism || {};\n        ctx.prism = new PrintingPressPrismResearchClient({\n          cliPath: resolveEnvBackedValue(prismConfig, \"cliPath\") || \"prism-pp-cli\",\n          cookiesEnv: prismConfig.cookiesEnv,\n          timeoutMs: prismConfig.timeoutMs,\n          pollIntervalMs: prismConfig.pollIntervalMs,\n          reasoningEffort: prismConfig.reasoningEffort,\n          projectId: prismConfig.projectId,\n          userId: prismConfig.userId\n        });\n      }\n      return engine.run(ctx);\n    })", "is_member_call": false, "source_file": "/mnt/samsung_ai/COPARATOR/ds4-studio/frontend/server/research/researchRuntime.mjs", "source_location": "L141"}, {"caller_nid": "research_researchruntime_researchruntime_feedback", "callee": "assign", "is_member_call": true, "source_file": "/mnt/samsung_ai/COPARATOR/ds4-studio/frontend/server/research/researchRuntime.mjs", "source_location": "L201"}, {"caller_nid": "research_researchruntime_researchruntime_feedback", "callee": "toISOString", "is_member_call": true, "source_file": "/mnt/samsung_ai/COPARATOR/ds4-studio/frontend/server/research/researchRuntime.mjs", "source_location": "L208"}, {"caller_nid": "research_researchruntime_researchruntime_feedback", "callee": "isArray", "is_member_call": true, "source_file": "/mnt/samsung_ai/COPARATOR/ds4-studio/frontend/server/research/researchRuntime.mjs", "source_location": "L210"}, {"caller_nid": "research_researchruntime_researchruntime_feedback", "callee": "assign", "is_member_call": true, "source_file": "/mnt/samsung_ai/COPARATOR/ds4-studio/frontend/server/research/researchRuntime.mjs", "source_location": "L211"}, {"caller_nid": "research_researchruntime_researchruntime_feedback", "callee": "toISOString", "is_member_call": true, "source_file": "/mnt/samsung_ai/COPARATOR/ds4-studio/frontend/server/research/researchRuntime.mjs", "source_location": "L214"}, {"caller_nid": "research_researchruntime_researchruntime_feedback", "callee": "getConfig", "is_member_call": true, "source_file": "/mnt/samsung_ai/COPARATOR/ds4-studio/frontend/server/research/researchRuntime.mjs", "source_location": "L216"}, {"caller_nid": "research_researchruntime_researchruntime_feedback", "callee": "assign", "is_member_call": true, "source_file": "/mnt/sam