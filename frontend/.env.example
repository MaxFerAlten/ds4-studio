# Deep Research provider credentials.
# Copy this file to `frontend/.env` and fill the keys you have.
# Loaded at server boot by server/index.mjs (process.loadEnvFile).
# Providers without a key/endpoint are skipped with a warning — no crash.
# Already-exported shell vars take precedence over this file.

# --- Keyless providers (active out of the box, no entry needed) ---
# wikipedia, openalex, worldbank

# --- Keyed search providers ---
TAVILY_API_KEY=
SERPAPI_KEY=               # used by both serpapi (engine=google) and googlescholar
OPENTRIPMAP_API_KEY=
TRIPADVISOR_API_KEY=       # also needs providers.tripadvisor.endpoint in ds4-ui.config.json
ALIYUN_AI_SEARCH_API_KEY=  # also needs providers.aliyun.endpoint
BAIDU_SEARCH_API_KEY=      # also needs providers.baidu.endpoint

# --- Page reader (enriches fetched pages, not a search provider) ---
JINA_API_KEY=

# --- Gemini Deep Research engine (optional; paid Google cloud, ~$1-7/task) ---
# Only needed when running a research session with engine="gemini".
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Agno Agent UI is supervised by DS4 config.
# Do not put DS4_AGNO_SERVICE_TOKEN or DS4_AGNO_MODEL_GATEWAY_TOKEN here.
NEXT_TELEMETRY_DISABLED=1

# --- ContextWiki: delta-safe session context capsule (default OFF) ---
# Reduces context loss on long agent tasks. Default is preview-only: it builds
# and logs a capsule + telemetry but never injects it, so the agent behaves
# exactly like baseline. Only flip WIKI_ENABLED=1 + PREVIEW_ONLY=0 after the
# preflight/delta-safety tests are green and preview telemetry looks healthy.
DS4_CONTEXT_WIKI_ENABLED=0            # 1 = actually inject the capsule
DS4_CONTEXT_PREVIEW_ONLY=1           # 1 = build/log only, never inject
DS4_CONTEXT_CAPSULE_SOFT_TOKENS=1500 # prune the capsule above this
DS4_CONTEXT_CAPSULE_HARD_TOKENS=3000 # never inject above this (hard cap)
DS4_CONTEXT_CAPSULE_MAX_GROWTH_PCT=25 # block if capsule grows > this vs previous
DS4_CONTEXT_CAPSULE_MAX_EVIDENCE=10  # max evidence items in a capsule
DS4_CONTEXT_DELTA_REQUIRED=1         # revision>0 must stay delta or capsule is blocked
DS4_CONTEXT_LOG_TELEMETRY=1          # write JSONL preflight telemetry
DS4_CONTEXT_MAX_LEDGER_EVENTS=5000   # per-session cap for ledger/evidence/telemetry
