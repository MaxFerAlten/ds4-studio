# Deep Research provider credentials.
# Copy this file to `frontend/.env` and fill the keys you have.
# Loaded at server boot by server/index.mjs (process.loadEnvFile).
# Providers without a key/endpoint are skipped with a warning — no crash.
# Already-exported shell vars take precedence over this file.

# --- Keyless providers (active out of the box, no entry needed) ---
# wikipedia, openalex, worldbank

# --- Keyed search providers ---
TAVILY_API_KEY=
SERPAPI_KEY=               # used by both serpapi (engine=google) and googlescholar
OPENTRIPMAP_API_KEY=
TRIPADVISOR_API_KEY=       # also needs providers.tripadvisor.endpoint in ds4-ui.config.json
ALIYUN_AI_SEARCH_API_KEY=  # also needs providers.aliyun.endpoint
BAIDU_SEARCH_API_KEY=      # also needs providers.baidu.endpoint

# --- Page reader (enriches fetched pages, not a search provider) ---
JINA_API_KEY=

# --- Gemini Deep Research engine (optional; paid Google cloud, ~$1-7/task) ---
# Only needed when running a research session with engine="gemini".
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
