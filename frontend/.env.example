# Local credentials only. Copy to frontend/.env and fill only the services used.
# The file is loaded by frontend/server/index.mjs. Exported shell variables win.
# Never commit frontend/.env.
#
# Application settings do not belong here: Lean, Sage and ContextWiki are typed
# fields in frontend/ds4-ui.config.json, GPU tuning lives in its server.env.

# Search providers
TAVILY_API_KEY=
SERPAPI_KEY=
SCRAPINGBEE_API_KEY=
OPENTRIPMAP_API_KEY=
TRIPADVISOR_API_KEY=
ALIYUN_AI_SEARCH_API_KEY=
BAIDU_SEARCH_API_KEY=

# Page reader
JINA_API_KEY=

# Gemini Deep Research
GEMINI_API_KEY=

# Prism authentication; leave empty unless the Prism engine is used.
PRISM_COOKIES=

# Privileged Evolution write token; leave empty unless Evolution writes are enabled.
DS4_EVOLUTION_WRITE_TOKEN=
