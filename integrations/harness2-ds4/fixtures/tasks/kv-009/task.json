{
  "deliverables": [
    "settings.json"
  ],
  "evaluator_id": "eval-kv-009",
  "family": "kv",
  "id": "kv-009",
  "prompt_file": "task.md",
  "schema_version": 1,
  "scripted": {
    "edit": {
      "description": "Extract settings from loosely formatted key/value files",
      "rules": [
        "skip-comment-lines",
        "strip-quotes",
        "colon-separator",
        "lowercase-keys"
      ],
      "skill": "kv-extract",
      "trigger": "When settings files mix separators, quotes or comments"
    },
    "op": {
      "input": "settings.conf",
      "op": "kv_extract",
      "output": "settings.json"
    }
  },
  "split": "val",
  "tags": [
    "lowercase-keys",
    "strip-quotes"
  ],
  "work": "extract settings from loosely formatted configuration text into JSON",
  "workspace_dir": "workspace"
}
