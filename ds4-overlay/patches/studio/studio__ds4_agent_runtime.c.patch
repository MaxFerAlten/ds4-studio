     rt->cfg.gen.think_mode = (opt && opt->nothink) ? DS4_THINK_NONE : DS4_THINK_HIGH;
     rt->cfg.gen.prompt = NULL; /* not one-shot */
     rt->cfg.gen.system = opt ? opt->system_prompt : NULL;
