@@ -591,6 +600,14 @@
     pthread_mutex_unlock(&rt->worker.mu);
 }
 
+bool ds4_agent_runtime_set_openwiki_enabled(ds4_agent_runtime *rt, bool enabled) {
+    if (!rt) return false;
+    bool available = rt->cfg.openwiki_config_valid &&
+                     rt->cfg.openwiki_config.mode == DS4_OW_ON;
+    rt->cfg.openwiki_enabled = enabled && available;
+    return !enabled || available;
+}
