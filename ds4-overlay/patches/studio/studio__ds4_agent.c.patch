+/* Maximum Lean source we will ship to the server, mirroring
+ * LEAN_MAX_SOURCE_BYTES on the Node side. Checked before allocating. */
+#define AGENT_LEAN_MAX_SOURCE_BYTES 524288
+
+/* Largest lean_result_v1 body we will parse. */
+#define AGENT_LEAN_MAX_RESPONSE_BYTES 1048576
+
+/* lean_check timeout contract, mirrored from the Node side: the server accepts
+ * only 1..LEAN_MAX_TIMEOUT_SEC (default 120 there). The previous shared
+ * agent_parse_timeout defaulted to 3600, which validateLeanRequest rejects
+ * with LEAN_TIMEOUT_INVALID. */
+#define AGENT_LEAN_DEFAULT_TIMEOUT_SEC 30
+#define AGENT_LEAN_MAX_TIMEOUT_SEC 120
+
+/* Client-side transport deadline = Lean timeout + margin: an elaboration may
+ * legitimately run for the full request timeout, so the transport must never
+ * cut it off first. */
+#define AGENT_LEAN_HTTP_TIMEOUT_MARGIN_MS 15000
+
+/* Statuses defined by lean_result_v1. Anything else is a protocol error. */
+static bool agent_lean_status_valid(const char *status) {
+    static const char *const allowed[] = {
+        "checked", "failed", "timeout", "cancelled",
+        "rejected", "preflight_failed", "internal_error", NULL
+    };
+    if (!status) return false;
+    for (int i = 0; allowed[i]; i++)
+        if (!strcmp(status, allowed[i])) return true;
+    return false;
+}
+
+/* expectedDeclarations arrives as a raw JSON fragment produced by the model.
+ * Only forward it when it is a flat array of plain Lean identifiers; anything
+ * else is dropped rather than spliced into the request body. */
+static bool agent_lean_declarations_safe(const char *s) {
+    if (!s || s[0] != '[') return false;
+    size_t n = strlen(s);
+    if (n < 2 || n > 512 || s[n - 1] != ']') return false;
+    bool in_str = false;
+    for (size_t i = 1; i + 1 < n; i++) {
+        unsigned char c = (unsigned char)s[i];
+        if (c == '"') { in_str = !in_str; continue; }
+        if (in_str) {
+            if (!(isalnum(c) || c == '_' || c == '.' || c == '\'')) return false;
+        } else if (c != ',' && c != ' ') {
+            return false;
+        }
+    }
+    return !in_str;
+}
+
+/* True when a shell command's executable is part of the Lean toolchain.
+ *
+ * Scans each command position (start of string or after ; & | newline) and
+ * compares the basename of the first word, so a path-qualified binary is
+ * caught while the same word used as data — `grep -n lean README.md` — is not. */
+static bool agent_command_invokes_lean_toolchain(const char *cmd) {
+    static const char *const bins[] = {
+        "lean", "lake", "elan", "leanc", "leanmake", "leanchecker", "leanpkg", NULL
+    };
+    if (!cmd) return false;
+
+    const char *p = cmd;
+    bool at_command = true;
+    while (*p) {
+        if (*p == ' ' || *p == '\t' || *p == '\n') { p++; continue; }
+        if (*p == ';' || *p == '&' || *p == '|' || *p == '(' || *p == ')') {
+            at_command = true;
+            p++;
+            continue;
+        }
+
+        const char *start = p;
+        while (*p && *p != ' ' && *p != '\t' && *p != '\n' &&
+               *p != ';' && *p != '&' && *p != '|' && *p != ')')
+            p++;
+
+        if (at_command) {
+            size_t len = (size_t)(p - start);
+            const char *base = start;
+            for (const char *s = start; s < p; s++)
+                if (*s == '/') base = s + 1;
+            len = (size_t)(p - base);
+            /* Skip a leading VAR=value assignment; the command follows it. */
+            bool assignment = false;
+            for (const char *s = start; s < p; s++)
+                if (*s == '=') { assignment = true; break; }
+            if (!assignment) {
+                for (int i = 0; bins[i]; i++)
+                    if (strlen(bins[i]) == len && !strncmp(base, bins[i], len))
+                        return true;
+                at_command = false;
+            }
+        }
+
+        /* Advance past the separator, if that is where the word stopped. */
+        if (*p && (*p == ';' || *p == '&' || *p == '|' || *p == ')')) {
+            at_command = true;
+            p++;
+        }
+    }
+    return false;
+}
+
+/* Fresh run id per call: an attempt that reuses the previous id would collide
+ * with the server's idempotency registry and be rejected as a replay. */
+static bool agent_lean_turn_ensure_run_id(agent_worker *w) {
+    if (w->lean_turn.run_id[0]) return true;
+    static uint64_t lean_nonce = 1;
+    uint64_t nonce = __sync_fetch_and_add(&lean_nonce, 1);
+    uint64_t sequence = ++w->lean_turn_sequence;
+    const char *sha = w->session_sha[0] ? w->session_sha : "000000000000";
+    int n = snprintf(w->lean_turn.run_id, sizeof(w->lean_turn.run_id),
+                     "lean-%.12s-%llu-%llu", sha,
+                     (unsigned long long)sequence,
+                     (unsigned long long)nonce);
+    return n > 0 && (size_t)n < sizeof(w->lean_turn.run_id);
+}
+
+/* One proof id per Lean turn, minted on first use and stable across every
+ * repair attempt: it is what lets the server group the attempts of one theorem
+ * even though each attempt needs a fresh run id. */
+static bool agent_lean_turn_ensure_proof_id(agent_worker *w) {
+    if (w->lean_turn.proof_id[0]) return true;
+    static uint64_t proof_nonce = 1;
+    uint64_t nonce = __sync_fetch_and_add(&proof_nonce, 1);
+    const char *sha = w->session_sha[0] ? w->session_sha : "000000000000";
+    int n = snprintf(w->lean_turn.proof_id, sizeof(w->lean_turn.proof_id),
+                     "proof-%.12s-%llu-%llu", sha,
+                     (unsigned long long)time(NULL),
+                     (unsigned long long)nonce);
+    return n > 0 && (size_t)n < sizeof(w->lean_turn.proof_id);
+}
+
+/* A utility probe still needs a runId the server accepts (lean-<12 hex>-<n>-<n>)
+ * but must not mint or disturb the turn's proof identity, so it never touches
+ * lean_turn (§13.8). */
+static bool agent_lean_build_utility_run_id(agent_worker *w, char *out, size_t n) {
+    static uint64_t utility_nonce = 1;
+    uint64_t nonce = __sync_fetch_and_add(&utility_nonce, 1);
+    const char *sha = w->session_sha[0] ? w->session_sha : "000000000000";
+    int r = snprintf(out, n, "lean-%.12s-0-%llu", sha,
+                     (unsigned long long)nonce);
+    return r > 0 && (size_t)r < n;
 }
 
