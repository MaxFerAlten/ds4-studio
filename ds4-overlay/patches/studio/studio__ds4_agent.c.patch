+/* A terminal Lean state that never reached status=checked.  The runtime writes
+ * this, not the model: asking a model that has just exhausted its budget to
+ * phrase its own defeat is what produced the empty turns in the transcript.
+ * Built separately from publishing so the wording is testable on its own. */
+static char *agent_lean_not_verified_text(const agent_lean_turn_state *s) {
+    agent_buf b = {0};
+    char line[640];
+
+    agent_buf_puts(&b, "STATE: NOT_VERIFIED\n\n");
+    snprintf(line, sizeof(line), "Reason: %s\n",
+             s->failure_code[0] ? s->failure_code :
+             agent_lean_state_name(s->state));
+    agent_buf_puts(&b, line);
+    if (s->failure_class[0]) {
+        snprintf(line, sizeof(line), "Failure class: %s\n", s->failure_class);
+        agent_buf_puts(&b, line);
+    }
+    snprintf(line, sizeof(line), "Attempts: %d/%d\n", s->attempt_count,
+             s->max_attempts);
+    agent_buf_puts(&b, line);
+    if (s->max_wall_clock_ms > 0) {
+        snprintf(line, sizeof(line),
+                 "Wall clock: %lld ms elapsed of %lld ms (%lld ms left)\n",
+                 (long long)s->elapsed_wall_clock_ms,
+                 (long long)s->max_wall_clock_ms,
+                 (long long)s->remaining_wall_clock_ms);
+        agent_buf_puts(&b, line);
+    }
+    if (s->next_action[0]) {
+        snprintf(line, sizeof(line), "Last action: %s\n", s->next_action);
+        agent_buf_puts(&b, line);
+    }
+    agent_buf_puts(&b,
+        "\nLean did not produce a checked result for the current candidate.\n");
+    if (s->last_source && s->last_source[0]) {
+        /* Labelled "Unverified candidate", never "Verified Lean source": the
+         * label is the whole point of publishing it. */
+        agent_buf_puts(&b, "\nUnverified candidate:\n\n```lean\n");
+        agent_buf_puts(&b, s->last_source);
+        if (s->last_source[strlen(s->last_source) - 1] != '\n')
+            agent_buf_puts(&b, "\n");
+        agent_buf_puts(&b, "```\n");
+    }
+    return agent_buf_take(&b);
+}
+
+static int agent_lean_publish_authoritative_not_verified(agent_worker *w) {
+    return agent_publish_authoritative_text(w,
+        agent_lean_not_verified_text(&w->lean_turn),
+        "LEAN_TERMINAL_NOT_VERIFIED: nessun tool ulteriore ammesso in questo turno.");
+}
+
+/* status=checked.  The published source is the byte sequence Lean actually
+ * accepted, re-hashed here: a proof that cannot be shown to be the one that was
+ * checked is not published as verified. */
+static char *agent_lean_verified_text(const agent_lean_turn_state *s,
+                                      bool *out_ok) {
+    agent_buf b = {0};
+    char line[256];
+    if (out_ok) *out_ok = false;
+
+    if (!s->checked_source || !s->checked_source[0]) {
+        agent_buf_puts(&b,
+            "STATE: NOT_VERIFIED\n\n"
+            "Reason: LEAN_CHECKED_SOURCE_MISSING\n\n"
+            "Lean reported status=checked but the checked source was not "
+            "retained, so nothing can be published as verified.\n");
+        return agent_buf_take(&b);
+    }
+
+    /* Source integrity is not task integrity: bytes Lean accepted can still be
+     * a different theorem than the one this turn was asked to prove. Without a
+     * locked, matching target statement there is nothing to publish (§13.12). */
+    if (!s->target_identity_locked || !s->target_statement_sha256[0]) {
+        agent_buf_puts(&b,
+            "STATE: NOT_VERIFIED\n\n"
+            "Reason: LEAN_TARGET_IDENTITY_MISSING\n\n"
+            "Lean reported status=checked but this turn never locked the target "
+            "statement, so the checked source cannot be shown to be the theorem "
+            "that was requested.\n");
+        return agent_buf_take(&b);
+    }
+    if (strcmp(s->checked_target_statement_sha256, s->target_statement_sha256)) {
+        agent_buf_puts(&b,
+            "STATE: NOT_VERIFIED\n\n"
+            "Reason: LEAN_TARGET_IDENTITY_MISMATCH\n\n"
+            "The checked source does not state the locked target theorem, so it "
+            "must not be published as verified.\n");
+        snprintf(line, sizeof(line), "Locked:  %s\nChecked: %s\n",
+                 s->target_statement_sha256,
+                 s->checked_target_statement_sha256[0]
+                     ? s->checked_target_statement_sha256 : "none");
+        agent_buf_puts(&b, line);
+        return agent_buf_take(&b);
+    }
+
+    char actual[65];
+    ds4_sha256_hex(s->checked_source, strlen(s->checked_source), actual);
+    if (s->checked_source_sha256[0] && strcmp(actual, s->checked_source_sha256)) {
+        agent_buf_puts(&b,
+            "STATE: NOT_VERIFIED\n\n"
+            "Reason: LEAN_CHECKED_SOURCE_INTEGRITY_FAILURE\n\n"
+            "The retained source no longer hashes to the value recorded at "
+            "check time, so it must not be published as verified.\n");
+        snprintf(line, sizeof(line), "Recorded: %s\nActual:   %s\n",
+                 s->checked_source_sha256, actual);
+        agent_buf_puts(&b, line);
+        return agent_buf_take(&b);
+    }
+
+    agent_buf_puts(&b, "STATE: VERIFIED \xe2\x80\x94 status=checked\n");
+    /* The audit metadata names what was proved, not only that something was:
+     * declaration, statement digest, profile, source digest. */
+    snprintf(line, sizeof(line), "Target declaration: %s\n",
+             s->target_declaration[0] ? s->target_declaration : "unknown");
+    agent_buf_puts(&b, line);
+    snprintf(line, sizeof(line), "Target statement SHA-256: %s\n",
+             s->target_statement_sha256);
+    agent_buf_puts(&b, line);
+    snprintf(line, sizeof(line), "Profile: %s\n",
+             s->checked_profile[0] ? s->checked_profile : s->profile);
+    agent_buf_puts(&b, line);
+    snprintf(line, sizeof(line), "Source SHA-256: %s\n\n", actual);
+    agent_buf_puts(&b, line);
+    agent_buf_puts(&b, "```lean\n");
+    agent_buf_puts(&b, s->checked_source);
+    if (s->checked_source[strlen(s->checked_source) - 1] != '\n')
+        agent_buf_puts(&b, "\n");
+    agent_buf_puts(&b, "```\n");
+    if (out_ok) *out_ok = true;
+    return agent_buf_take(&b);
+}
+
+static int agent_lean_publish_verified_fallback(agent_worker *w) {
+    bool ok = false;
+    char *text = agent_lean_verified_text(&w->lean_turn, &ok);
+    return agent_publish_authoritative_text(w, text, ok ? NULL :
+        "LEAN_VERIFIED_PUBLICATION_SUPPRESSED: checked source unusable.");
+}
+
+static int agent_sage_publish_authoritative_fallback(agent_worker *w) {
+    if (agent_sage_publish_authoritative_final(w, true)) {
+        w->authoritative_mode = AGENT_AUTHORITATIVE_COMPLETE;
+        agent_set_status(w, AGENT_WORKER_IDLE);
+        return 0;
+    }
+    agent_buf b = {0};
+    char line[256];
+    agent_buf_puts(&b, "STATE: NOT_PUBLISHABLE\n\n");
+    snprintf(line, sizeof(line), "Reason: %s\n",
+             w->sage_turn.failure_code[0] ? w->sage_turn.failure_code :
+             agent_sage_state_name(w->sage_turn.state));
+    agent_buf_puts(&b, line);
+    agent_buf_puts(&b,
+        "\nThe Sage run reached a terminal state without a validated result, "
+        "so no mathematics is published for it.\n");
+    return agent_publish_authoritative_text(w, agent_buf_take(&b),
+        "SAGE_FINALIZATION_BLOCKED: nessun tool ulteriore ammesso in questo turno.");
+}
+
+/* Whatever the model tried to do while an authoritative task was terminal, the
+ * answer is the domain's own verdict. */
+static int agent_publish_authoritative_fallback(agent_worker *w) {
+    switch (w->authoritative_mode) {
+    case AGENT_AUTHORITATIVE_LEAN_FINALIZATION_ONLY:
+        return w->lean_turn.checked ?
+            agent_lean_publish_verified_fallback(w) :
+            agent_lean_publish_authoritative_not_verified(w);
+    case AGENT_AUTHORITATIVE_SAGE_FINALIZATION_ONLY:
+        return agent_sage_publish_authoritative_fallback(w);
+    case AGENT_AUTHORITATIVE_CONFLICT: {
+        agent_buf b = {0};
+        agent_buf_puts(&b,
+            "STATE: NOT_COMPLETED \xe2\x80\x94 AUTHORITATIVE_MODE_CONFLICT\n\n"
+            "Two authoritative backends were used for the same turn, so neither "
+            "can own the verdict. The turn was stopped by the runtime.\n");
+        return agent_publish_authoritative_text(w, agent_buf_take(&b),
+            "AUTHORITATIVE_MODE_CONFLICT: turno interrotto.");
+    }
+    default: {
+        agent_buf b = {0};
+        agent_buf_puts(&b,
+            "STATE: COMPLETE\n\nThe authoritative result for this task has "
+            "already been published; no further tool call is allowed.\n");
+        return agent_publish_authoritative_text(w, agent_buf_take(&b), NULL);
+    }
+    }
+}
