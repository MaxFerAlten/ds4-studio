+/* Caso C of the reproduction: the model narrates "I'm stuck in a loop" in
+ * different words each round while emitting the same broken protocol.  The
+ * fingerprint must follow the protocol error, not the narrative, or the guard
+ * never fires. */
+static void test_agent_protocol_guard_fingerprint_ignores_narrative(void) {
+    char a[65], b[65], c[65];
+    ds4_agent_protocol_failure_fingerprint(DS4_AGENT_PROTOCOL_FAILURE_DSML_IN_THINK,
+        "tool calling is not allowed inside <think></think>", a);
+    ds4_agent_protocol_failure_fingerprint(DS4_AGENT_PROTOCOL_FAILURE_DSML_IN_THINK,
+        "Tool   calling is NOT allowed inside <think></think>\n", b);
+    AGENT_TEST_ASSERT(!strcmp(a, b));
+
+    /* Variable offsets and token counts must not create a new identity. */
+    ds4_agent_protocol_failure_fingerprint(DS4_AGENT_PROTOCOL_FAILURE_DSML_PARSE,
+        "parse error at byte 1024", a);
+    ds4_agent_protocol_failure_fingerprint(DS4_AGENT_PROTOCOL_FAILURE_DSML_PARSE,
+        "parse error at byte 77", b);
+    AGENT_TEST_ASSERT(!strcmp(a, b));
+
+    /* A genuinely different error must still be a different identity. */
+    ds4_agent_protocol_failure_fingerprint(DS4_AGENT_PROTOCOL_FAILURE_DSML_PARSE,
+        "unterminated string", c);
+    AGENT_TEST_ASSERT(strcmp(a, c) != 0);
+
+    /* Same detail, different class: different identity. */
+    ds4_agent_protocol_failure_fingerprint(DS4_AGENT_PROTOCOL_FAILURE_DSML_INCOMPLETE,
+        "unterminated string", a);
+    AGENT_TEST_ASSERT(strcmp(a, c) != 0);
+
+    /* Printed so the Node test can assert the two implementations agree.  A
+     * divergence here would mean one side never counts a repeat the other
+     * side does, which is the whole guard. */
+    ds4_agent_protocol_failure_fingerprint(DS4_AGENT_PROTOCOL_FAILURE_DSML_IN_THINK,
+        "tool calling is not allowed inside <think></think>. "
+        "You MUST explicitly write </think> BEFORE writing "
+        "<\xef\xbd\x9c" "DSML" "\xef\xbd\x9c" "tool_calls>", a);
+    printf("PROTOCOL_FINGERPRINT DSML_TOOL_INSIDE_THINK=%s\n", a);
+}
