+/* QF-22 §44 — the rules reach the model, and the reminder carries the digest
+ * rather than the whole block. A prompt rule nobody injected is a rule that
+ * does not exist. */
+static void test_agent_epistemic_prompt_parity(void) {
+    char *full = agent_build_conduct_note(true);
+    AGENT_TEST_ASSERT(full != NULL);
+    if (full) {
+        AGENT_TEST_ASSERT(strstr(full, "# Epistemic rules") != NULL);
+        AGENT_TEST_ASSERT(strstr(full, "A hypothesis remains a hypothesis") != NULL);
+        AGENT_TEST_ASSERT(strstr(full,
+            "unless a real tool/source result in this turn supports it") != NULL);
+        AGENT_TEST_ASSERT(strstr(full, "do not invent identifiers") != NULL);
+        AGENT_TEST_ASSERT(strstr(full, "not automatically ground truth") != NULL);
+        AGENT_TEST_ASSERT(strstr(full, "preserve UNKNOWN instead of filling the gap") != NULL);
+        /* The conduct rules are still there: this adds to them. */
+        AGENT_TEST_ASSERT(strstr(full, "# Operating rules") != NULL);
+        /* Full block, not the digest as well. */
+        AGENT_TEST_ASSERT(strstr(full, "Do not promote analogy") == NULL);
+        free(full);
+    }
+
+    char *digest = agent_build_conduct_note(false);
+    AGENT_TEST_ASSERT(digest != NULL);
+    if (digest) {
+        /* §44: the reminder must not re-inject everything. */
+        AGENT_TEST_ASSERT(strstr(digest, "# Epistemic rules") == NULL);
+        AGENT_TEST_ASSERT(strstr(digest, "A hypothesis remains a hypothesis") == NULL);
+        AGENT_TEST_ASSERT(strstr(digest,
+            "Do not promote analogy/hypothesis/estimate without new evidence") != NULL);
+        AGENT_TEST_ASSERT(strstr(digest,
+            "User corrections and repair claims require independent verification") != NULL);
+        free(digest);
+    }
+
+    /* The reminder itself is where the digest has to end up. */
+    char *reminder = agent_build_system_prompt_reminder();
+    AGENT_TEST_ASSERT(reminder != NULL);
+    if (reminder) {
+        AGENT_TEST_ASSERT(strstr(reminder, "Do not promote analogy") != NULL);
+        AGENT_TEST_ASSERT(strstr(reminder, "# Epistemic rules") == NULL);
+        free(reminder);
+    }
+}
