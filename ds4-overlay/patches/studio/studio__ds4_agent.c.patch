+static void test_agent_lean_schema_gated_on_policy(void) {
+    char *without = agent_build_tools_prompt(false);
+    char *with = agent_build_tools_prompt(true);
+
+    /* Without the policy the model must not even see the tool. */
+    AGENT_TEST_ASSERT(strstr(without, "lean_check") == NULL);
+    AGENT_TEST_ASSERT(strstr(with, "lean_check") != NULL);
+
+    /* Exactly one schema block, and no escape hatch in it. */
+    const char *first = strstr(with, "\"name\": \"lean_check\"");
+    AGENT_TEST_ASSERT(first != NULL);
+    AGENT_TEST_ASSERT(strstr(first + 1, "\"name\": \"lean_check\"") == NULL);
+    AGENT_TEST_ASSERT(strstr(with, "\"expected_declarations\"") != NULL);
+
+    /* Gating must not disturb the rest of the catalog. */
+    AGENT_TEST_ASSERT(strstr(without, "\"name\": \"sage\"") != NULL);
+    AGENT_TEST_ASSERT(strstr(without, "\"name\": \"bash\"") != NULL);
+    AGENT_TEST_ASSERT(strlen(with) > strlen(without));
+
+    free(without);
+    free(with);
+}
