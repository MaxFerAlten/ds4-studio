+/* QF-23 section 45 — in block mode the candidate answer is not visible before
+ * the gate has ruled: the publish path must receive zero bytes until it does. */
+static void test_agent_epistemic_deferred_output_withholding(void) {
+    agent_worker w;
+    memset(&w, 0, sizeof(w));
+    ds4_agent_epistemic_turn_reset(&w.epistemic_turn);
+
+    /* Only block owes a verdict; off and shadow stream as they do today. */
+    AGENT_TEST_ASSERT(ds4_agent_epistemic_should_defer(&w.epistemic_turn,
+                                                       DS4_EPI_MODE_BLOCK));
+    AGENT_TEST_ASSERT(!ds4_agent_epistemic_should_defer(&w.epistemic_turn,
+                                                        DS4_EPI_MODE_SHADOW));
+    AGENT_TEST_ASSERT(!ds4_agent_epistemic_should_defer(&w.epistemic_turn,
+                                                        DS4_EPI_MODE_OFF));
+
+    const char *candidate = "The implementation is complete and working.";
+    const size_t candidate_len = strlen(candidate);
+
+    agent_deferred_output deferred = {0};
+    agent_token_renderer renderer = { .worker = &w, .deferred = &deferred };
+    renderer_write(&renderer, candidate, candidate_len);
+
+    /* Before any verdict: the buffer holds it, the client has none of it. */
+    AGENT_TEST_ASSERT(w.out_len == 0);
+    AGENT_TEST_ASSERT(deferred.len == candidate_len);
+
+    /* A refused verdict publishes nothing and leaves nothing behind. */
+    agent_deferred_output_publish(&w, &deferred, false);
+    AGENT_TEST_ASSERT(w.out_len == 0);
+    AGENT_TEST_ASSERT(deferred.ptr == NULL);
+    AGENT_TEST_ASSERT(deferred.len == 0);
+
+    /* An allowed verdict publishes exactly what was withheld, and once. */
+    agent_deferred_output allowed = {0};
+    agent_token_renderer allowed_renderer = { .worker = &w, .deferred = &allowed };
+    renderer_write(&allowed_renderer, candidate, candidate_len);
+    AGENT_TEST_ASSERT(w.out_len == 0);
+    agent_deferred_output_publish(&w, &allowed, true);
+    AGENT_TEST_ASSERT(w.out_len == candidate_len);
+    AGENT_TEST_ASSERT(allowed.ptr == NULL);
+    agent_deferred_output_publish(&w, &allowed, true);
+    AGENT_TEST_ASSERT(w.out_len == candidate_len);
+
+    free(w.out);
+}
