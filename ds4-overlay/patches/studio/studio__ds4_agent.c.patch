+static void agent_sage_turn_adopt(agent_sage_turn_state *s,
+                                  const char *state_name,
+                                  bool terminal,
+                                  bool retryable,
+                                  bool publishable,
+                                  bool authoritative,
+                                  bool validation_passed,
+                                  bool report_ready,
+                                  bool final_markdown_ready,
+                                  bool strategy_change_required,
+                                  int candidate_revision,
+                                  const char *next_phase,
+                                  const char *failure_class,
+                                  const char *fingerprint,
+                                  const char *next_action) {
+    if (!s) return;
+    s->state = agent_sage_state_from_name(state_name);
+    s->terminal = terminal || agent_sage_turn_is_terminal(s);
+    s->retryable = retryable && !s->terminal;
+    s->publishable = publishable;
+    s->authoritative = authoritative;
+    s->validation_passed = validation_passed;
+    s->report_ready = report_ready;
+    s->final_markdown_ready = final_markdown_ready;
+    s->strategy_change_required = strategy_change_required;
+    if (candidate_revision > 0) s->candidate_revision = candidate_revision;
+    snprintf(s->next_phase, sizeof(s->next_phase), "%s",
+             next_phase && next_phase[0] ? next_phase : "terminal");
+    snprintf(s->failure_class, sizeof(s->failure_class), "%s",
