+/* Which policy bundle this session actually holds.
+ *
+ * Read off the prompt rather than off DS4_LEAN_AUTONOMOUS_PROMPT: the env var
+ * says what the next /lean start would load, the marker says what this session
+ * was primed with, and after a /switch those two are routinely different. */
+static const char *agent_lean_policy_mode(const agent_worker *w) {
+    return (w && w->lean_prompt &&
+            strstr(w->lean_prompt, "[BEGIN DS4 LEAN AUTONOMOUS ORCHESTRATION]"))
+               ? "autonomous"
+               : "base";
+}
+
+/* Build the lean_check_request_v1 JSON body. timeout_sec must already have
+ * passed agent_parse_lean_timeout, so it is always within the server contract
+ * and is emitted unconditionally. The source code is escaped with
+ * agent_json_escape (UTF-8 byte identity) rather than a \u00xx encoder, which
+ * would mangle non-ASCII Lean sources. Returns malloc'd body or NULL. */
+static char *agent_lean_build_request(const char *code,
+                                      const char *profile,
+                                      const char *session,
+                                      const char *run_id,
+                                      const char *proof_id,
+                                      int attempt,
+                                      const char *prompt_revision,
+                                      const char *contract_revision,
+                                      const char *policy_mode,
+                                      int timeout_sec,
+                                      const char *declarations,
+                                      const char *task_mode,
+                                      const char *target_declaration,
+                                      const char *expected_target_statement_sha256,
+                                      const char *target_statement) {
+    char *encoded_code = agent_json_escape(code, strlen(code));
+    if (!encoded_code) return NULL;
+
+    agent_buf req = {0};
+    agent_buf_puts(&req, "{\"contractVersion\":\"lean_check_request_v1\"");
+    agent_buf_puts(&req, ",\"mode\":\"check\",\"proofPolicy\":\"typecheck\"");
+    agent_buf_puts(&req, ",\"code\":");
+    agent_buf_puts(&req, encoded_code);
+    free(encoded_code);
+
+    char scalar[256];
+    snprintf(scalar, sizeof(scalar), ",\"profile\":\"%s\"",
+             profile && profile[0] ? profile : "core");
+    agent_buf_puts(&req, scalar);
+    snprintf(scalar, sizeof(scalar), ",\"sessionId\":\"%.128s\"",
+             session ? session : "default");
+    agent_buf_puts(&req, scalar);
+    snprintf(scalar, sizeof(scalar), ",\"runId\":\"%.95s\"", run_id ? run_id : "");
+    agent_buf_puts(&req, scalar);
+    /* proofId groups every attempt of this theorem; runId identifies just one. */
+    if (proof_id && proof_id[0]) {
+        snprintf(scalar, sizeof(scalar), ",\"proofId\":\"%.95s\"", proof_id);
+        agent_buf_puts(&req, scalar);
+    }
+    snprintf(scalar, sizeof(scalar), ",\"attempt\":%d", attempt);
+    agent_buf_puts(&req, scalar);
+    /* Two revisions, two questions. promptRevision says which instructions this
+     * session holds — the server reports a drift and runs anyway. contractRevision
+     * says which lean_check semantics this client implements — a mismatch there is
+     * refused before Lean is spawned. policyRevision is the pre-split name of the
+     * first one, still sent so a server from before the split keeps working. */
+    snprintf(scalar, sizeof(scalar), ",\"promptRevision\":\"%.40s\"",
+             prompt_revision ? prompt_revision : "");
+    agent_buf_puts(&req, scalar);
+    snprintf(scalar, sizeof(scalar), ",\"policyRevision\":\"%.40s\"",
+             prompt_revision ? prompt_revision : "");
+    agent_buf_puts(&req, scalar);
+    snprintf(scalar, sizeof(scalar), ",\"contractRevision\":\"%.64s\"",
+             contract_revision ? contract_revision : "");
+    agent_buf_puts(&req, scalar);
+    snprintf(scalar, sizeof(scalar), ",\"policyMode\":\"%.16s\"",
+             policy_mode && policy_mode[0] ? policy_mode : "base");
+    agent_buf_puts(&req, scalar);
+    snprintf(scalar, sizeof(scalar), ",\"timeoutSec\":%d", timeout_sec);
+    agent_buf_puts(&req, scalar);
+    if (agent_lean_declarations_safe(declarations)) {
+        agent_buf_puts(&req, ",\"expectedDeclarations\":");
+        agent_buf_puts(&req, declarations);
+    }
+    /* WP-10 task mode. targetDeclaration is a validated bare name; the
+     * expected statement digest is runtime state, never a model argument. */
+    if (task_mode && task_mode[0]) {
+        snprintf(scalar, sizeof(scalar), ",\"taskMode\":\"%.16s\"", task_mode);
+        agent_buf_puts(&req, scalar);
+    }
+    if (target_declaration && target_declaration[0]) {
+        char *encoded_target = agent_json_escape(target_declaration,
+                                                 strlen(target_declaration));
+        if (encoded_target) {
+            agent_buf_puts(&req, ",\"targetDeclaration\":");
+            agent_buf_puts(&req, encoded_target);
+            free(encoded_target);
+        }
+    }
+    /* WP-11 §11.2 — the declared statement travels with the request. The C
+     * never parses it: the server derives the sealed digest and enforces it
+     * pre-spawn, so the seal lives where the Lean parser already is. */
+    if (target_statement && target_statement[0]) {
+        char *encoded_statement = agent_json_escape(target_statement,
+                                                    strlen(target_statement));
+        if (encoded_statement) {
+            agent_buf_puts(&req, ",\"targetStatement\":");
+            agent_buf_puts(&req, encoded_statement);
+            free(encoded_statement);
+        }
+    }
+    if (expected_target_statement_sha256 && expected_target_statement_sha256[0] &&
+        agent_lean_hash64_valid(expected_target_statement_sha256)) {
+        snprintf(scalar, sizeof(scalar),
+                 ",\"expectedTargetStatementSha256\":\"%.64s\"",
+                 expected_target_statement_sha256);
+        agent_buf_puts(&req, scalar);
+    }
+    agent_buf_puts(&req, "}");
+    return req.ptr;
+}
+
+/* ============================================================================
+ * Native loopback HTTP transport (no shell, no curl)
+ * ============================================================================
+ * The Lean path used to POST via `popen("curl ...")`: that spawned a shell,
+ * capped every request at a fixed 30s (killing legitimate slow elaborations
+ * before their own timeout), ignored the actual body length, and never
+ * checked the HTTP status code. This transport speaks HTTP/1.1 over a direct
+ * socket to 127.0.0.1 instead: no process is spawned, the body is framed by
+ * Content-Length (verbatim bytes, so shell metacharacters are inert), the
+ * whole exchange shares one poll-based deadline, and the HTTP status code is
+ * returned separately from the body.
+ */
+
+typedef struct {
+    int status;              /* HTTP status code, 0 until an exchange completes */
+    char *body;              /* malloc'd response body (may be ""), caller frees */
+    size_t body_len;
+    bool too_large;          /* body exceeded max_body_bytes: reading was capped */
+    char error[96];          /* transport error code, empty on success */
+} agent_http_response;
+
+typedef struct {
+    char *ptr;
+    size_t len;
+    size_t cap;
+} agent_http_buf;
+
+static bool agent_http_buf_append(agent_http_buf *b, const char *s, size_t n,
+                                  size_t max) {
+    if (b->len + n > max) return false;
+    if (b->len + n + 1 > b->cap) {
+        size_t cap = b->cap ? b->cap * 2 : 2048;
+        while (cap < b->len + n + 1) cap *= 2;
+        if (cap > max + 1) cap = max + 1;
+        char *np = realloc(b->ptr, cap);
+        if (!np) return false;
+        b->ptr = np;
+        b->cap = cap;
+    }
+    memcpy(b->ptr + b->len, s, n);
+    b->len += n;
+    b->ptr[b->len] = '\0';
+    return true;
+}
+
+static int64_t agent_http_deadline_ms(int timeout_ms) {
+    return (int64_t)(now_sec() * 1000.0) + timeout_ms;
+}
+
+static int agent_http_remaining_ms(int64_t deadline) {
+    int64_t rem = deadline - (int64_t)(now_sec() * 1000.0);
+    return rem > 0 ? (int)rem : 0;
+}
+
+/* Non-blocking connect to 127.0.0.1:port within timeout_ms. */
+static int agent_http_connect_loopback(int port, int timeout_ms,
+                                       char *err, size_t err_len) {
+    struct sockaddr_in addr;
+    memset(&addr, 0, sizeof(addr));
+    addr.sin_family = AF_INET;
+    addr.sin_port = htons((uint16_t)port);
+    if (inet_pton(AF_INET, "127.0.0.1", &addr.sin_addr) <= 0) {
+        snprintf(err, err_len, "LEAN_HTTP_BAD_ADDRESS");
+        return -1;
+    }
+    int fd = socket(AF_INET, SOCK_STREAM, 0);
+    if (fd < 0) {
+        snprintf(err, err_len, "LEAN_HTTP_SOCKET_FAILED");
+        return -1;
+    }
+    int flags = fcntl(fd, F_GETFL, 0);
+    if (flags >= 0) fcntl(fd, F_SETFL, flags | O_NONBLOCK);
+    int rc = connect(fd, (struct sockaddr *)&addr, sizeof(addr));
+    if (rc != 0) {
+        if (errno == EINPROGRESS) {
+            struct pollfd pfd = { .fd = fd, .events = POLLOUT };
+            rc = poll(&pfd, 1, timeout_ms);
+            if (rc > 0) {
+                int soerr = 0;
+                socklen_t slen = sizeof(soerr);
+                getsockopt(fd, SOL_SOCKET, SO_ERROR, &soerr, &slen);
+                rc = soerr == 0 ? 0 : -1;
+            } else {
+                rc = -1; /* poll error or timeout */
+            }
+        } else {
+            rc = -1;
+        }
+    }
+    if (rc != 0) {
+        snprintf(err, err_len, "LEAN_HTTP_CONNECT_FAILED");
+        close(fd);
+        return -1;
+    }
+    if (flags >= 0) fcntl(fd, F_SETFL, flags);
+    return fd;
+}
+
+static bool agent_http_write_all(int fd, const char *p, size_t n,
+                                 int64_t deadline) {
+    while (n) {
+        int rem = agent_http_remaining_ms(deadline);
+        if (rem <= 0) {
+            errno = ETIMEDOUT;
+            return false;
+        }
+        struct pollfd pfd = { .fd = fd, .events = POLLOUT };
+        int rc = poll(&pfd, 1, rem);
+        if (rc <= 0) {
+            if (rc == 0) errno = ETIMEDOUT;
+            return false;
+        }
+        ssize_t w = send(fd, p, n, MSG_NOSIGNAL);
+        if (w < 0 && errno == EINTR) continue;
+        if (w <= 0) return false;
+        p += w;
+        n -= (size_t)w;
+    }
+    return true;
+}
+
+/* Read once, bounded by the deadline. Returns 0 on clean EOF, -1 on error
+ * (errno ETIMEDOUT on timeout). */
+static ssize_t agent_http_read_some(int fd, char *buf, size_t len,
+                                    int64_t deadline) {
+    for (;;) {
+        int rem = agent_http_remaining_ms(deadline);
+        if (rem <= 0) {
+            errno = ETIMEDOUT;
+            return -1;
+        }
+        struct pollfd pfd = { .fd = fd, .events = POLLIN };
+        int rc = poll(&pfd, 1, rem);
+        if (rc <= 0) {
+            if (rc == 0) errno = ETIMEDOUT;
+            return -1;
+        }
+        ssize_t n = read(fd, buf, len);
+        if (n < 0 && errno == EINTR) continue;
+        return n;
+    }
+}
+
+/* Perform an HTTP request against http://127.0.0.1:port/route. A body is
+ * written verbatim and framed by Content-Length only when body is non-NULL
+ * (GET requests pass NULL). The whole exchange (connect, write, read) shares
+ * one timeout_ms deadline. max_body_bytes bounds the response; exceeding it
+ * sets resp->too_large and returns true with status set so the caller can
+ * reject at the domain level. Returns true if an HTTP exchange completed
+ * (resp->status valid), false on transport failure (resp->error set;
+ * resp->body is NULL then). */
+static bool agent_http_request_json(int port, const char *route,
+                                    const char *method,
+                                    const char *body, size_t body_len,
+                                    int timeout_ms, size_t max_body_bytes,
+                                    agent_http_response *resp) {
+    memset(resp, 0, sizeof(*resp));
+    char err[128] = {0};
+    int fd = agent_http_connect_loopback(port, timeout_ms, err, sizeof(err));
+    if (fd < 0) {
+        snprintf(resp->error, sizeof(resp->error), "%s", err);
+        return false;
+    }
+    int64_t deadline = agent_http_deadline_ms(timeout_ms);
+
+    agent_buf hdr = {0};
+    char line[128];
+    snprintf(line, sizeof(line), "%s %s HTTP/1.1\r\n", method, route);
+    agent_buf_puts(&hdr, line);
+    snprintf(line, sizeof(line), "Host: 127.0.0.1:%d\r\n", port);
+    agent_buf_puts(&hdr, line);
+    if (body) {
+        agent_buf_puts(&hdr, "Content-Type: application/json\r\n");
+        snprintf(line, sizeof(line), "Content-Length: %zu\r\n", body_len);
+        agent_buf_puts(&hdr, line);
+    }
+    agent_buf_puts(&hdr, "Connection: close\r\n\r\n");
+
+    bool ok = hdr.ptr && !hdr.truncated &&
+              agent_http_write_all(fd, hdr.ptr, hdr.len, deadline) &&
+              (!body || agent_http_write_all(fd, body, body_len, deadline));
+    int write_errno = errno;
+    free(hdr.ptr);
+    if (!ok) {
+        snprintf(resp->error, sizeof(resp->error),
+                 write_errno == ETIMEDOUT ? "LEAN_HTTP_TIMEOUT"
+                                          : "LEAN_HTTP_WRITE_FAILED");
+        close(fd);
+        return false;
+    }
+
+    /* Read the header block: status line + headers, terminated by \r\n\r\n. */
+    agent_http_buf head = {0};
+    char chunk[512];
+    size_t head_len = 0; /* byte offset just past the header terminator */
+    for (;;) {
+        ssize_t n = agent_http_read_some(fd, chunk, sizeof(chunk), deadline);
+        if (n < 0) {
+            snprintf(resp->error, sizeof(resp->error),
+                     errno == ETIMEDOUT ? "LEAN_HTTP_TIMEOUT"
+                                        : "LEAN_HTTP_READ_FAILED");
+            free(head.ptr);
+            close(fd);
+            return false;
+        }
+        if (n == 0) {
+            snprintf(resp->error, sizeof(resp->error), "LEAN_HTTP_PREMATURE_CLOSE");
+            free(head.ptr);
+            close(fd);
+            return false;
+        }
+        if (!agent_http_buf_append(&head, chunk, (size_t)n, 8192)) {
+            snprintf(resp->error, sizeof(resp->error), "LEAN_HTTP_HEADER_TOO_LARGE");
+            free(head.ptr);
+            close(fd);
+            return false;
+        }
+        char *sep = strstr(head.ptr, "\r\n\r\n");
+        if (sep) {
+            /* A read() may deliver headers and body in one packet; the bytes
+             * after the header terminator belong to the body and must not be
+             * dropped when the header string is truncated. */
+            head_len = (size_t)((sep + 4) - head.ptr);
+            *sep = '\0';
+            break;
+        }
+    }
+
+    int code = 0;
+    if (sscanf(head.ptr, "HTTP/1.%*d %d", &code) != 1 || code < 100) {
+        snprintf(resp->error, sizeof(resp->error), "LEAN_HTTP_BAD_STATUS_LINE");
+        free(head.ptr);
+        close(fd);
+        return false;
+    }
+    resp->status = code;
+
+    /* Parse Content-Length, if present. */
+    size_t content_length = SIZE_MAX;
+    for (char *line_p = head.ptr; line_p && *line_p; ) {
+        char *nl = strstr(line_p, "\r\n");
+        size_t llen = nl ? (size_t)(nl - line_p) : strlen(line_p);
+        if (llen >= 15 && !strncasecmp(line_p, "Content-Length:", 15)) {
+            const char *v = line_p + 15;
+            while (*v == ' ' || *v == '\t') v++;
+            char *v_end = NULL;
+            unsigned long cl = strtoul(v, &v_end, 10);
+            if (v_end != v) content_length = (size_t)cl;
+        }
+        if (!nl) break;
+        line_p = nl + 2;
+    }
+
+    /* Body bytes that arrived together with the headers. */
+    size_t body_pre = head.len > head_len ? head.len - head_len : 0;
+    const char *body_pre_ptr = body_pre ? head.ptr + head_len : NULL;
+    size_t body_pre_left = body_pre;
+
+    /* Read the body. */
+    agent_http_buf body_buf = {0};
+    size_t got = 0;
+    for (;;) {
+        ssize_t n;
+        if (body_pre_left) {
+            size_t take = body_pre_left;
+            if (content_length != SIZE_MAX) {
+                size_t want = content_length - got;
+                if (want < take) take = want;
+            }
+            if (take > sizeof(chunk)) take = sizeof(chunk);
+            memcpy(chunk, body_pre_ptr, take);
+            body_pre_ptr += take;
+            body_pre_left -= take;
+            n = (ssize_t)take;
+        } else if (content_length != SIZE_MAX) {
+            size_t want = content_length - got;
+            if (want == 0) break; /* Content-Length satisfied (e.g. CL: 0) */
+            if (want > sizeof(chunk)) want = sizeof(chunk);
+            n = agent_http_read_some(fd, chunk, want, deadline);
+            if (n < 0) {
+                snprintf(resp->error, sizeof(resp->error),
+                         errno == ETIMEDOUT ? "LEAN_HTTP_TIMEOUT"
+                                            : "LEAN_HTTP_READ_FAILED");
+                free(body_buf.ptr);
+                close(fd);
+                return false;
+            }
+            if (n == 0) {
+                /* Server advertised more bytes than it sent. */
+                snprintf(resp->error, sizeof(resp->error),
+                         "LEAN_HTTP_PARTIAL_CONTENT_LENGTH");
+                free(body_buf.ptr);
+                close(fd);
+                return false;
+            }
+        } else {
+            n = agent_http_read_some(fd, chunk, sizeof(chunk), deadline);
+            if (n < 0) {
+                snprintf(resp->error, sizeof(resp->error),
+                         errno == ETIMEDOUT ? "LEAN_HTTP_TIMEOUT"
+                                            : "LEAN_HTTP_READ_FAILED");
+                free(body_buf.ptr);
+                close(fd);
+                return false;
+            }
+            if (n == 0) break; /* clean EOF */
+        }
+        if (!agent_http_buf_append(&body_buf, chunk, (size_t)n, max_body_bytes)) {
+            resp->too_large = true;
+            break;
+        }
+        got += (size_t)n;
+        if (content_length != SIZE_MAX && got >= content_length) break;
+    }
+
+    free(head.ptr);
+    close(fd);
+    resp->body = body_buf.ptr ? body_buf.ptr : xstrdup("");
+    resp->body_len = body_buf.len;
+    return true;
+}
+
+/* POST a JSON body to http://127.0.0.1:port/route. */
+static bool agent_http_post_json(int port, const char *route,
+                                 const char *json, size_t json_len,
+                                 int timeout_ms, size_t max_body_bytes,
+                                 agent_http_response *resp) {
+    return agent_http_request_json(port, route, "POST",
+                                   json, json_len,
+                                   timeout_ms, max_body_bytes, resp);
+}
+
+/* GET http://127.0.0.1:port/route and return a heap copy of the response body,
+ * or NULL on transport failure or when the body exceeds max_bytes. The status
+ * is not policed here: callers validate the payload contract themselves. */
+static char *agent_http_get_local(int port, const char *route,
+                                  size_t max_bytes) {
+    if (port <= 0 || !route) return NULL;
+    agent_http_response resp = {0};
+    if (!agent_http_request_json(port, route, "GET", NULL, 0,
+                                 10000, max_bytes, &resp))
+        return NULL;
+    if (resp.too_large) {
+        free(resp.body);
+        return NULL;
+    }
+    return resp.body;
+}
