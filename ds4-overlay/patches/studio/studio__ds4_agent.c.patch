+/* The full tool path: the mock echoes a contract-valid lean_result_v1 carrying
+ * the runId the worker sent, and the tool must accept it. This also proves the
+ * tool no longer shells out to curl. */
+static void test_agent_lean_tool_via_native_transport(void) {
+    agent_http_mock m = {0};
+    m.mode = AGENT_HTTP_MOCK_OK;
+    m.echo_run_id = true;
+    AGENT_TEST_ASSERT(agent_http_mock_start(&m));
+
+    agent_worker w;
+    memset(&w, 0, sizeof(w));
+    agent_config cfg = {0};
+    cfg.frontend_port = m.port;
+    w.cfg = &cfg;
+    /* The guard is now coherence-based: the recorded revision must be the
+     * SHA-1 of the policy this session holds, not any 40-hex string. */
+    w.lean_prompt = (char *)"dummy policy";
+    agent_lean_turn_reset(&w.lean_turn);
+    ds4_kvstore_sha1_bytes_hex(w.lean_prompt, strlen(w.lean_prompt),
+                               w.lean_policy_revision);
+    agent_worker_init_lean_contract(&w);
+    AGENT_TEST_ASSERT(agent_worker_lean_policy_coherent(&w));
+    AGENT_TEST_ASSERT(agent_worker_lean_contract_coherent(&w));
+
+    agent_tool_arg args[4] = {
+        {.name = (char *)"code", .value = (char *)"theorem t : True := by trivial",
+         .is_string = true},
+        /* Every proof call names the declaration it is proving (WP-10) and
+         * states it (§11.2), so the target cannot be read off the candidate. */
+        {.name = (char *)"task_mode", .value = (char *)"proof", .is_string = true},
+        {.name = (char *)"target_declaration", .value = (char *)"t",
+         .is_string = true},
+        {.name = (char *)"target_statement", .value = (char *)"theorem t : True",
+         .is_string = true},
+    };
+    agent_tool_call call = {.name = (char *)"lean_check", .args = args, .argc = 4};
+
+    char *out = agent_tool_lean_via_http(&w, &call);
+    AGENT_TEST_ASSERT(out != NULL);
+    AGENT_TEST_ASSERT(out && strstr(out, "lean_check status=checked"));
+    AGENT_TEST_ASSERT(out && strstr(out, "transport ok"));
+    /* The normative block leads the tool result, so a small model does not have
+     * to infer the next step from the diagnostics. */
+    AGENT_TEST_ASSERT(out && strstr(out, "LEAN_ORCHESTRATION"));
+    AGENT_TEST_ASSERT(out && strstr(out, "state=verified"));
+    AGENT_TEST_ASSERT(out && strstr(out, "FINALIZATION_ALLOWED=true"));
+    AGENT_TEST_ASSERT(out && strstr(out, "VERIFIED_SOURCE_SHA256="));
+    free(out);
+    AGENT_TEST_ASSERT(w.lean_turn.state == AGENT_LEAN_VERIFIED);
+    AGENT_TEST_ASSERT(agent_lean_turn_can_finalize(&w.lean_turn));
+    /* L-C-14: the hash kept is the digest of the exact bytes that elaborated. */
+    char expected_sha[65];
+    ds4_sha256_hex(args[0].value, strlen(args[0].value), expected_sha);
+    AGENT_TEST_ASSERT(!strcmp(w.lean_turn.checked_source_sha256, expected_sha));
+
+    /* The request the server saw is the JSON contract, not a curl invocation. */
+    AGENT_TEST_ASSERT(m.req && strstr(m.req, "contractVersion"));
+    AGENT_TEST_ASSERT(m.req && strstr(m.req, "lean_check_request_v1"));
+    AGENT_TEST_ASSERT(m.req && strstr(m.req, "\"proofId\":\"proof-"));
+    AGENT_TEST_ASSERT(m.req && !strstr(m.req, "curl"));
+    AGENT_TEST_ASSERT(m.req && !strstr(m.req, "--max-time"));
+
+    agent_http_mock_stop(&m);
+}
