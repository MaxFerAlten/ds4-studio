+/* QF-25 section 47 — a blocked candidate remains private across every repair
+ * round, the retry budget belongs to the epistemic turn, and exhaustion emits
+ * only a runtime-authored status rather than any byte of the candidate. */
+static void test_agent_epistemic_repair_loop_is_bounded_and_withheld(void) {
+    agent_worker w;
+    agent_config cfg;
+    memset(&w, 0, sizeof(w));
+    memset(&cfg, 0, sizeof(cfg));
+    cfg.non_interactive = true;
+    w.cfg = &cfg;
+    ds4_agent_epistemic_turn_reset(&w.epistemic_turn);
+
+    const char *candidate = "The patch is tested and passes tests.";
+    const size_t candidate_len = strlen(candidate);
+
+    for (int round = 0; round < DS4_EPI_DEFAULT_MAX_REPAIR_ROUNDS; round++) {
+        ds4_epistemic_scan_result scan =
+            ds4_agent_epistemic_scan_final_text(&w.epistemic_turn,
+                                                 candidate, candidate_len);
+        AGENT_TEST_ASSERT(scan.blocked);
+        AGENT_TEST_ASSERT(ds4_agent_epistemic_can_repair(&w.epistemic_turn));
+
+        agent_deferred_output deferred = {0};
+        agent_token_renderer renderer = { .worker = &w, .deferred = &deferred };
+        renderer_write(&renderer, candidate, candidate_len);
+        agent_deferred_output_publish(
+            &w, &deferred,
+            ds4_agent_epistemic_can_publish(&scan, DS4_EPI_MODE_BLOCK));
+        AGENT_TEST_ASSERT(w.out_len == 0);
+
+        char *guidance = ds4_agent_epistemic_repair_guidance(&scan);
+        AGENT_TEST_ASSERT(guidance != NULL);
+        free(guidance);
+        ds4_agent_epistemic_begin_repair(&w.epistemic_turn);
+        AGENT_TEST_ASSERT(w.epistemic_turn.repair_rounds == round + 1);
+    }
+
+    AGENT_TEST_ASSERT(!ds4_agent_epistemic_can_repair(&w.epistemic_turn));
+
+    ds4_epistemic_scan_result terminal_scan =
+        ds4_agent_epistemic_scan_final_text(&w.epistemic_turn,
+                                             candidate, candidate_len);
+    agent_deferred_output terminal = {0};
+    agent_token_renderer terminal_renderer = { .worker = &w, .deferred = &terminal };
+    renderer_write(&terminal_renderer, candidate, candidate_len);
+    agent_deferred_output_publish(
+        &w, &terminal,
+        ds4_agent_epistemic_can_publish(&terminal_scan, DS4_EPI_MODE_BLOCK));
+    AGENT_TEST_ASSERT(w.out_len == 0);
+
+    agent_publish_system_status(&w, agent_epistemic_finalization_blocked_status);
+    AGENT_TEST_ASSERT(w.out != NULL);
+    if (w.out != NULL) {
+        AGENT_TEST_ASSERT(strstr(w.out, "EPISTEMIC_FINALIZATION_BLOCKED") != NULL);
+        AGENT_TEST_ASSERT(strstr(w.out, candidate) == NULL);
+    }
+
+    free(w.out);
+}
