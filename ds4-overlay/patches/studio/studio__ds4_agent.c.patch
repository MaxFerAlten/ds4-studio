+static void test_agent_skill_manifest_roundtrip_and_rejects_malformed(void) {
+    ds4_agent_skill_manifest manifest;
+    ds4_agent_skill_manifest_init(&manifest);
+    char err[256] = {0};
+    char revision_a[DS4_AGENT_SKILL_REVISION_HEX + 1];
+    char revision_b[DS4_AGENT_SKILL_REVISION_HEX + 1];
+    memset(revision_a, 'a', DS4_AGENT_SKILL_REVISION_HEX);
+    memset(revision_b, 'b', DS4_AGENT_SKILL_REVISION_HEX);
+    revision_a[DS4_AGENT_SKILL_REVISION_HEX] = '\0';
+    revision_b[DS4_AGENT_SKILL_REVISION_HEX] = '\0';
+
+    AGENT_TEST_ASSERT(ds4_agent_skill_manifest_add(
+        &manifest, "lean", DS4_AGENT_SKILL_DYNAMIC,
+        revision_b, 17, err, sizeof(err)));
+    AGENT_TEST_ASSERT(ds4_agent_skill_manifest_add(
+        &manifest, "ethic", DS4_AGENT_SKILL_BUILTIN_ETHIC,
+        revision_a, 11, err, sizeof(err)));
+    AGENT_TEST_ASSERT(manifest.len == 2);
+    AGENT_TEST_ASSERT(!strcmp(manifest.items[0].name, "ethic"));
+    AGENT_TEST_ASSERT(!strcmp(manifest.items[1].name, "lean"));
+    AGENT_TEST_ASSERT(strlen(manifest.aggregate_revision) ==
+                      DS4_AGENT_SKILL_REVISION_HEX);
+
+    char root_template[] = "/tmp/ds4_skill_manifestXXXXXX";
+    char *root = mkdtemp(root_template);
+    AGENT_TEST_ASSERT(root != NULL);
+    if (!root) return;
+    static const char sha[] =
+        "0123456789abcdef0123456789abcdef01234567";
+    char final_path[PATH_MAX];
+    snprintf(final_path, sizeof(final_path), "%s/%s.skills", root, sha);
+
+    char *temp_path = NULL;
+    AGENT_TEST_ASSERT(ds4_agent_skill_manifest_stage_write(
+        root, sha, &manifest, &temp_path, err, sizeof(err)));
+    AGENT_TEST_ASSERT(temp_path != NULL);
+    AGENT_TEST_ASSERT(access(temp_path, F_OK) == 0);
+    AGENT_TEST_ASSERT(access(final_path, F_OK) != 0);
+    AGENT_TEST_ASSERT(ds4_agent_skill_manifest_commit(
+        root, sha, &temp_path, err, sizeof(err)));
+    AGENT_TEST_ASSERT(temp_path == NULL);
+
+    ds4_agent_skill_manifest loaded;
+    bool found = false;
+    AGENT_TEST_ASSERT(ds4_agent_skill_manifest_read(
+        root, sha, &loaded, &found, err, sizeof(err)));
+    AGENT_TEST_ASSERT(found);
+    AGENT_TEST_ASSERT(loaded.len == manifest.len);
+    AGENT_TEST_ASSERT(!strcmp(loaded.aggregate_revision,
+                              manifest.aggregate_revision));
+    AGENT_TEST_ASSERT(!strcmp(loaded.items[0].name, "ethic"));
+    AGENT_TEST_ASSERT(loaded.items[1].content_len == 17);
+
+    FILE *fp = fopen(final_path, "wb");
+    AGENT_TEST_ASSERT(fp != NULL);
+    if (fp) {
+        static const char malformed[] =
+            "DS4_AGENT_SKILLS_V1\n"
+            "aggregate_revision 0123456789abcdef0123456789abcdef01234567\n"
+            "count +1\n";
+        AGENT_TEST_ASSERT(fwrite(malformed, 1, sizeof(malformed) - 1, fp) ==
+                          sizeof(malformed) - 1);
+        AGENT_TEST_ASSERT(fclose(fp) == 0);
+    }
+    AGENT_TEST_ASSERT(!ds4_agent_skill_manifest_read(
+        root, sha, &loaded, &found, err, sizeof(err)));
+    AGENT_TEST_ASSERT(strstr(err, "SKILL_MANIFEST_IO_FAILED") != NULL);
+
+    bool removed = false;
+    AGENT_TEST_ASSERT(ds4_agent_skill_manifest_remove(
+        root, sha, &removed, err, sizeof(err)));
+    AGENT_TEST_ASSERT(removed);
+    AGENT_TEST_ASSERT(ds4_agent_skill_manifest_remove(
+        root, sha, &removed, err, sizeof(err)));
+    AGENT_TEST_ASSERT(!removed);
+    AGENT_TEST_ASSERT(rmdir(root) == 0);
+}
