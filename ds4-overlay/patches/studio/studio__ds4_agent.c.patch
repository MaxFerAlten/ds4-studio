+static void test_agent_skill_manifest_staging_is_fail_closed(void) {
+    char root_template[] = "/tmp/ds4_skill_stageXXXXXX";
+    char *root = mkdtemp(root_template);
+    AGENT_TEST_ASSERT(root != NULL);
+    if (!root) return;
+    char dir[PATH_MAX];
+    char path[PATH_MAX];
+    /* "custom" must not collide with a builtin skill: builtins are staged as
+     * builtin regardless of what the manifest claims, so asserting a DYNAMIC
+     * entry requires a name that is not already compiled in. */
+    snprintf(dir, sizeof(dir), "%s/custom", root);
+    snprintf(path, sizeof(path), "%s/SKILL.md", dir);
+    AGENT_TEST_ASSERT(mkdir(dir, 0700) == 0);
+    FILE *fp = fopen(path, "wb");
+    AGENT_TEST_ASSERT(fp != NULL);
+    if (fp) {
+        static const char original[] = "original skill\n";
+        AGENT_TEST_ASSERT(fwrite(original, 1, sizeof(original) - 1, fp) ==
+                          sizeof(original) - 1);
+        AGENT_TEST_ASSERT(fclose(fp) == 0);
+    }
+
+    setenv("DS4_SKILLS_DIR", root, 1);
+    char err[256] = {0};
+    ds4_agent_skill_entry disk = {0};
+    AGENT_TEST_ASSERT(ds4_agent_skill_stage_from_disk(
+        root, "custom", DS4_AGENT_SKILL_DYNAMIC,
+        &disk, err, sizeof(err)));
+    ds4_agent_skill_manifest manifest;
+    ds4_agent_skill_manifest_init(&manifest);
+    AGENT_TEST_ASSERT(ds4_agent_skill_manifest_add(
+        &manifest, disk.name, disk.kind, disk.revision,
+        disk.content_len, err, sizeof(err)));
+    ds4_agent_skill_entry_free(&disk);
+
+    agent_worker_skill_state staged;
+    AGENT_TEST_ASSERT(agent_worker_stage_manifest_skills(
+        &manifest, &staged, err, sizeof(err)));
+    AGENT_TEST_ASSERT(staged.dynamic_skills.len == 1);
+    agent_worker_skill_state_free(&staged);
+
+    fp = fopen(path, "wb");
+    AGENT_TEST_ASSERT(fp != NULL);
+    if (fp) {
+        static const char changed[] = "changed skill\n";
+        AGENT_TEST_ASSERT(fwrite(changed, 1, sizeof(changed) - 1, fp) ==
+                          sizeof(changed) - 1);
+        AGENT_TEST_ASSERT(fclose(fp) == 0);
+    }
+    AGENT_TEST_ASSERT(!agent_worker_stage_manifest_skills(
+        &manifest, &staged, err, sizeof(err)));
+    AGENT_TEST_ASSERT(strstr(
+        err, "SKILL_SESSION_REVISION_MISMATCH") != NULL);
+
+    setenv("DS4_SKILL_AUTO", "0", 1);
+    setenv("DS4_SAGE_POLICY_AUTO", "0", 1);
+    AGENT_TEST_ASSERT(agent_worker_stage_legacy_skills(
+        &staged, err, sizeof(err)));
+    AGENT_TEST_ASSERT(staged.dynamic_skills.len == 0);
+    AGENT_TEST_ASSERT(staged.metacognition_prompt == NULL);
+    AGENT_TEST_ASSERT(!staged.soul_active);
+    agent_worker_skill_state_free(&staged);
+    unsetenv("DS4_SKILL_AUTO");
+    unsetenv("DS4_SAGE_POLICY_AUTO");
+    unsetenv("DS4_SKILLS_DIR");
+    AGENT_TEST_ASSERT(unlink(path) == 0);
+    AGENT_TEST_ASSERT(rmdir(dir) == 0);
+    AGENT_TEST_ASSERT(rmdir(root) == 0);
+}
