+                                        err) ==
+            DS4_AGENT_PROTOCOL_TERMINAL)
+            break;
+    }
+    AGENT_TEST_ASSERT(rounds == DS4_AGENT_PROTOCOL_SAME_FAILURE_TERMINAL);
+    printf("DSML_PROTOCOL_LOOP_GUARD=PASS rounds=%d\n", rounds);
