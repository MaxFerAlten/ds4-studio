+/* Parser for the lean_check timeout_sec argument. Unlike the shared
+ * agent_parse_timeout above, the value is bounded by the Lean server contract
+ * (1..AGENT_LEAN_MAX_TIMEOUT_SEC) and an invalid or absent value never
+ * produces an out-of-contract timeout. On success *out is always within the
+ * accepted range, so the request always carries a timeoutSec the server will
+ * accept. On failure the call is refused before any HTTP request is made. */
+static bool agent_parse_lean_timeout(const char *raw, int *out,
+                                     char *err, size_t err_len) {
+    if (err && err_len) err[0] = '\0';
+    if (!raw || !raw[0]) {
+        *out = AGENT_LEAN_DEFAULT_TIMEOUT_SEC;
+        return true;
+    }
+    char *end = NULL;
+    long v = strtol(raw, &end, 10);
