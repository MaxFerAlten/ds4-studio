+/* ============================================================================
+ * UTF8-001 — the presentation path must never split a UTF-8 code point
+ * ============================================================================
+ *
+ * The Cauchy regression showed correct bytes reaching Lean while the rendered
+ * transcript displayed U+FFFD.  agent_publish() forwards every chunk the
+ * renderer writes to the wrapper callback, and the wrapper turns one chunk
+ * into one JSON/SSE event.  A chunk carrying one third of "R-double-struck"
+ * therefore becomes an event no strict decoder can read back.  These tests pin
+ * the invariant at the boundary that actually breaks: each published chunk
+ * must stand alone as valid UTF-8, and the concatenation must be byte-identical
+ * to the input.  Asserting only on the concatenation would pass today and miss
+ * the bug entirely.
+ */
+
+/* APPENDICE D regression sentinel: 2-, 3- and 4-byte sequences plus the Lean
+ * notation and the Italian accents seen corrupted in the transcript. */
+#define AGENT_UTF8_SENTINEL \
+    "\u211d \u2192 \u2190 \u2194 \u2200 \u2203 \u2208 \u2209 \u2286 " \
+    "\u2227 \u2228 \u00ac \u03bb \u03b1 \u03b2 \u03b3 \u2264 \u2265 " \
+    "\u2260 \u00d7 \u2218 \u27e8 \u27e9 \u00e0 \u00e8 \u00ec \u00f2 " \
+    "\u00f9 \u00e9 \u00b2 \u00b3 \u2713 \U0001f6a9\n" \
+    "variable (f g : \u211d \u2192 \u211d) {a b : \u211d}\n"
+
+typedef struct {
+    char joined[8192];
+    size_t joined_len;
+    size_t chunks;
+    size_t invalid_chunks;
+    bool overflow;
+} agent_utf8_publish_probe;
+
+static void agent_utf8_publish_probe_cb(void *ud, const char *s, size_t n) {
+    agent_utf8_publish_probe *p = ud;
+    p->chunks++;
+    if (!ds4_utf8_validate(s, n)) p->invalid_chunks++;
+    if (p->joined_len + n + 1 > sizeof(p->joined)) { p->overflow = true; return; }
+    memcpy(p->joined + p->joined_len, s, n);
+    p->joined_len += n;
+    p->joined[p->joined_len] = '\0';
+}
+
+/* Drive renderer_plain() with a fixed chunk size and collect what the worker
+ * would have published.  chunk==1 is the shape the tool visualizer produces:
+ * agent_tool_viz_param_raw_byte() hands the renderer one byte per DSML byte. */
+static void agent_utf8_probe_render(agent_utf8_publish_probe *p,
+                                    const char *input, size_t len,
+                                    size_t chunk) {
+    agent_worker w;
+    memset(&w, 0, sizeof(w));
+    pthread_mutex_init(&w.mu, NULL);
+    w.wake_fd[0] = -1;
+    w.wake_fd[1] = -1;
+    w.publish_cb = agent_utf8_publish_probe_cb;
+    w.publish_ud = p;
+
+    agent_token_renderer r;
+    memset(&r, 0, sizeof(r));
+    r.worker = &w;
+
+    memset(p, 0, sizeof(*p));
+    for (size_t i = 0; i < len; i += chunk) {
+        size_t n = len - i < chunk ? len - i : chunk;
+        renderer_plain(&r, input + i, n);
+    }
+    renderer_flush_utf8(&r);
+
+    free(w.out);
+    pthread_mutex_destroy(&w.mu);
+}
+
+static void test_ds4_utf8_validate_contract(void) {
+    /* §27 — the need table the accumulator relies on. */
+    AGENT_TEST_ASSERT(renderer_utf8_need(0x41) == 1);
+    AGENT_TEST_ASSERT(renderer_utf8_need(0xC3) == 2);
+    AGENT_TEST_ASSERT(renderer_utf8_need(0xE2) == 3);
+    AGENT_TEST_ASSERT(renderer_utf8_need(0xF0) == 4);
+
+    const char *sentinel = AGENT_UTF8_SENTINEL;
+    AGENT_TEST_ASSERT(ds4_utf8_validate(sentinel, strlen(sentinel)));
+    AGENT_TEST_ASSERT(ds4_utf8_validate("", 0));
+    AGENT_TEST_ASSERT(ds4_utf8_validate("plain ascii", 11));
+
+    /* §82 — the classic invalid fixtures.  A continuation-byte count alone
+     * would wave three of these through. */
+    const unsigned char lone_continuation[] = {0x80};
+    const unsigned char overlong_two[]      = {0xC0, 0xAF};
+    const unsigned char truncated_three[]   = {0xE2, 0x82};
+    const unsigned char surrogate[]         = {0xED, 0xA0, 0x80};
+    const unsigned char above_max[]         = {0xF4, 0x90, 0x80, 0x80};
+    AGENT_TEST_ASSERT(!ds4_utf8_validate((const char *)lone_continuation, 1));
+    AGENT_TEST_ASSERT(!ds4_utf8_validate((const char *)overlong_two, 2));
+    AGENT_TEST_ASSERT(!ds4_utf8_validate((const char *)truncated_three, 2));
+    AGENT_TEST_ASSERT(!ds4_utf8_validate((const char *)surrogate, 3));
+    AGENT_TEST_ASSERT(!ds4_utf8_validate((const char *)above_max, 4));
+
+    /* A half-delivered code point is exactly what a per-byte publish emits. */
+    const unsigned char half_r[] = {0xE2, 0x84};
+    AGENT_TEST_ASSERT(!ds4_utf8_validate((const char *)half_r, 2));
+}
