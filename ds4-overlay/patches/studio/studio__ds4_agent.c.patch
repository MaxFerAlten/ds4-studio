+
+/* The turn is over exactly when one of these four states is reached.  Nothing
+ * else — not "the last error was small", not "three calls have been made" — may
+ * end a Lean turn. */
+static bool agent_lean_turn_is_terminal(const agent_lean_turn_state *s) {
+    if (!s) return true;
+    return s->state == AGENT_LEAN_VERIFIED ||
+           s->state == AGENT_LEAN_INFRASTRUCTURE_BLOCK ||
+           s->state == AGENT_LEAN_CONTRACT_BLOCK ||
+           s->state == AGENT_LEAN_BUDGET_EXHAUSTED ||
+           s->state == AGENT_LEAN_CANCELLED;
+}
+
+/* A final answer may be published only from a terminal state.  An unused turn
+ * imposes nothing: ordinary chat must not pay for the Lean contract. */
+static bool agent_lean_turn_can_finalize(const agent_lean_turn_state *s) {
+    if (!s || !s->used) return true;
+    return agent_lean_turn_is_terminal(s);
+}
+
+/* True while the model still owes another lean_check in this same turn. */
+static bool agent_lean_turn_must_continue(const agent_lean_turn_state *s) {
+    if (!s || !s->used) return false;
+    return s->state == AGENT_LEAN_CHECKING ||
+           s->state == AGENT_LEAN_REPAIR_REQUIRED ||
+           s->state == AGENT_LEAN_STRATEGY_CHANGE_REQUIRED;
+}
