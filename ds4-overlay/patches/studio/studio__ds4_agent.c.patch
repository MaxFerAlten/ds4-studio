+#ifdef DS4_AGENT_TEST
+/* refactoring.003 §7.9 — the authoritative terminal latch.
+ *
+ * AUTH-C-01/02/03/04: a retryable Lean state still allows tools; a terminal one
+ * allows none of them, whichever tool the model reaches for. */
+static void test_agent_authoritative_mode_derivation(void) {
+    agent_worker w;
+    memset(&w, 0, sizeof(w));
+    agent_lean_turn_reset(&w.lean_turn);
+    agent_sage_turn_reset(&w.sage_turn);
+
+    /* Ordinary chat pays nothing for the Lean contract. */
+    agent_refresh_authoritative_mode(&w);
+    AGENT_TEST_ASSERT(w.authoritative_mode == AGENT_AUTHORITATIVE_NONE);
+    AGENT_TEST_ASSERT(!agent_authoritative_tool_call_forbidden(&w));
+
+    if (agent_lean_autonomous_orchestration_enabled()) {
+        w.lean_turn.used = true;
+        w.lean_turn.state = AGENT_LEAN_REPAIR_REQUIRED;
+        agent_refresh_authoritative_mode(&w);
+        AGENT_TEST_ASSERT(w.authoritative_mode ==
+                          AGENT_AUTHORITATIVE_LEAN_ACTIVE);
+        AGENT_TEST_ASSERT(!agent_authoritative_tool_call_forbidden(&w));
+
+        w.lean_turn.state = AGENT_LEAN_BUDGET_EXHAUSTED;
+        agent_refresh_authoritative_mode(&w);
+        AGENT_TEST_ASSERT(w.authoritative_mode ==
+                          AGENT_AUTHORITATIVE_LEAN_FINALIZATION_ONLY);
+        AGENT_TEST_ASSERT(agent_authoritative_tool_call_forbidden(&w));
+
+        /* AUTH-C-05: verified is finalization-only too. */
+        w.lean_turn.state = AGENT_LEAN_VERIFIED;
+        w.lean_turn.checked = true;
+        agent_refresh_authoritative_mode(&w);
+        AGENT_TEST_ASSERT(w.authoritative_mode ==
+                          AGENT_AUTHORITATIVE_LEAN_FINALIZATION_ONLY);
+        AGENT_TEST_ASSERT(agent_authoritative_tool_call_forbidden(&w));
+
+        /* Two authoritative domains in one turn: neither owns the verdict. */
+        agent_lean_turn_reset(&w.lean_turn);
+        w.authoritative_mode = AGENT_AUTHORITATIVE_NONE;
+        w.lean_turn.used = true;
+        w.lean_turn.state = AGENT_LEAN_CHECKING;
+        w.sage_turn.used = true;
+        agent_refresh_authoritative_mode(&w);
+        AGENT_TEST_ASSERT(w.authoritative_mode == AGENT_AUTHORITATIVE_CONFLICT);
+        AGENT_TEST_ASSERT(agent_authoritative_tool_call_forbidden(&w));
+        /* Latched: a conflict does not resolve itself mid-turn. */
+        w.sage_turn.used = false;
+        agent_refresh_authoritative_mode(&w);
+        AGENT_TEST_ASSERT(w.authoritative_mode == AGENT_AUTHORITATIVE_CONFLICT);
+    }
+
+    /* AUTH-C-08: Sage goes through the same generic gate. */
+    agent_lean_turn_reset(&w.lean_turn);
+    agent_sage_turn_reset(&w.sage_turn);
+    w.authoritative_mode = AGENT_AUTHORITATIVE_NONE;
+    w.sage_turn.used = true;
+    w.sage_turn.state = AGENT_SAGE_VALIDATION_REQUIRED;
+    agent_refresh_authoritative_mode(&w);
+    AGENT_TEST_ASSERT(w.authoritative_mode == AGENT_AUTHORITATIVE_SAGE_ACTIVE);
+    AGENT_TEST_ASSERT(!agent_authoritative_tool_call_forbidden(&w));
+    w.sage_turn.state = AGENT_SAGE_BUDGET_EXHAUSTED;
+    agent_refresh_authoritative_mode(&w);
+    AGENT_TEST_ASSERT(w.authoritative_mode ==
+                      AGENT_AUTHORITATIVE_SAGE_FINALIZATION_ONLY);
+    AGENT_TEST_ASSERT(agent_authoritative_tool_call_forbidden(&w));
+
+    /* AUTH-C-09: the next user turn starts from NONE. */
+    w.authoritative_mode = AGENT_AUTHORITATIVE_NONE;
+    w.authoritative_finalization_rounds = 0;
+    agent_lean_turn_reset(&w.lean_turn);
+    agent_sage_turn_reset(&w.sage_turn);
+    agent_refresh_authoritative_mode(&w);
+    AGENT_TEST_ASSERT(w.authoritative_mode == AGENT_AUTHORITATIVE_NONE);
+    AGENT_TEST_ASSERT(!agent_authoritative_tool_call_forbidden(&w));
