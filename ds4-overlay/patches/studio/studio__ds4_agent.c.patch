+/* The gate is tool-agnostic: the transcript failed because a per-tool block let
+ * the model reach for the next tool in the list. */
+static void test_agent_authoritative_tool_suppression(void) {
+    static const char *tools[] = {
+        "lean_check", "crawl", "web_search", "read", "bash", "edit", "search",
+    };
+    agent_worker w;
+    memset(&w, 0, sizeof(w));
+    agent_sage_turn_reset(&w.sage_turn);
+    w.sage_turn.used = true;
+
+    for (size_t i = 0; i < sizeof(tools) / sizeof(tools[0]); i++) {
+        w.authoritative_mode = AGENT_AUTHORITATIVE_NONE;
+        w.sage_turn.state = AGENT_SAGE_VALIDATION_REQUIRED;
+        agent_refresh_authoritative_mode(&w);
+        AGENT_TEST_ASSERT(!agent_authoritative_tool_call_forbidden(&w));
+
+        w.sage_turn.state = AGENT_SAGE_FAILED_NON_RETRYABLE;
+        agent_refresh_authoritative_mode(&w);
+        /* Whatever tools[i] is, the answer is the same. */
+        AGENT_TEST_ASSERT(agent_authoritative_tool_call_forbidden(&w));
+    }
+    printf("LEAN_TERMINAL_TOOL_SUPPRESSION=PASS tools=%zu\n",
+           sizeof(tools) / sizeof(tools[0]));
+}
