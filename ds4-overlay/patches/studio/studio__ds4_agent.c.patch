+/* WP02.6 — native inspect parser contract validation tests.
+ *
+ * Exercises: contractVersion validation (WP02.1), invariant check (WP02.5),
+ * success/timeout/error paths (WP-09: the obligation gate is gone). */
+/* WP-11/WP-19 — response integrity in the native bridge.
+ *
+ * The transcript that motivated this work asked for profile=mathlib and
+ * published "Profile: core" without anything noticing, and published a probe
+ * as the user's theorem. Both are now response-integrity failures: a result
+ * about other bytes, another profile or another statement is never a proof.
+ */
+static void test_agent_lean_response_echo_integrity(void) {
+    const char *code = "theorem cauchy_mvt : True := by trivial";
+
+    /* One worker per case: the turn state is what the assertions are about. */
+    #define ECHO_WORKER_BEGIN(mock_setup)                                     \
+        {                                                                     \
+            agent_http_mock m = {0};                                          \
+            m.mode = AGENT_HTTP_MOCK_OK;                                      \
+            m.echo_run_id = true;                                             \
+            mock_setup;                                                       \
+            AGENT_TEST_ASSERT(agent_http_mock_start(&m));                     \
+            agent_worker w;                                                   \
+            memset(&w, 0, sizeof(w));                                         \
+            agent_config cfg = {0};                                           \
+            cfg.frontend_port = m.port;                                       \
+            w.cfg = &cfg;                                                     \
+            w.lean_prompt = (char *)"session policy text";                    \
+            agent_lean_turn_reset(&w.lean_turn);                              \
+            ds4_kvstore_sha1_bytes_hex(w.lean_prompt, strlen(w.lean_prompt),  \
+                                       w.lean_policy_revision);               \
+            agent_worker_init_lean_contract(&w);
+
+    #define ECHO_WORKER_END()                                                 \
+            agent_http_mock_stop(&m);                                         \
+        }
+
+    agent_tool_arg proof_args[5] = {
+        {.name = (char *)"code", .value = (char *)code, .is_string = true},
+        {.name = (char *)"task_mode", .value = (char *)"proof", .is_string = true},
+        {.name = (char *)"target_declaration", .value = (char *)"cauchy_mvt",
+         .is_string = true},
+        {.name = (char *)"profile", .value = (char *)"mathlib", .is_string = true},
+        /* §11.2 — a proof call states its target, so the target is not
+         * read off the candidate that is supposed to prove it. */
+        {.name = (char *)"target_statement",
+         .value = (char *)"theorem cauchy_mvt : True", .is_string = true},
+    };
+    agent_tool_call proof_call = {
+        .name = (char *)"lean_check", .args = proof_args, .argc = 5};
+
+    /* LEAN_PROFILE_ROUNDTRIP_REGRESSION, accepted half: request mathlib,
+     * response mathlib, identity matched -> verified under mathlib. */
+    ECHO_WORKER_BEGIN((void)0)
+        char *out = agent_tool_lean_via_http(&w, &proof_call);
+        AGENT_TEST_ASSERT(out != NULL);
+        AGENT_TEST_ASSERT(out && strstr(out, "lean_check status=checked"));
+        AGENT_TEST_ASSERT(w.lean_turn.state == AGENT_LEAN_VERIFIED);
+        AGENT_TEST_ASSERT(!strcmp(w.lean_turn.checked_profile, "mathlib"));
+        AGENT_TEST_ASSERT(w.lean_turn.target_identity_locked);
+        AGENT_TEST_ASSERT(!strcmp(w.lean_turn.target_declaration, "cauchy_mvt"));
+        AGENT_TEST_ASSERT(w.lean_turn.checked_target_statement_sha256[0]);
+        /* The request really asked for mathlib: no silent core fallback. */
+        AGENT_TEST_ASSERT(m.req && strstr(m.req, "\"profile\":\"mathlib\""));
+        AGENT_TEST_ASSERT(m.req && strstr(m.req, "\"taskMode\":\"proof\""));
+        free(out);
+    ECHO_WORKER_END()
+
+    /* LEAN_PROFILE_ROUNDTRIP_REGRESSION, refused half: request mathlib,
+     * response core. status=checked must not rescue it. */
+    ECHO_WORKER_BEGIN(m.echo_profile = "core")
+        char *out = agent_tool_lean_via_http(&w, &proof_call);
+        AGENT_TEST_ASSERT(out != NULL);
+        AGENT_TEST_ASSERT(out && strstr(out, "LEAN_PROFILE_ECHO_MISMATCH"));
+        AGENT_TEST_ASSERT(out && !strstr(out, "lean_check status=checked"));
+        AGENT_TEST_ASSERT(w.lean_turn.state != AGENT_LEAN_VERIFIED);
+        free(out);
+    ECHO_WORKER_END()
+
+    /* WP-11 §14.6: the digest of other bytes is not evidence about these. */
+    ECHO_WORKER_BEGIN(m.echo_source_sha =
+        "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb")
+        char *out = agent_tool_lean_via_http(&w, &proof_call);
+        AGENT_TEST_ASSERT(out != NULL);
+        AGENT_TEST_ASSERT(out && strstr(out, "LEAN_SOURCE_ECHO_MISMATCH"));
+        AGENT_TEST_ASSERT(out && !strstr(out, "lean_check status=checked"));
+        AGENT_TEST_ASSERT(w.lean_turn.state != AGENT_LEAN_VERIFIED);
+        free(out);
+    ECHO_WORKER_END()
+
+    /* A checked proof result without target identity is not publishable. */
+    ECHO_WORKER_BEGIN(m.echo_target_identity_unmatched = true)
+        char *out = agent_tool_lean_via_http(&w, &proof_call);
+        AGENT_TEST_ASSERT(out != NULL);
+        AGENT_TEST_ASSERT(out && strstr(out, "LEAN_TARGET_IDENTITY_MISSING"));
+        AGENT_TEST_ASSERT(w.lean_turn.state != AGENT_LEAN_VERIFIED);
+        free(out);
+    ECHO_WORKER_END()
+
+    /* P0-03: a utility probe is checked, never verified, and leaves the proof
+     * task exactly as it found it — this is the 1+1=2 publication, refused. */
+    ECHO_WORKER_BEGIN((void)0)
+        agent_tool_arg utility_args[2] = {
+            {.name = (char *)"code",
+             .value = (char *)"theorem test : 1 + 1 = 2 := by decide",
+             .is_string = true},
+            {.name = (char *)"task_mode", .value = (char *)"utility",
+             .is_string = true},
+        };
+        agent_tool_call utility_call = {
+            .name = (char *)"lean_check", .args = utility_args, .argc = 2};
+        char *out = agent_tool_lean_via_http(&w, &utility_call);
+        AGENT_TEST_ASSERT(out != NULL);
+        AGENT_TEST_ASSERT(out && strstr(out, "task_mode=utility"));
+        AGENT_TEST_ASSERT(out && strstr(out, "authoritative=false"));
+        AGENT_TEST_ASSERT(out && !strstr(out, "LEAN_ORCHESTRATION"));
+        AGENT_TEST_ASSERT(w.lean_turn.state != AGENT_LEAN_VERIFIED);
+        AGENT_TEST_ASSERT(w.lean_turn.attempt_count == 0);
+        AGENT_TEST_ASSERT(!w.lean_turn.used);
+        AGENT_TEST_ASSERT(!w.lean_turn.proof_id[0]);
+        AGENT_TEST_ASSERT(!w.lean_turn.target_declaration[0]);
+        free(out);
+    ECHO_WORKER_END()
+
+    /* P0-04/P0-05: the proof task is one theorem. A second proof call naming
+     * another declaration is refused before anything is sent, and a retry that
+     * keeps the name but changes the statement is a repair request, not a
+     * verified result. */
+    ECHO_WORKER_BEGIN((void)0)
+        char *first = agent_tool_lean_via_http(&w, &proof_call);
+        AGENT_TEST_ASSERT(first != NULL);
+        AGENT_TEST_ASSERT(w.lean_turn.target_identity_locked);
+        free(first);
+
+        agent_tool_arg other_args[4] = {
+            {.name = (char *)"code",
+             .value = (char *)"theorem test : 1 + 1 = 2 := by decide",
+             .is_string = true},
+            {.name = (char *)"task_mode", .value = (char *)"proof",
+             .is_string = true},
+            {.name = (char *)"target_declaration", .value = (char *)"test",
+             .is_string = true},
+            /* §11.2 — a proof call states its target, so the target is not
+             * read off the candidate that is supposed to prove it. */
+            {.name = (char *)"target_statement",
+             .value = (char *)"theorem test : 1 + 1 = 2", .is_string = true},
+        };
+        agent_tool_call other_call = {
+            .name = (char *)"lean_check", .args = other_args, .argc = 4};
+        char *swap = agent_tool_lean_via_http(&w, &other_call);
+        AGENT_TEST_ASSERT(swap != NULL);
+        AGENT_TEST_ASSERT(swap && strstr(swap, "LEAN_TARGET_DECLARATION_MISMATCH"));
+        AGENT_TEST_ASSERT(!strcmp(w.lean_turn.target_declaration, "cauchy_mvt"));
+        free(swap);
+    ECHO_WORKER_END()
+
+    /* Same declaration name, substituted statement: the server's digest no
+     * longer matches the locked one, so the turn goes back to repair. The
+     * mock serves one connection per start, so the retry needs its own. */
+    ECHO_WORKER_BEGIN(m.echo_status = "failed"; m.echo_orch_repairable = true)
+        /* The first attempt fails but still carries a valid extraction, which
+         * is what locks the statement (§13.10). */
+        char *first = agent_tool_lean_via_http(&w, &proof_call);
+        AGENT_TEST_ASSERT(first != NULL);
+        AGENT_TEST_ASSERT(w.lean_turn.target_identity_locked);
+        AGENT_TEST_ASSERT(w.lean_turn.state != AGENT_LEAN_VERIFIED);
+        AGENT_TEST_ASSERT(!agent_lean_turn_is_terminal(&w.lean_turn));
+        free(first);
+
+        agent_http_mock m2 = {0};
+        m2.mode = AGENT_HTTP_MOCK_OK;
+        m2.echo_run_id = true;
+        m2.echo_target_sha =
+            "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc";
+        AGENT_TEST_ASSERT(agent_http_mock_start(&m2));
+        cfg.frontend_port = m2.port;
+        agent_tool_arg retry_args[5] = {
+            {.name = (char *)"code",
+             .value = (char *)"theorem cauchy_mvt : 1 = 1 := by rfl",
+             .is_string = true},
+            {.name = (char *)"task_mode", .value = (char *)"proof",
+             .is_string = true},
+            {.name = (char *)"target_declaration", .value = (char *)"cauchy_mvt",
+             .is_string = true},
+            {.name = (char *)"profile", .value = (char *)"mathlib",
+             .is_string = true},
+            /* §11.2 — a proof call states its target, so the target is not
+             * read off the candidate that is supposed to prove it. */
+            {.name = (char *)"target_statement",
+             .value = (char *)"theorem cauchy_mvt : True", .is_string = true},
+        };
+        agent_tool_call retry_call = {
+            .name = (char *)"lean_check", .args = retry_args, .argc = 5};
+        char *retry = agent_tool_lean_via_http(&w, &retry_call);
+        AGENT_TEST_ASSERT(retry != NULL);
+        AGENT_TEST_ASSERT(w.lean_turn.state != AGENT_LEAN_VERIFIED);
+        AGENT_TEST_ASSERT(!strcmp(w.lean_turn.failure_code,
+                                  "LEAN_TARGET_STATEMENT_MISMATCH"));
+        AGENT_TEST_ASSERT(!strcmp(w.lean_turn.failure_class, "target_identity"));
+        /* The lock survives the substitution: the next attempt still has to
+         * prove the original statement. */
+        AGENT_TEST_ASSERT(!strcmp(w.lean_turn.target_declaration, "cauchy_mvt"));
+        free(retry);
+        agent_http_mock_stop(&m2);
+    ECHO_WORKER_END()
+
+    #undef ECHO_WORKER_BEGIN
+    #undef ECHO_WORKER_END
+    printf("LEAN_PROFILE_ROUNDTRIP_REGRESSION=PASS\n");
+}
