+/* AUTH-C-06/07 — what the runtime publishes when it takes the verdict back. */
+static void test_agent_lean_authoritative_publications(void) {
+    static const char *source = "theorem t (x : ℝ) : x = x := rfl\n";
+    agent_lean_turn_state s;
+    memset(&s, 0, sizeof(s));
+    agent_lean_turn_reset(&s);
+
+    /* Terminal, never checked: NOT_VERIFIED plus the candidate, labelled. */
+    s.used = true;
+    s.attempt_count = 6;
+    agent_lean_turn_terminate(&s, AGENT_LEAN_BUDGET_EXHAUSTED,
+                              "LEAN_ATTEMPT_BUDGET_EXHAUSTED");
+    snprintf(s.failure_class, sizeof(s.failure_class), "budget");
+    s.last_source = xstrdup(source);
+
+    char *text = agent_lean_not_verified_text(&s);
+    AGENT_TEST_ASSERT(strstr(text, "STATE: NOT_VERIFIED") != NULL);
+    AGENT_TEST_ASSERT(strstr(text, "LEAN_ATTEMPT_BUDGET_EXHAUSTED") != NULL);
+    AGENT_TEST_ASSERT(strstr(text, "Attempts: 6/") != NULL);
+    AGENT_TEST_ASSERT(strstr(text, "Failure class: budget") != NULL);
+    AGENT_TEST_ASSERT(strstr(text, "Unverified candidate") != NULL);
+    AGENT_TEST_ASSERT(strstr(text, "Verified Lean source") == NULL);
+    /* The candidate comes back byte for byte, Unicode included. */
+    AGENT_TEST_ASSERT(strstr(text, source) != NULL);
+    free(text);
+
+    /* Verified: exact source, exact hash, locked target identity. */
+    agent_lean_turn_reset(&s);
+    s.used = true;
+    s.state = AGENT_LEAN_VERIFIED;
+    s.checked = true;
+    s.checked_source = xstrdup(source);
+    snprintf(s.checked_profile, sizeof(s.checked_profile), "mathlib");
+    ds4_sha256_hex(source, strlen(source), s.checked_source_sha256);
+    snprintf(s.target_declaration, sizeof(s.target_declaration), "%s", "cauchy_mvt");
+    snprintf(s.target_statement_sha256, sizeof(s.target_statement_sha256), "%s",
+             "3333333333333333333333333333333333333333333333333333333333333333");
+    snprintf(s.checked_target_statement_sha256,
+             sizeof(s.checked_target_statement_sha256), "%s",
+             s.target_statement_sha256);
+    s.target_identity_locked = true;
+
+    bool ok = false;
+    text = agent_lean_verified_text(&s, &ok);
+    AGENT_TEST_ASSERT(ok);
+    AGENT_TEST_ASSERT(strstr(text, "STATE: VERIFIED") != NULL);
+    AGENT_TEST_ASSERT(strstr(text, "Target declaration: cauchy_mvt") != NULL);
+    AGENT_TEST_ASSERT(strstr(text, s.target_statement_sha256) != NULL);
+    AGENT_TEST_ASSERT(strstr(text, "Profile: mathlib") != NULL);
+    AGENT_TEST_ASSERT(strstr(text, s.checked_source_sha256) != NULL);
+    AGENT_TEST_ASSERT(strstr(text, source) != NULL);
+    free(text);
+
+    /* A source that no longer hashes to what was checked is not published as
+     * verified, however convenient that would be. */
+    free(s.checked_source);
+    s.checked_source = xstrdup("theorem t : True := by sorry\n");
+    text = agent_lean_verified_text(&s, &ok);
+    AGENT_TEST_ASSERT(!ok);
+    AGENT_TEST_ASSERT(
+        strstr(text, "LEAN_CHECKED_SOURCE_INTEGRITY_FAILURE") != NULL);
+    AGENT_TEST_ASSERT(strstr(text, "STATE: VERIFIED") == NULL);
+    free(text);
+
+    /* status=checked with nothing retained is not a verified publication. */
+    free(s.checked_source);
+    s.checked_source = NULL;
+    text = agent_lean_verified_text(&s, &ok);
+    AGENT_TEST_ASSERT(!ok);
+    AGENT_TEST_ASSERT(strstr(text, "LEAN_CHECKED_SOURCE_MISSING") != NULL);
+    free(text);
+
+    /* Source identity is not task identity: bytes Lean accepted, with no
+     * locked target, are not publishable as the requested theorem (§13.12). */
+    agent_lean_turn_reset(&s);
+    s.used = true;
+    s.state = AGENT_LEAN_VERIFIED;
+    s.checked = true;
+    s.checked_source = xstrdup(source);
+    ds4_sha256_hex(source, strlen(source), s.checked_source_sha256);
+    text = agent_lean_verified_text(&s, &ok);
+    AGENT_TEST_ASSERT(!ok);
+    AGENT_TEST_ASSERT(strstr(text, "LEAN_TARGET_IDENTITY_MISSING") != NULL);
+    AGENT_TEST_ASSERT(strstr(text, "STATE: VERIFIED") == NULL);
+    free(text);
+
+    /* A checked statement that is not the locked one is refused as well. */
+    snprintf(s.target_declaration, sizeof(s.target_declaration), "%s", "cauchy_mvt");
+    snprintf(s.target_statement_sha256, sizeof(s.target_statement_sha256), "%s",
+             "3333333333333333333333333333333333333333333333333333333333333333");
+    snprintf(s.checked_target_statement_sha256,
+             sizeof(s.checked_target_statement_sha256), "%s",
+             "4444444444444444444444444444444444444444444444444444444444444444");
+    s.target_identity_locked = true;
+    text = agent_lean_verified_text(&s, &ok);
+    AGENT_TEST_ASSERT(!ok);
+    AGENT_TEST_ASSERT(strstr(text, "LEAN_TARGET_IDENTITY_MISMATCH") != NULL);
+    AGENT_TEST_ASSERT(strstr(text, "STATE: VERIFIED") == NULL);
+    free(text);
+
+    agent_lean_turn_reset(&s);
+    printf("LEAN_VERIFIED_SOURCE_IDENTITY=PASS\n");
+}
