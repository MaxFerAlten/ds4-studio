+/* §11.2 — the native client must not let a proof task define itself.
+ *
+ * The C never parses a Lean statement: it forwards the declared header and the
+ * server derives the sealed digest (§121/§123). What the C owes is the refusal
+ * when the header is missing, because without it the target would once again
+ * be whatever the first candidate happened to state. */
+static void test_agent_lean_target_statement_required(void) {
+    agent_worker w;
+    memset(&w, 0, sizeof(w));
+    agent_config cfg = {0};
+    /* No mock server is started: both calls must be refused on their arguments,
+     * before any request is built. */
+    cfg.frontend_port = 1;
+    w.cfg = &cfg;
+    w.lean_prompt = (char *)"dummy policy";
+    agent_lean_turn_reset(&w.lean_turn);
+    ds4_kvstore_sha1_bytes_hex(w.lean_prompt, strlen(w.lean_prompt),
+                               w.lean_policy_revision);
+    agent_worker_init_lean_contract(&w);
+    AGENT_TEST_ASSERT(agent_worker_lean_policy_coherent(&w));
+    AGENT_TEST_ASSERT(agent_worker_lean_contract_coherent(&w));
+
+    /* proof mode without target_statement: refused, and nothing is spent. */
+    agent_tool_arg missing[3] = {
+        {.name = (char *)"code",
+         .value = (char *)"theorem cauchy_mvt : True := by trivial",
+         .is_string = true},
+        {.name = (char *)"task_mode", .value = (char *)"proof", .is_string = true},
+        {.name = (char *)"target_declaration", .value = (char *)"cauchy_mvt",
+         .is_string = true},
+    };
+    agent_tool_call missing_call = {
+        .name = (char *)"lean_check", .args = missing, .argc = 3};
+    char *out = agent_tool_lean_via_http(&w, &missing_call);
+    AGENT_TEST_ASSERT(out != NULL);
+    if (out) {
+        AGENT_TEST_ASSERT(strstr(out, "LEAN_TASKSPEC_STATEMENT_REQUIRED") != NULL);
+        free(out);
+    }
+    /* Refused before the request was built: no proof task was started. */
+    AGENT_TEST_ASSERT(!w.lean_turn.target_identity_locked);
+    AGENT_TEST_ASSERT(w.lean_turn.state != AGENT_LEAN_VERIFIED);
+
+    /* utility mode must not seal one either: a probe has no task to seal. */
+    agent_tool_arg probe[3] = {
+        {.name = (char *)"code",
+         .value = (char *)"theorem probe : 1 + 1 = 2 := by decide",
+         .is_string = true},
+        {.name = (char *)"task_mode", .value = (char *)"utility", .is_string = true},
+        {.name = (char *)"target_statement",
+         .value = (char *)"theorem probe : 1 + 1 = 2", .is_string = true},
+    };
+    agent_tool_call probe_call = {
+        .name = (char *)"lean_check", .args = probe, .argc = 3};
+    char *probe_out = agent_tool_lean_via_http(&w, &probe_call);
+    AGENT_TEST_ASSERT(probe_out != NULL);
+    if (probe_out) {
+        AGENT_TEST_ASSERT(
+            strstr(probe_out, "LEAN_TARGET_STATEMENT_NOT_ALLOWED") != NULL);
+        free(probe_out);
+    }
+
+    /* The declared header travels in the request body verbatim, including
+     * Unicode: the server hashes those exact bytes. */
+    char *body = agent_lean_build_request(
+        "theorem t : True := by trivial", "mathlib", "s", "lean-x-1-1",
+        "proof-x-1-1", 1, "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
+        DS4_LEAN_CONTRACT_REVISION, "base", 30, NULL, "proof", "cauchy_mvt",
+        NULL,
+        "theorem cauchy_mvt (f g : \u211d \u2192 \u211d) : \u2203 c, deriv f c = 0");
+    AGENT_TEST_ASSERT(body != NULL);
+    if (body) {
+        AGENT_TEST_ASSERT(strstr(body, "\"targetStatement\":") != NULL);
+        AGENT_TEST_ASSERT(strstr(body, "\u211d \u2192 \u211d") != NULL);
+        AGENT_TEST_ASSERT(strstr(body, "\\u211d") == NULL);
+        free(body);
+    }
+
+    /* A utility request never carries one. */
+    char *utility = agent_lean_build_request(
+        "theorem p : True := by trivial", "core", "s", "lean-x-0-1", NULL, 1,
+        "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
+        DS4_LEAN_CONTRACT_REVISION, "base", 30, NULL, "utility", NULL, NULL,
+        NULL);
+    AGENT_TEST_ASSERT(utility != NULL);
+    if (utility) {
+        AGENT_TEST_ASSERT(strstr(utility, "targetStatement") == NULL);
+        free(utility);
+    }
+}
