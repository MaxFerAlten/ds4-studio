+static void test_agent_parse_lean_slash_commands(void) {
+    agent_slash_command parsed;
+
+    /* The four accepted verbs reach the Lean handler with their argument. */
+    static const char *const valid[] = {"start", "stop", "status", "preflight", NULL};
+    for (int i = 0; valid[i]; i++) {
+        char line[64];
+        snprintf(line, sizeof(line), "/lean %s", valid[i]);
+        memset(&parsed, 0, sizeof(parsed));
+        AGENT_TEST_ASSERT(agent_parse_slash_command(line, &parsed));
+        AGENT_TEST_ASSERT(parsed.kind == AGENT_SLASH_LEAN);
+        AGENT_TEST_ASSERT(!strcmp(parsed.arg, valid[i]));
+    }
+
+    /* /lean-pol must not exist: it is a separate command name, not a verb. */
+    memset(&parsed, 0, sizeof(parsed));
+    if (agent_parse_slash_command("/lean-pol start", &parsed))
+        AGENT_TEST_ASSERT(parsed.kind != AGENT_SLASH_LEAN);
+
+    /* Anything that is not exactly "preflight" falls through to the generic
+     * start|stop|status parser, which rejects it. */
+    memset(&parsed, 0, sizeof(parsed));
+    AGENT_TEST_ASSERT(agent_parse_slash_command("/lean preflight extra", &parsed));
+    AGENT_TEST_ASSERT(parsed.kind == AGENT_SLASH_LEAN);
+    AGENT_TEST_ASSERT(strcmp(parsed.arg, "preflight") != 0);
+
+    char err[256];
+    static const char *const invalid[] = {
+        "lean ", "lean starts", "lean status extra", "lean run", "lean install", NULL
+    };
+    for (int i = 0; invalid[i]; i++) {
+        agent_skill_command command = {0};
+        err[0] = '\0';
+        AGENT_TEST_ASSERT(
+            !agent_parse_skill_command_arg(invalid[i], &command, err, sizeof(err)));
+    }
+}
