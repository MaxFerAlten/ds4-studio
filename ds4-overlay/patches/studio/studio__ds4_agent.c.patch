+/* ---------------------------------------------------------------------------
+ * Built-in skills, described once
+ *
+ * Piano-rimedio 2 §15: adding Lean meant editing an independent switch or array
+ * in a dozen functions, and it was missed in six of them — the manifest
+ * validator, the revision store, the revision cleanup, the active count, the
+ * active bytes and the builtin list. Every one of those is now derived from
+ * this table, so a new built-in is one row plus whatever genuinely needs
+ * bespoke handling (prompt rendering order, which stays explicit).
+ * ------------------------------------------------------------------------- */
+typedef struct {
+    const char *name;
+    ds4_agent_skill_kind kind;
+    size_t prompt_offset;              /* char*  inside agent_worker */
+    size_t active_offset;              /* bool   inside agent_worker */
+    size_t revision_offset;            /* char[] inside agent_worker */
+    bool has_active_flag;
+    bool has_revision;                 /* an operational revision the tools read */
+    bool contributes_default_revision; /* part of the default-skills block */
+} agent_builtin_skill_descriptor;
+
+static const agent_builtin_skill_descriptor AGENT_BUILTIN_SKILLS[] = {
+    { "metacognition", DS4_AGENT_SKILL_BUILTIN_METACOGNITION,
+      offsetof(agent_worker, metacognition_prompt), 0, 0, false, false, false },
+    { "soul", DS4_AGENT_SKILL_BUILTIN_SOUL,
+      offsetof(agent_worker, soul_prompt),
+      offsetof(agent_worker, soul_active), 0, true, false, true },
+    { "ethic", DS4_AGENT_SKILL_BUILTIN_ETHIC,
+      offsetof(agent_worker, ethic_prompt),
+      offsetof(agent_worker, ethic_active), 0, true, false, true },
+    { "structure", DS4_AGENT_SKILL_BUILTIN_STRUCTURE,
+      offsetof(agent_worker, structure_prompt),
+      offsetof(agent_worker, structure_active), 0, true, false, true },
+    { "sage", DS4_AGENT_SKILL_BUILTIN_SAGE_POLICY,
+      offsetof(agent_worker, sage_prompt), 0,
+      offsetof(agent_worker, sage_policy_revision), false, true, false },
+    { "lean", DS4_AGENT_SKILL_BUILTIN_LEAN_POLICY,
+      offsetof(agent_worker, lean_prompt), 0,
+      offsetof(agent_worker, lean_policy_revision), false, true, false },
+};
+
+#define AGENT_BUILTIN_SKILL_COUNT \
+    (sizeof(AGENT_BUILTIN_SKILLS) / sizeof(AGENT_BUILTIN_SKILLS[0]))
+
+static const agent_builtin_skill_descriptor *agent_builtin_skill_by_kind(
+    ds4_agent_skill_kind kind) {
+    for (size_t i = 0; i < AGENT_BUILTIN_SKILL_COUNT; i++)
+        if (AGENT_BUILTIN_SKILLS[i].kind == kind)
+            return &AGENT_BUILTIN_SKILLS[i];
+    return NULL;
+}
+
+static const agent_builtin_skill_descriptor *agent_builtin_skill_by_name(
+    const char *name) {
+    if (!name) return NULL;
+    for (size_t i = 0; i < AGENT_BUILTIN_SKILL_COUNT; i++)
+        if (!strcmp(AGENT_BUILTIN_SKILLS[i].name, name))
+            return &AGENT_BUILTIN_SKILLS[i];
+    return NULL;
+}
+
+/** The prompt slot of a built-in skill inside a worker. */
+static char **agent_builtin_skill_prompt(
+    agent_worker *w, const agent_builtin_skill_descriptor *d) {
+    return (char **)((char *)w + d->prompt_offset);
+}
+
+/** Its activation flag, or NULL when the skill has none (presence is enough). */
+static bool *agent_builtin_skill_active(
+    agent_worker *w, const agent_builtin_skill_descriptor *d) {
+    return d->has_active_flag ? (bool *)((char *)w + d->active_offset) : NULL;
+}
+
+/** Its operational revision buffer, or NULL when the skill has none. */
+static char *agent_builtin_skill_revision(
+    agent_worker *w, const agent_builtin_skill_descriptor *d) {
+    return d->has_revision ? (char *)w + d->revision_offset : NULL;
+}
+
+/** True when the skill is currently contributing to the system prompt. */
+static bool agent_builtin_skill_loaded(
+    agent_worker *w, const agent_builtin_skill_descriptor *d) {
+    bool *active = agent_builtin_skill_active(w, d);
+    return active ? *active : *agent_builtin_skill_prompt(w, d) != NULL;
+}
+
+static bool agent_skill_builtin_kind_for_name(
+    const char *name,
+    ds4_agent_skill_kind *kind) {
+    const agent_builtin_skill_descriptor *d = agent_builtin_skill_by_name(name);
+    if (!d) return false;
+    *kind = d->kind;
+    return true;
+}
+
+static bool agent_worker_manifest_add_content(
+    ds4_agent_skill_manifest *manifest,
+    const char *name,
+    ds4_agent_skill_kind kind,
+    const char *content,
+    char *err,
+    size_t err_len) {
+    if (!content) {
+        snprintf(err, err_len,
+                 "SKILL_MANIFEST_IO_FAILED: active skill %s has no content",
+                 name);
+        return false;
+    }
+    size_t content_len = strlen(content);
+    char revision[DS4_AGENT_SKILL_REVISION_HEX + 1];
+    ds4_kvstore_sha1_bytes_hex(content, content_len, revision);
+    return ds4_agent_skill_manifest_add(
+        manifest, name, kind, revision, content_len, err, err_len);
+}
+
+static bool agent_worker_build_skill_manifest(
+    const agent_worker *w,
+    ds4_agent_skill_manifest *manifest,
+    char *err,
+    size_t err_len) {
+    ds4_agent_skill_manifest_init(manifest);
+    /* Table-driven: a built-in that exists cannot be forgotten here. */
+    for (size_t i = 0; i < AGENT_BUILTIN_SKILL_COUNT; i++) {
+        const agent_builtin_skill_descriptor *d = &AGENT_BUILTIN_SKILLS[i];
+        agent_worker *mutable_worker = (agent_worker *)(uintptr_t)w;
+        if (!agent_builtin_skill_loaded(mutable_worker, d)) continue;
+        char *prompt = *agent_builtin_skill_prompt(mutable_worker, d);
+        if (!prompt) continue;
+        if (!agent_worker_manifest_add_content(
+                manifest, d->name, d->kind, prompt, err, err_len))
+            return false;
+    }
+    for (size_t i = 0; i < w->dynamic_skills.len; i++) {
+        const ds4_agent_skill_entry *entry =
+            &w->dynamic_skills.items[i];
+        if (!ds4_agent_skill_manifest_add(
+                manifest, entry->name, entry->kind, entry->revision,
+                entry->content_len, err, err_len))
+            return false;
+    }
+    return true;
+}
+
+typedef struct {
+    ds4_agent_skill_registry dynamic_skills;
+    char *metacognition_prompt;
+    char *soul_prompt;
+    char *ethic_prompt;
+    char *structure_prompt;
+    char *sage_prompt;
+    char *lean_prompt;
+    bool soul_active;
+    bool ethic_active;
+    bool structure_active;
+    char sage_policy_revision[DS4_AGENT_SKILL_REVISION_HEX + 1];
+    char lean_policy_revision[DS4_AGENT_SKILL_REVISION_HEX + 1];
+    char default_skills_revision[DS4_AGENT_SKILL_REVISION_HEX + 1];
+    /* Set when the restored session was primed with a different Lean policy text
+     * than the one now on disk. Reported, never fatal (§24.4). */
+    bool lean_prompt_drifted;
+    char lean_saved_prompt_revision[DS4_AGENT_SKILL_REVISION_HEX + 1];
+} agent_worker_skill_state;
+
+static void agent_worker_skill_state_init(agent_worker_skill_state *state) {
+    memset(state, 0, sizeof(*state));
+    ds4_agent_skill_registry_init(&state->dynamic_skills);
+}
+
+static void agent_worker_skill_state_free(agent_worker_skill_state *state) {
+    if (!state) return;
+    ds4_agent_skill_registry_free(&state->dynamic_skills);
+    free(state->metacognition_prompt);
+    free(state->soul_prompt);
+    free(state->ethic_prompt);
+    free(state->structure_prompt);
+    free(state->sage_prompt);
+    free(state->lean_prompt);
+    memset(state, 0, sizeof(*state));
+}
+
+static void agent_worker_skill_state_revise_defaults(
+    agent_worker_skill_state *state) {
+    char *block = agent_build_default_skills_block(
+        state->soul_active ? state->soul_prompt : NULL,
+        state->ethic_active ? state->ethic_prompt : NULL,
+        state->structure_active ? state->structure_prompt : NULL);
+    if (!block) {
+        state->default_skills_revision[0] = '\0';
+        return;
+    }
+    ds4_kvstore_sha1_bytes_hex(block, strlen(block),
+                               state->default_skills_revision);
+    free(block);
+}
+
+static bool agent_worker_skill_state_take_entry(
+    agent_worker_skill_state *state,
+    ds4_agent_skill_entry *entry,
+    char *err,
+    size_t err_len) {
+    if (entry->kind == DS4_AGENT_SKILL_DYNAMIC) {
+        bool changed = false;
+        return ds4_agent_skill_registry_upsert(
+            &state->dynamic_skills, entry, &changed, err, err_len);
+    }
+
+    char **slot = NULL;
+    bool *active = NULL;
+    switch (entry->kind) {
+    case DS4_AGENT_SKILL_BUILTIN_METACOGNITION:
+        slot = &state->metacognition_prompt;
+        break;
+    case DS4_AGENT_SKILL_BUILTIN_SOUL:
+        slot = &state->soul_prompt;
+        active = &state->soul_active;
+        break;
+    case DS4_AGENT_SKILL_BUILTIN_ETHIC:
+        slot = &state->ethic_prompt;
+        active = &state->ethic_active;
+        break;
+    case DS4_AGENT_SKILL_BUILTIN_STRUCTURE:
+        slot = &state->structure_prompt;
+        active = &state->structure_active;
+        break;
+    case DS4_AGENT_SKILL_BUILTIN_SAGE_POLICY:
+        slot = &state->sage_prompt;
+        memcpy(state->sage_policy_revision, entry->revision,
+               sizeof(state->sage_policy_revision));
+        break;
+    case DS4_AGENT_SKILL_BUILTIN_LEAN_POLICY:
+        slot = &state->lean_prompt;
+        memcpy(state->lean_policy_revision, entry->revision,
+               sizeof(state->lean_policy_revision));
+        break;
+    default:
+        break;
+    }
+    if (!slot || *slot) {
+        snprintf(err, err_len,
+                 "SKILL_MANIFEST_IO_FAILED: invalid built-in skill state");
+        return false;
+    }
+    *slot = entry->content;
+    entry->content = NULL;
+    if (active) *active = true;
+    ds4_agent_skill_entry_free(entry);
+    agent_worker_skill_state_revise_defaults(state);
+    return true;
+}
+
+static bool agent_worker_stage_manifest_skills(
+    const ds4_agent_skill_manifest *manifest,
+    agent_worker_skill_state *state,
+    char *err,
+    size_t err_len) {
+    agent_worker_skill_state_init(state);
+    for (size_t i = 0; i < manifest->len; i++) {
+        const ds4_agent_skill_manifest_item *item = &manifest->items[i];
+        ds4_agent_skill_kind kind = DS4_AGENT_SKILL_DYNAMIC;
+        bool reserved = agent_skill_builtin_kind_for_name(item->name, &kind);
+        bool declared_dynamic =
+            item->kind == DS4_AGENT_SKILL_DYNAMIC;
+        if (reserved == declared_dynamic) {
+            snprintf(
+                err, err_len,
+                "SKILL_MANIFEST_IO_FAILED: invalid kind for skill %s",
+                item->name);
+            agent_worker_skill_state_free(state);
+            return false;
+        }
+
+        ds4_agent_skill_entry staged = {0};
+        if (!ds4_agent_skill_stage_from_disk(
+                agent_skills_dir(), item->name, kind, &staged,
+                err, err_len)) {
+            agent_worker_skill_state_free(state);
+            return false;
+        }
+        if (staged.content_len != item->content_len ||
+            strcmp(staged.revision, item->revision)) {
+            /* The Lean policy is the one exception, and only for its text.
+             *
+             * The rule as written refused to reopen any session whose skills had
+             * changed on disk, so editing skills/lean/SKILL.md bricked every
+             * saved session — and the failure was reported as a revision
+             * mismatch, which the model read as a Lean toolchain problem. The
+             * protocol is what has to be compatible, and that is compiled in:
+             * this binary implements exactly one lean_check contract, so a text
+             * difference is drift to report, not a reason to lose the session.
+             *
+             * The session adopts the current text with its own revision. Keeping
+             * the saved revision instead would leave the worker advertising a
+             * hash for bytes it does not hold — the very incoherence that
+             * produced the original mismatch (fix-revision-lean §24.4).
+             *
+             * Deliberately not relaxed for any other skill. */
+            if (kind != DS4_AGENT_SKILL_BUILTIN_LEAN_POLICY) {
+                ds4_agent_skill_entry_free(&staged);
+                snprintf(
+                    err, err_len,
+                    "SKILL_SESSION_REVISION_MISMATCH: skill %s changed",
+                    item->name);
+                agent_worker_skill_state_free(state);
+                return false;
+            }
+            state->lean_prompt_drifted = true;
+            snprintf(state->lean_saved_prompt_revision,
+                     sizeof(state->lean_saved_prompt_revision), "%s",
+                     item->revision);
+        }
+        if (!agent_worker_skill_state_take_entry(
+                state, &staged, err, err_len)) {
+            ds4_agent_skill_entry_free(&staged);
+            agent_worker_skill_state_free(state);
+            return false;
+        }
+    }
+    return true;
+}
+
+static bool agent_worker_stage_legacy_skills(
+    agent_worker_skill_state *state,
+    char *err,
+    size_t err_len) {
+    agent_worker_skill_state_init(state);
+    static const struct {
+        const char *name;
+        ds4_agent_skill_kind kind;
+    } defaults[] = {
+        {"soul", DS4_AGENT_SKILL_BUILTIN_SOUL},
+        {"ethic", DS4_AGENT_SKILL_BUILTIN_ETHIC},
+        {"structure", DS4_AGENT_SKILL_BUILTIN_STRUCTURE}
+    };
+    if (agent_default_skills_enabled()) {
+        for (size_t i = 0; i < sizeof(defaults) / sizeof(defaults[0]); i++) {
+            ds4_agent_skill_entry staged = {0};
+            if (!ds4_agent_skill_stage_from_disk(
+                    agent_skills_dir(), defaults[i].name,
+                    defaults[i].kind, &staged, err, err_len) ||
+                !agent_worker_skill_state_take_entry(
+                    state, &staged, err, err_len)) {
+                ds4_agent_skill_entry_free(&staged);
+                agent_worker_skill_state_free(state);
+                return false;
+            }
+        }
+    }
+    if (agent_sage_policy_auto_enabled()) {
+        ds4_agent_skill_entry staged = {0};
+        char sage_err[256] = {0};
+        if (ds4_agent_skill_stage_from_disk(
+                agent_skills_dir(), "sage",
+                DS4_AGENT_SKILL_BUILTIN_SAGE_POLICY,
+                &staged, sage_err, sizeof(sage_err))) {
+            if (!agent_worker_skill_state_take_entry(
+                    state, &staged, err, err_len)) {
+                ds4_agent_skill_entry_free(&staged);
+                agent_worker_skill_state_free(state);
+                return false;
+            }
+        }
+    }
+    /* Lean too: a session saved before manifests existed used to come back with
+     * no Lean state at all, so the worker silently kept the previous session's
+     * policy. An unreadable policy leaves the state empty on purpose — the tool
+     * is then not advertised, which beats advertising a revision for text this
+     * session never held (fix-revision-lean §3.2, §8.4). */
+    if (agent_lean_policy_auto_enabled()) {
+        ds4_agent_skill_entry staged = {0};
+        char lean_err[256] = {0};
+        if (ds4_agent_skill_stage_from_disk(
+                agent_skills_dir(), "lean",
+                DS4_AGENT_SKILL_BUILTIN_LEAN_POLICY,
+                &staged, lean_err, sizeof(lean_err))) {
+            if (!agent_worker_skill_state_take_entry(
+                    state, &staged, err, err_len)) {
+                ds4_agent_skill_entry_free(&staged);
+                agent_worker_skill_state_free(state);
+                return false;
+            }
+        }
+    }
+    return true;
+}
+
+static void agent_worker_apply_skill_state(
+    agent_worker *w,
+    agent_worker_skill_state *state) {
+    ds4_agent_skill_registry_free(&w->dynamic_skills);
+    w->dynamic_skills = state->dynamic_skills;
+    memset(&state->dynamic_skills, 0, sizeof(state->dynamic_skills));
+
+    free(w->metacognition_prompt);
+    free(w->soul_prompt);
+    free(w->ethic_prompt);
+    free(w->structure_prompt);
+    free(w->sage_prompt);
+    free(w->lean_prompt);
+    w->metacognition_prompt = state->metacognition_prompt;
+    w->soul_prompt = state->soul_prompt;
+    w->ethic_prompt = state->ethic_prompt;
+    w->structure_prompt = state->structure_prompt;
+    w->sage_prompt = state->sage_prompt;
+    w->lean_prompt = state->lean_prompt;
+    state->metacognition_prompt = NULL;
+    state->soul_prompt = NULL;
+    state->ethic_prompt = NULL;
+    state->structure_prompt = NULL;
+    state->sage_prompt = NULL;
+    state->lean_prompt = NULL;
+
+    w->soul_active = state->soul_active;
+    w->ethic_active = state->ethic_active;
+    w->structure_active = state->structure_active;
+    w->default_skills_enabled =
+        state->soul_active || state->ethic_active ||
+        state->structure_active;
+    memcpy(w->sage_policy_revision, state->sage_policy_revision,
+           sizeof(w->sage_policy_revision));
+    /* Prompt and revision move together or the session ends up advertising a
+     * policy hash for text it does not hold: the server then rejects the check
+     * for a drift the session never had (fix-revision-lean §3.1). */
+    memcpy(w->lean_policy_revision, state->lean_policy_revision,
+           sizeof(w->lean_policy_revision));
+    /* The restored session speaks this binary's protocol, whatever prompt it
+     * came back with, and it has not compared revisions with a server yet. */
+    agent_worker_init_lean_contract(w);
+    /* lean_prompt_drift_detected is deliberately *not* set from
+     * state->lean_prompt_drifted. That flag means "this session and the server
+     * hold different policy text", and the restore just adopted the text the
+     * server reads, so there is nothing left to differ. What the restore found —
+     * that the transcript was primed with older instructions — is reported once
+     * by the caller instead of becoming permanent drift state the tool result
+     * would keep misdescribing. */
+    memcpy(w->default_skills_revision, state->default_skills_revision,
+           sizeof(w->default_skills_revision));
 }
 
