+static void test_agent_sage_native_transitions(void) {
+    char err[96] = {0};
+    agent_sage_turn_state s;
+
+    unsetenv("DS4_SAGE_AUTONOMOUS_ORCHESTRATION");
+    AGENT_TEST_ASSERT(agent_sage_authoritative_loop_enabled());
+    setenv("DS4_SAGE_AUTONOMOUS_ORCHESTRATION", "off", 1);
+    AGENT_TEST_ASSERT(!agent_sage_authoritative_loop_enabled());
+    unsetenv("DS4_SAGE_AUTONOMOUS_ORCHESTRATION");
+
+    /* S-C-01: the mirror accepts the phase the server published. */
+    agent_sage_turn_reset(&s);
+    AGENT_TEST_ASSERT(s.state == AGENT_SAGE_IDLE);
+    AGENT_TEST_ASSERT(!s.used);
+    AGENT_TEST_ASSERT(agent_sage_turn_before_call(&s, "compute", err, sizeof(err)));
+    agent_sage_turn_adopt(&s, "validation_required", false, false, false,
+                          false, false, false, false, false, 1,
+                          "validate", "pending_validation", "", "Validate it.");
+    AGENT_TEST_ASSERT(s.state == AGENT_SAGE_VALIDATION_REQUIRED);
+    AGENT_TEST_ASSERT(!strcmp(agent_sage_turn_next_phase(&s), "validate"));
+    AGENT_TEST_ASSERT(agent_sage_turn_must_continue(&s));
+
+    /* S-C-02: no independent repair budget — the mirror keeps accepting the
+     * repairs the server authorises, well past the old local limit of five. */
+    for (int revision = 2; revision <= 7; revision++) {
+        AGENT_TEST_ASSERT(agent_sage_turn_before_call(&s, "validate", err, sizeof(err)));
+        agent_sage_turn_adopt(&s, "repair_required", false, true, false,
+                              true, false, false, false, false, revision - 1,
+                              "repair", "math_validation_failed", "sha256:x",
+                              "Fix the derivative.");
+        AGENT_TEST_ASSERT(s.state == AGENT_SAGE_REPAIR_REQUIRED);
+        AGENT_TEST_ASSERT(s.retryable);
+        AGENT_TEST_ASSERT(!s.terminal);
+        AGENT_TEST_ASSERT(agent_sage_turn_before_call(&s, "repair", err, sizeof(err)));
+        agent_sage_turn_adopt(&s, "validation_required", false, false, false,
+                              false, false, false, false, false, revision,
+                              "validate", "pending_validation", "", "Validate it.");
+        AGENT_TEST_ASSERT(s.candidate_revision == revision);
+    }
+
+    /* S-C-04: the counters are not zeroed after a call. */
+    AGENT_TEST_ASSERT(s.total_call_count > 5);
+
+    /* S-C-03: the safety ceiling stops a server that never terminates. */
+    agent_sage_turn_reset(&s);
+    for (int i = 0; i < DS4_SAGE_MAX_TOTAL_CALLS_HARD; i++) {
+        AGENT_TEST_ASSERT(agent_sage_turn_before_call(&s, "repair", err, sizeof(err)));
+        agent_sage_turn_adopt(&s, "repair_required", false, true, false,
+                              true, false, false, false, false, i + 1,
+                              "repair", "math_validation_failed", "sha256:y",
+                              "Fix it.");
+    }
+    AGENT_TEST_ASSERT(!agent_sage_turn_before_call(&s, "repair", err, sizeof(err)));
+    AGENT_TEST_ASSERT(!strcmp(err, "SAGE_SAFETY_CEILING_REACHED"));
+    AGENT_TEST_ASSERT(s.state == AGENT_SAGE_BUDGET_EXHAUSTED);
+    AGENT_TEST_ASSERT(agent_sage_turn_is_terminal(&s));
+    AGENT_TEST_ASSERT(!agent_sage_turn_must_continue(&s));
+
+    /* S-C-06: premature prose is discarded and the decision re-injected, and
+     * only the exhausted budget ends the turn. */
+    agent_sage_turn_reset(&s);
+    AGENT_TEST_ASSERT(agent_sage_turn_before_call(&s, "compute", err, sizeof(err)));
+    agent_sage_turn_adopt(&s, "validation_required", false, false, false,
+                          false, false, false, false, false, 1,
+                          "validate", "pending_validation", "",
+                          "Validate candidate revision 1.");
+    for (int episode = 0; episode < DS4_SAGE_MAX_PREMATURE_FINALIZATIONS; episode++) {
+        AGENT_TEST_ASSERT(agent_sage_turn_record_premature_finalization(&s));
+        AGENT_TEST_ASSERT(!agent_sage_turn_is_terminal(&s));
+    }
+    AGENT_TEST_ASSERT(!agent_sage_turn_record_premature_finalization(&s));
+    AGENT_TEST_ASSERT(s.state == AGENT_SAGE_BUDGET_EXHAUSTED);
+    {
+        char *guidance = agent_sage_terminal_notice(&s);
+        AGENT_TEST_ASSERT(guidance != NULL);
+        AGENT_TEST_ASSERT(strstr(guidance, "SAGE_TERMINAL_NOT_PUBLISHABLE") != NULL);
+        AGENT_TEST_ASSERT(strstr(guidance, "NOT_PUBLISHABLE") != NULL);
+        free(guidance);
+    }
+
+    /* The continuation block names the phase and never asks the user. */
+    agent_sage_turn_reset(&s);
+    AGENT_TEST_ASSERT(agent_sage_turn_before_call(&s, "compute", err, sizeof(err)));
+    agent_sage_turn_adopt(&s, "repair_required", false, true, false,
+                          true, false, false, false, true, 2,
+                          "repair", "math_validation_failed", "sha256:z",
+                          "Correct the derivative classification.");
+    {
+        char *guidance = agent_sage_continuation_guidance(&s);
+        AGENT_TEST_ASSERT(guidance != NULL);
+        AGENT_TEST_ASSERT(strstr(guidance, "SAGE_ORCHESTRATION") != NULL);
+        AGENT_TEST_ASSERT(strstr(guidance, "nextPhase=repair") != NULL);
+        AGENT_TEST_ASSERT(strstr(guidance, "candidateRevision=2") != NULL);
+        AGENT_TEST_ASSERT(strstr(guidance, "strategyChangeRequired=true") != NULL);
+        AGENT_TEST_ASSERT(strstr(guidance, "FINALIZATION_ALLOWED=false") != NULL);
+        AGENT_TEST_ASSERT(strstr(guidance, "do not ask the user") != NULL);
+        free(guidance);
+    }
+
+    /* S-C-07: only a ready, authoritative, validated run may publish. */
+    agent_sage_turn_reset(&s);
+    AGENT_TEST_ASSERT(agent_sage_turn_before_call(&s, "compute", err, sizeof(err)));
+    agent_sage_turn_adopt(&s, "ready", true, false, true,
+                          true, true, true, true, false, 1,
+                          "publish", "success_publishable", "", "Publish it.");
+    AGENT_TEST_ASSERT(agent_sage_turn_can_finalize(&s));
+    AGENT_TEST_ASSERT(!agent_sage_turn_must_continue(&s));
+
+    /* A ready state without authority is not publishable. */
+    agent_sage_turn_reset(&s);
+    AGENT_TEST_ASSERT(agent_sage_turn_before_call(&s, "compute", err, sizeof(err)));
+    agent_sage_turn_adopt(&s, "ready", true, false, true,
+                          false, true, true, true, false, 1,
+                          "publish", "success_publishable", "", "Publish it.");
+    AGENT_TEST_ASSERT(!agent_sage_turn_can_finalize(&s));
+
+    /* S-C-08: an infrastructure block permits only NOT_PUBLISHABLE. */
+    agent_sage_turn_reset(&s);
+    AGENT_TEST_ASSERT(agent_sage_turn_before_call(&s, "compute", err, sizeof(err)));
+    agent_sage_turn_transport_failure(&s);
+    AGENT_TEST_ASSERT(s.state == AGENT_SAGE_INFRASTRUCTURE_BLOCK);
+    AGENT_TEST_ASSERT(agent_sage_turn_is_terminal(&s));
+    AGENT_TEST_ASSERT(!agent_sage_turn_can_finalize(&s));
+    AGENT_TEST_ASSERT(!agent_sage_turn_must_continue(&s));
+
+    /* An unknown state name is never optimistically accepted. */
+    agent_sage_turn_reset(&s);
+    agent_sage_turn_adopt(&s, "inventato", false, true, true,
+                          true, true, true, true, false, 1,
+                          "publish", "", "", "");
+    AGENT_TEST_ASSERT(s.state == AGENT_SAGE_FAILED_NON_RETRYABLE);
+    AGENT_TEST_ASSERT(!agent_sage_turn_can_finalize(&s));
+
+    /* S-C-10: the candidate revision grows and reset clears everything. */
+    agent_sage_turn_reset(&s);
+    agent_sage_turn_adopt(&s, "validation_required", false, false, false,
+                          false, false, false, false, false, 4,
+                          "validate", "", "", "");
+    AGENT_TEST_ASSERT(agent_sage_turn_attempt(&s) == 4);
+    s.premature_finalization_count = 2;
+    snprintf(s.run_id, sizeof(s.run_id), "stale");
+    agent_sage_turn_reset(&s);
+    AGENT_TEST_ASSERT(s.premature_finalization_count == 0);
+    AGENT_TEST_ASSERT(s.candidate_revision == 0);
+    AGENT_TEST_ASSERT(s.total_call_count == 0);
+    AGENT_TEST_ASSERT(s.run_id[0] == '\0');
+    AGENT_TEST_ASSERT(!s.authoritative && !s.publishable &&
+                      !s.final_markdown_ready);
+}
