+static void test_agent_protocol_failure_classification(void) {
+    agent_dsml_parser structural = {.state = AGENT_DSML_STRUCTURAL};
+    agent_dsml_parser errored = {.state = AGENT_DSML_ERROR};
+
+    /* DSML inside <think> wins even when the parser also errored, so the two
+     * signals cannot fingerprint as two different failures. */
+    AGENT_TEST_ASSERT(agent_protocol_failure_classify(true, true, false, false,
+        &errored) == DS4_AGENT_PROTOCOL_FAILURE_DSML_IN_THINK);
+    AGENT_TEST_ASSERT(agent_protocol_failure_classify(false, false, false, true,
+        &errored) == DS4_AGENT_PROTOCOL_FAILURE_DEGENERATE_GENERATION);
+    AGENT_TEST_ASSERT(agent_protocol_failure_classify(false, false, true, false,
+        NULL) == DS4_AGENT_PROTOCOL_FAILURE_TOOL_PREFLIGHT);
+    AGENT_TEST_ASSERT(agent_protocol_failure_classify(false, true, false, false,
+        &structural) == DS4_AGENT_PROTOCOL_FAILURE_DSML_INCOMPLETE);
+    AGENT_TEST_ASSERT(agent_protocol_failure_classify(false, true, false, false,
+        &errored) == DS4_AGENT_PROTOCOL_FAILURE_DSML_PARSE);
+    AGENT_TEST_ASSERT(agent_protocol_failure_classify(false, false, false, false,
+        &errored) == DS4_AGENT_PROTOCOL_FAILURE_NONE);
+}
