+    snprintf(s->diagnostic_fingerprint, sizeof(s->diagnostic_fingerprint), "%s",
+             fingerprint ? fingerprint : "");
+    snprintf(s->next_action, sizeof(s->next_action), "%s",
+             next_action ? next_action : "");
