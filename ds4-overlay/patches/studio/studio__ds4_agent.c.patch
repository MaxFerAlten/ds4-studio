+/* refactoring.003 §6.10 — the generic tool-protocol guard.  These certify the
+ * distinction the observed loop lacked: a protocol failure is repairable once,
+ * then must change strategy, then is terminal. */
+static void test_agent_protocol_guard_bounded_recovery(void) {
+    ds4_agent_protocol_guard g;
+    ds4_agent_protocol_guard_reset(&g);
+    const char *think_err =
+        "tool calling is not allowed inside <think></think>";
+
+    /* PROTO-C-01/02/03: same failure -> continue, strategy change, terminal. */
+    AGENT_TEST_ASSERT(ds4_agent_protocol_guard_record(
+        &g, DS4_AGENT_PROTOCOL_FAILURE_DSML_IN_THINK, think_err) ==
+        DS4_AGENT_PROTOCOL_CONTINUE);
+    AGENT_TEST_ASSERT(g.same_failure_count == 1 && !g.terminal);
+    AGENT_TEST_ASSERT(ds4_agent_protocol_guard_record(
+        &g, DS4_AGENT_PROTOCOL_FAILURE_DSML_IN_THINK, think_err) ==
+        DS4_AGENT_PROTOCOL_STRATEGY_CHANGE);
+    AGENT_TEST_ASSERT(g.strategy_change_required && !g.terminal);
+    AGENT_TEST_ASSERT(ds4_agent_protocol_guard_record(
+        &g, DS4_AGENT_PROTOCOL_FAILURE_DSML_IN_THINK, think_err) ==
+        DS4_AGENT_PROTOCOL_TERMINAL);
+    AGENT_TEST_ASSERT(g.terminal && g.terminal_reason[0]);
+
+    /* PROTO-C-07: terminal is latched for the rest of the user turn. */
+    AGENT_TEST_ASSERT(ds4_agent_protocol_guard_record(
+        &g, DS4_AGENT_PROTOCOL_FAILURE_DSML_PARSE, "something else") ==
+        DS4_AGENT_PROTOCOL_TERMINAL);
+    ds4_agent_protocol_guard_note_success(&g);
+    AGENT_TEST_ASSERT(g.terminal);
+
+    /* PROTO-C-08: a new user turn starts clean. */
+    ds4_agent_protocol_guard_reset(&g);
+    AGENT_TEST_ASSERT(!g.terminal && g.total_failure_count == 0);
+
+    /* PROTO-C-04: a different failure resets the same-counter, not the total. */
+    AGENT_TEST_ASSERT(ds4_agent_protocol_guard_record(
+        &g, DS4_AGENT_PROTOCOL_FAILURE_DSML_IN_THINK, think_err) ==
+        DS4_AGENT_PROTOCOL_CONTINUE);
+    AGENT_TEST_ASSERT(ds4_agent_protocol_guard_record(
+        &g, DS4_AGENT_PROTOCOL_FAILURE_DSML_PARSE, "unterminated string") ==
+        DS4_AGENT_PROTOCOL_CONTINUE);
+    AGENT_TEST_ASSERT(g.same_failure_count == 1 && g.total_failure_count == 2);
+
+    /* PROTO-C-05: six alternating protocol failures are terminal on the total,
+     * even though no single fingerprint ever reaches three. */
+    ds4_agent_protocol_guard_reset(&g);
+    ds4_agent_protocol_decision last = DS4_AGENT_PROTOCOL_CONTINUE;
+    for (int i = 0; i < 6; i++) {
+        last = ds4_agent_protocol_guard_record(
+            &g, i % 2 ? DS4_AGENT_PROTOCOL_FAILURE_DSML_PARSE
+                      : DS4_AGENT_PROTOCOL_FAILURE_TOOL_PREFLIGHT,
+            i % 2 ? "unterminated string" : "edit old selector failed");
+        if (i < 5) AGENT_TEST_ASSERT(last != DS4_AGENT_PROTOCOL_TERMINAL);
+    }
+    AGENT_TEST_ASSERT(last == DS4_AGENT_PROTOCOL_TERMINAL);
+    AGENT_TEST_ASSERT(g.total_failure_count == 6);
+
+    /* PROTO-C-06: a good round clears the streak but not the audit total. */
+    ds4_agent_protocol_guard_reset(&g);
+    (void)ds4_agent_protocol_guard_record(
+        &g, DS4_AGENT_PROTOCOL_FAILURE_DSML_IN_THINK, think_err);
+    (void)ds4_agent_protocol_guard_record(
+        &g, DS4_AGENT_PROTOCOL_FAILURE_DSML_IN_THINK, think_err);
+    ds4_agent_protocol_guard_note_success(&g);
+    AGENT_TEST_ASSERT(g.same_failure_count == 0 && g.total_failure_count == 2);
+    AGENT_TEST_ASSERT(!g.strategy_change_required);
+    AGENT_TEST_ASSERT(ds4_agent_protocol_guard_record(
+        &g, DS4_AGENT_PROTOCOL_FAILURE_DSML_IN_THINK, think_err) ==
+        DS4_AGENT_PROTOCOL_CONTINUE);
+}
