+/* Degrade a verified state whose identity does not match the locked target.
+ * Called after record_result; the lock survives so the next attempt still
+ * proves the original declaration, not the substitute that just returned. */
+static void agent_lean_turn_apply_result_identity(
+    agent_lean_turn_state *s,
+    const char *returned_target_sha,
+    bool returned_identity_matched) {
+    if (!s || s->state != AGENT_LEAN_VERIFIED) return;
+    bool ok = s->target_identity_locked && s->target_statement_sha256[0] &&
+              returned_identity_matched && returned_target_sha &&
+              !strcmp(returned_target_sha, s->target_statement_sha256);
+    if (ok) {
+        snprintf(s->checked_target_statement_sha256,
+                 sizeof(s->checked_target_statement_sha256), "%s",
+                 returned_target_sha);
+        return;
+    }
+    s->state = AGENT_LEAN_REPAIR_REQUIRED;
+    s->checked = false;
+    s->retryable = true;
+    snprintf(s->failure_class, sizeof(s->failure_class), "target_identity");
+    snprintf(s->failure_code, sizeof(s->failure_code), "%s",
+             "LEAN_TARGET_STATEMENT_MISMATCH");
+    snprintf(s->next_action, sizeof(s->next_action), "%s",
+             "Restore locked theorem statement; change proof body only.");
+}
+
+/* Gate one attempt before the request is built.
+ *
+ * source_sha256 may be NULL (callers that cannot hash yet); when present, an
+ * unchanged source after a failure is refused without burning an attempt —
+ * resending identical bytes cannot produce a different result. */
+static bool agent_lean_turn_before_attempt(agent_lean_turn_state *s,
+                                           const char *source_sha256,
+                                           bool allow_unchanged_source,
+                                           char *err, size_t err_len) {
+    if (!s) { if (err && err_len) snprintf(err, err_len, "no lean turn state"); return false; }
+
+    if (agent_lean_turn_is_terminal(s)) {
+        if (err && err_len)
+            snprintf(err, err_len,
+                     "the proof task is already terminal (state %d)", s->state);
+        return false;
+    }
+
+    if (s->max_attempts <= 0) s->max_attempts = DS4_LEAN_MAX_ATTEMPTS;
+    if (s->attempt_count >= s->max_attempts) {
+        agent_lean_turn_mark_budget_exhausted(s);
+        if (err && err_len)
+            snprintf(err, err_len,
+                     "the %d-attempt budget for this proof is spent",
+                     s->max_attempts);
+        return false;
+    }
+
+    if (s->used && s->started_at_sec > 0.0 &&
+        (now_sec() - s->started_at_sec) * 1000.0 >= (double)DS4_LEAN_MAX_WALL_CLOCK_MS) {
+        agent_lean_turn_terminate(s, AGENT_LEAN_BUDGET_EXHAUSTED,
+                                  "WALL_CLOCK_EXHAUSTED");
+        if (err && err_len)
+            snprintf(err, err_len, "the proof exceeded its %d ms wall-clock budget",
+                     DS4_LEAN_MAX_WALL_CLOCK_MS);
+        return false;
+    }
+
+    if (source_sha256 && source_sha256[0] && s->attempt_count > 0 &&
+        !allow_unchanged_source &&
+        !strcmp(source_sha256, s->last_source_sha256)) {
+        /* A refusal costs no attempt, so on its own it would let a stubborn
+         * model resend the same bytes forever. Bound it with the same budget
+         * that bounds premature finalizations. */
+        s->unchanged_source_rejections++;
+        if (s->unchanged_source_rejections > DS4_LEAN_MAX_PREMATURE_FINALIZATIONS) {
+            agent_lean_turn_terminate(s, AGENT_LEAN_BUDGET_EXHAUSTED,
+                                      "SOURCE_UNCHANGED_BUDGET_EXHAUSTED");
+            if (err && err_len)
+                snprintf(err, err_len,
+                         "the same unmodified source was submitted too many "
+                         "times; the proof task ends NOT_VERIFIED");
+            return false;
+        }
+        if (err && err_len)
+            snprintf(err, err_len,
+                     "the source is byte-identical to the attempt that just "
+                     "failed; repair it before calling lean_check again");
+        return false;
+    }
+
+    s->attempt_count++;
+    s->unchanged_source_rejections = 0;
+    s->state = AGENT_LEAN_CHECKING;
+    s->used = true;
+    s->retryable = false;
+    if (s->started_at_sec <= 0.0) s->started_at_sec = now_sec();
+    if (source_sha256 && source_sha256[0])
+        snprintf(s->last_source_sha256, sizeof(s->last_source_sha256), "%s",
+                 source_sha256);
+    return true;
+}
+
+/* Roll back an attempt that was never consumed (attemptConsumed=false).
+ * A pre-spawn rejection (candidate preflight, contract error, etc.) must not
+ * count toward the proof budget. */
+static void agent_lean_turn_rollback_unconsumed_attempt(
+    agent_lean_turn_state *s) {
+    if (!s) return;
+    if (s->attempt_count > 0) s->attempt_count--;
+    s->last_source_sha256[0] = '\0';
+    free(s->last_source);
+    s->last_source = NULL;
+}
+
+/* Fold the server's orchestration decision into the turn state.
+ *
+ * The decision is the runtime's, not the model's: `verified` here can only come
+ * from a result the Node classifier already checked against status=checked and
+ * its invariants. */
+static void agent_lean_turn_record_result(agent_lean_turn_state *s,
+                                          bool terminal,
+                                          bool verified,
+                                          bool retryable,
+                                          const char *failure_class,
+                                          const char *next_action,
+                                          const char *fingerprint,
+                                          bool strategy_change_required,
+                                          const char *terminal_reason,
+                                          const char *source_sha256) {
+    if (!s) return;
+
+    s->retryable = retryable;
+    s->strategy_change_required = strategy_change_required;
+    if (next_action)
+        snprintf(s->next_action, sizeof(s->next_action), "%s", next_action);
+
+    /* Captured before failure_class is overwritten: the class comparison below
+     * needs the previous attempt's class, not this one's. */
+    char prev_failure_class[48];
+    snprintf(prev_failure_class, sizeof(prev_failure_class), "%s", s->failure_class);
+
+    if (failure_class)
+        snprintf(s->failure_class, sizeof(s->failure_class), "%s", failure_class);
+
+    if (verified) {
+        s->state = AGENT_LEAN_VERIFIED;
+        s->checked = true;
+        s->same_failure_count = 0;
+        s->same_class_count = 0;
+        s->failure_class[0] = '\0';
+        s->diagnostic_fingerprint[0] = '\0';
+        if (source_sha256 && source_sha256[0])
+            snprintf(s->checked_source_sha256, sizeof(s->checked_source_sha256),
+                     "%s", source_sha256);
+        return;
+    }
+
+    /* Repetition is counted here rather than trusted from the wire: the server
+     * answers one attempt at a time and does not know this turn's history. */
+    if (fingerprint && fingerprint[0]) {
+        if (!strcmp(fingerprint, s->diagnostic_fingerprint))
+            s->same_failure_count++;
+        else
+            s->same_failure_count = 1;
+        snprintf(s->diagnostic_fingerprint, sizeof(s->diagnostic_fingerprint),
+                 "%s", fingerprint);
+    }
+
+    if (failure_class && !strcmp(failure_class, "user_cancelled")) {
+        agent_lean_turn_terminate(s, AGENT_LEAN_CANCELLED,
+                                  terminal_reason && terminal_reason[0]
+                                      ? terminal_reason : "USER_CANCELLED");
+        return;
+    }
+
+    /* candidate_preflight is repairable, not terminal. Do not count it as a
+     * same-failure (it's not a Lean diagnostic failure) and do not force a
+     * strategy change. */
+    if (failure_class && !strcmp(failure_class, "candidate_preflight")) {
+        s->state = AGENT_LEAN_REPAIR_REQUIRED;
+        return;
+    }
+
+    if (terminal || !retryable) {
+        /* Map failure class to the correct terminal state. */
+        agent_lean_state term_state =
+            (failure_class && !strcmp(failure_class, "contract"))
+                ? AGENT_LEAN_CONTRACT_BLOCK
+                : AGENT_LEAN_INFRASTRUCTURE_BLOCK;
+        agent_lean_turn_terminate(s, term_state,
+                                  terminal_reason && terminal_reason[0]
+                                      ? terminal_reason
+                                      : "NON_RETRYABLE_ERROR");
+        return;
+    }
+
+    if (s->attempt_count >= s->max_attempts) {
+        agent_lean_turn_mark_budget_exhausted(s);
+        return;
+    }
+
+    /* Same class, different candidate: ordinary repair for a round or two, then
+     * evidence that editing the proof is not the problem. One rung above the
+     * fingerprint rule, mirroring classifyLeanResult in leanRepairPolicy.mjs —
+     * an identical failure is pathological at once, a merely similar one needs
+     * another round before it stops being progress. Terminal, cancelled and
+     * candidate_preflight results return above and never reach this. */
+    if (failure_class && failure_class[0] &&
+        !strcmp(failure_class, prev_failure_class))
+        s->same_class_count++;
+    else
+        s->same_class_count = 1;
+
+    if (strategy_change_required ||
+        s->same_failure_count >= DS4_LEAN_MAX_SAME_FAILURE ||
+        s->same_class_count >= DS4_LEAN_STRATEGY_CHANGE_AFTER + 1) {
+        s->strategy_change_required = true;
+        s->state = AGENT_LEAN_STRATEGY_CHANGE_REQUIRED;
+        s->strategy_generation++;
+        return;
+    }
+    s->state = AGENT_LEAN_REPAIR_REQUIRED;
+}
+
+/* The model answered in prose while a repairable failure was outstanding.
+ *
+ * The first ones are not fatal — a small model needs telling — but the budget
+ * is finite, and past it the turn ends as NOT_VERIFIED rather than looping. */
+static bool agent_lean_turn_record_premature_finalization(agent_lean_turn_state *s) {
+    if (!s) return false;
+    s->premature_finalization_count++;
+    if (s->premature_finalization_count > DS4_LEAN_MAX_PREMATURE_FINALIZATIONS) {
+        agent_lean_turn_terminate(s, AGENT_LEAN_BUDGET_EXHAUSTED,
+                                  "PREMATURE_FINALIZATION_BUDGET_EXHAUSTED");
+        return false;
+    }
+    if (s->premature_finalization_count >= 3 &&
+        !agent_lean_turn_is_terminal(s)) {
+        s->strategy_change_required = true;
+        s->state = AGENT_LEAN_STRATEGY_CHANGE_REQUIRED;
+        s->strategy_generation++;
+    }
+    return true;
+}
+
+static int agent_lean_turn_attempt(const agent_lean_turn_state *s) {
+    return s ? s->attempt_count : 0;
+}
