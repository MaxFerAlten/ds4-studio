+static void test_agent_skill_name_contract(void) {
+    char err[128] = {0};
+    char max_name[DS4_AGENT_SKILL_NAME_MAX + 1];
+    char too_long[DS4_AGENT_SKILL_NAME_MAX + 2];
+    memset(max_name, 'a', DS4_AGENT_SKILL_NAME_MAX);
+    max_name[DS4_AGENT_SKILL_NAME_MAX] = '\0';
+    memset(too_long, 'a', DS4_AGENT_SKILL_NAME_MAX + 1);
+    too_long[DS4_AGENT_SKILL_NAME_MAX + 1] = '\0';
+
+    AGENT_TEST_ASSERT(ds4_agent_skill_name_valid("lean", err, sizeof(err)));
+    AGENT_TEST_ASSERT(ds4_agent_skill_name_valid("formal-verification_2",
+                                                 err, sizeof(err)));
+    AGENT_TEST_ASSERT(ds4_agent_skill_name_valid(max_name, err, sizeof(err)));
+    AGENT_TEST_ASSERT(!ds4_agent_skill_name_valid("", err, sizeof(err)));
+    AGENT_TEST_ASSERT(!ds4_agent_skill_name_valid("Lean", err, sizeof(err)));
+    AGENT_TEST_ASSERT(!ds4_agent_skill_name_valid("../lean", err, sizeof(err)));
+    AGENT_TEST_ASSERT(!ds4_agent_skill_name_valid("-lean", err, sizeof(err)));
+    AGENT_TEST_ASSERT(!ds4_agent_skill_name_valid(".", err, sizeof(err)));
+    AGENT_TEST_ASSERT(!ds4_agent_skill_name_valid("..", err, sizeof(err)));
+    AGENT_TEST_ASSERT(!ds4_agent_skill_name_valid("x/y", err, sizeof(err)));
+    AGENT_TEST_ASSERT(!ds4_agent_skill_name_valid("x\\y", err, sizeof(err)));
+    AGENT_TEST_ASSERT(!ds4_agent_skill_name_valid("/tmp/x", err, sizeof(err)));
+    AGENT_TEST_ASSERT(!ds4_agent_skill_name_valid("~root", err, sizeof(err)));
+    AGENT_TEST_ASSERT(!ds4_agent_skill_name_valid("%2e%2e", err, sizeof(err)));
+    AGENT_TEST_ASSERT(!ds4_agent_skill_name_valid(
+        "x\xe2\x88\x95y", err, sizeof(err)));
+    AGENT_TEST_ASSERT(!ds4_agent_skill_name_valid(too_long, err, sizeof(err)));
+}
