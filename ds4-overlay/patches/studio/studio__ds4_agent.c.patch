+/* QF-24 section 46 — the composed decision at the publish site: the same bytes
+ * are withheld or released on nothing but what the turn observed. */
+static void test_agent_epistemic_scan_gates_publication(void) {
+    agent_worker w;
+    memset(&w, 0, sizeof(w));
+    ds4_agent_epistemic_turn_reset(&w.epistemic_turn);
+
+    const char *candidate = "The patch is tested and passes tests.";
+    const size_t candidate_len = strlen(candidate);
+
+    ds4_epistemic_scan_result scan =
+        ds4_agent_epistemic_scan_final_text(&w.epistemic_turn, candidate, candidate_len);
+    AGENT_TEST_ASSERT(scan.blocked);
+    /* Unsupported, not false: the C scan has no way to reach the second. */
+    AGENT_TEST_ASSERT(!strcmp(scan.verdict, DS4_EPI_VERDICT_BLOCK_UNSUPPORTED));
+    AGENT_TEST_ASSERT(!ds4_agent_epistemic_can_publish(&scan, DS4_EPI_MODE_BLOCK));
+
+    agent_deferred_output deferred = {0};
+    agent_token_renderer renderer = { .worker = &w, .deferred = &deferred };
+    renderer_write(&renderer, candidate, candidate_len);
+    agent_deferred_output_publish(&w, &deferred,
+                                  ds4_agent_epistemic_can_publish(&scan, DS4_EPI_MODE_BLOCK));
+    AGENT_TEST_ASSERT(w.out_len == 0);
+    AGENT_TEST_ASSERT(deferred.ptr == NULL);
+
+    /* Shadow observes the same block and still changes nothing the user sees. */
+    AGENT_TEST_ASSERT(ds4_agent_epistemic_can_publish(&scan, DS4_EPI_MODE_SHADOW));
+
+    /* After the command that pays for the wording, the same bytes publish. */
+    ds4_agent_epistemic_tool_result ok = { .has_status = true, .ok = true,
+                                           .has_exit_code = true, .exit_code = 0 };
+    ds4_agent_epistemic_note_tool(&w.epistemic_turn, "bash", &ok);
+    ds4_agent_epistemic_note_command(&w.epistemic_turn, "make test", &ok);
+    ds4_epistemic_scan_result cleared =
+        ds4_agent_epistemic_scan_final_text(&w.epistemic_turn, candidate, candidate_len);
+    AGENT_TEST_ASSERT(!cleared.blocked);
+
+    agent_deferred_output allowed = {0};
+    agent_token_renderer allowed_renderer = { .worker = &w, .deferred = &allowed };
+    renderer_write(&allowed_renderer, candidate, candidate_len);
+    agent_deferred_output_publish(&w, &allowed,
+                                  ds4_agent_epistemic_can_publish(&cleared, DS4_EPI_MODE_BLOCK));
+    AGENT_TEST_ASSERT(w.out_len == candidate_len);
+
+    free(w.out);
+}
