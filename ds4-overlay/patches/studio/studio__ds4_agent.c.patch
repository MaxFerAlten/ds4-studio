+static void test_agent_http_transport_failures(void) {
+    /* Nothing listening on the port: connect fails fast, no hang. */
+    int dead = 1;
+    agent_http_response r = {0};
+    bool ok = agent_http_post_json(dead, "/api/lean/exec", "{}", 2, 500, 4096, &r);
+    AGENT_TEST_ASSERT(!ok);
+    AGENT_TEST_ASSERT(r.error[0] != '\0');
+
+    /* Bad status line is rejected, not parsed as 200. */
+    agent_http_mock m = {0};
+    m.mode = AGENT_HTTP_MOCK_BAD_STATUS;
+    AGENT_TEST_ASSERT(agent_http_mock_start(&m));
+    agent_http_response r2 = {0};
+    ok = agent_http_post_json(m.port, "/api/lean/exec", "{}", 2, 2000, 4096, &r2);
+    AGENT_TEST_ASSERT(!ok);
+    AGENT_TEST_ASSERT(strstr(r2.error, "LEAN_HTTP_BAD_STATUS_LINE"));
+    agent_http_mock_stop(&m);
+
+    /* Server sleeps past the client deadline: timeout, not a hang. */
+    agent_http_mock ms = {0};
+    ms.mode = AGENT_HTTP_MOCK_SLOW;
+    ms.delay_ms = 800;
+    AGENT_TEST_ASSERT(agent_http_mock_start(&ms));
+    agent_http_response r3 = {0};
+    double t0 = now_sec();
+    ok = agent_http_post_json(ms.port, "/api/lean/exec", "{}", 2, 200, 4096, &r3);
+    double dt = now_sec() - t0;
+    AGENT_TEST_ASSERT(!ok);
+    AGENT_TEST_ASSERT(strstr(r3.error, "LEAN_HTTP_TIMEOUT"));
+    AGENT_TEST_ASSERT(dt < 5.0);
+    agent_http_mock_stop(&ms);
+
+    /* Content-Length advertises more than is sent: partial body is an error. */
+    agent_http_mock mp = {0};
+    mp.mode = AGENT_HTTP_MOCK_PARTIAL_CL;
+    AGENT_TEST_ASSERT(agent_http_mock_start(&mp));
+    agent_http_response r4 = {0};
+    ok = agent_http_post_json(mp.port, "/api/lean/exec", "{}", 2, 2000, 4096, &r4);
+    AGENT_TEST_ASSERT(!ok);
+    AGENT_TEST_ASSERT(strstr(r4.error, "LEAN_HTTP_PARTIAL_CONTENT_LENGTH"));
+    agent_http_mock_stop(&mp);
+
+    /* Body bigger than the cap: flagged too_large, no unbounded allocation. */
+    agent_http_mock ml = {0};
+    ml.mode = AGENT_HTTP_MOCK_TOO_LARGE;
+    AGENT_TEST_ASSERT(agent_http_mock_start(&ml));
+    agent_http_response r5 = {0};
+    ok = agent_http_post_json(ml.port, "/api/lean/exec", "{}", 2, 5000, 1024, &r5);
+    AGENT_TEST_ASSERT(ok);
+    AGENT_TEST_ASSERT(r5.too_large);
+    AGENT_TEST_ASSERT(r5.body != NULL);
+    free(r5.body);
+    agent_http_mock_stop(&ml);
+
+    /* No Content-Length: body is read to EOF. */
+    agent_http_mock mn = {0};
+    mn.mode = AGENT_HTTP_MOCK_NO_CL;
+    mn.body = "{\"eof\":true}";
+    AGENT_TEST_ASSERT(agent_http_mock_start(&mn));
+    agent_http_response r6 = {0};
+    ok = agent_http_post_json(mn.port, "/api/lean/exec", "{}", 2, 2000, 4096, &r6);
+    AGENT_TEST_ASSERT(ok);
+    AGENT_TEST_ASSERT(ok);
+    AGENT_TEST_ASSERT(r6.body && !strcmp(r6.body, "{\"eof\":true}"));
+    free(r6.body);
+    agent_http_mock_stop(&mn);
+
+    /* Headers only, closed: empty body is still a successful exchange. */
+    agent_http_mock mh = {0};
+    mh.mode = AGENT_HTTP_MOCK_NO_BODY;
+    AGENT_TEST_ASSERT(agent_http_mock_start(&mh));
+    agent_http_response r7 = {0};
