+static void test_agent_lean_request_body_utf8(void) {
+    /* Unicode source: the request must carry the exact UTF-8 bytes. The old
+     * json_encode escaped every non-ASCII byte as \u00xx, corrupting sources
+     * like a comment containing "€" or an accented identifier. */
+    const char *code = "-- ünïcödé € ✓\ntheorem t : True := by trivial";
+    /* The distinctive run of UTF-8 bytes must appear verbatim in the JSON.
+     * The newline is escaped (\\n) by the encoder, so it is checked apart. */
+    const char *code_utf8 = " ünïcödé € ✓";
+
+    char *body = agent_lean_build_request(
+        code, "core", "0123456789abcdef0123456789abcdef01234567",
+        "lean-0123456789ab-1-1", "proof-0123456789ab-1-1", 0,
+        "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
+        DS4_LEAN_CONTRACT_REVISION, "base", 30, NULL,
+        "proof", "t", NULL, NULL);
+    AGENT_TEST_ASSERT(body != NULL);
+    if (body) {
+        AGENT_TEST_ASSERT(strstr(body, "\"contractVersion\":\"lean_check_request_v1\"") != NULL);
+        AGENT_TEST_ASSERT(strstr(body, code_utf8) != NULL);   /* byte identity */
+        AGENT_TEST_ASSERT(strstr(body, "\\u00fc") == NULL);   /* no \u00xx mangling */
+        AGENT_TEST_ASSERT(strstr(body, "\"timeoutSec\":30") != NULL);
+        AGENT_TEST_ASSERT(strstr(body, "3600") == NULL);
+        AGENT_TEST_ASSERT(strstr(body, "\"input\"") == NULL);
+        AGENT_TEST_ASSERT(strstr(body, "\"mode\":\"check\"") != NULL);
+        AGENT_TEST_ASSERT(strstr(body, "\"proofPolicy\":\"typecheck\"") != NULL);
+        AGENT_TEST_ASSERT(strstr(body, "\"profile\":\"core\"") != NULL);
+        AGENT_TEST_ASSERT(strstr(body, "\"sessionId\":\"0123456789abcdef0123456789abcdef01234567\"") != NULL);
+        AGENT_TEST_ASSERT(strstr(body, "\"runId\":\"lean-0123456789ab-1-1\"") != NULL);
+        AGENT_TEST_ASSERT(strstr(body, "\"proofId\":\"proof-0123456789ab-1-1\"") != NULL);
+        AGENT_TEST_ASSERT(strstr(body, "\"attempt\":0") != NULL);
+        /* promptRevision and its legacy alias carry the same value; the contract
+         * revision is a different length on purpose, so a swap cannot pass. */
+        AGENT_TEST_ASSERT(strstr(body, "\"promptRevision\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"") != NULL);
+        AGENT_TEST_ASSERT(strstr(body, "\"policyRevision\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"") != NULL);
+        AGENT_TEST_ASSERT(strstr(body, "\"contractRevision\":\"" DS4_LEAN_CONTRACT_REVISION "\"") != NULL);
+        AGENT_TEST_ASSERT(strstr(body, "\"policyMode\":\"base\"") != NULL);
+        AGENT_TEST_ASSERT(strstr(body, "expectedDeclarations") == NULL);
+        /* WP-16 §19.1: the proof task travels with the request. */
+        AGENT_TEST_ASSERT(strstr(body, "\"taskMode\":\"proof\"") != NULL);
+        AGENT_TEST_ASSERT(strstr(body, "\"targetDeclaration\":\"t\"") != NULL);
+        /* No lock yet on the first attempt: the field is omitted, not empty. */
+        AGENT_TEST_ASSERT(strstr(body, "expectedTargetStatementSha256") == NULL);
+        AGENT_TEST_ASSERT(body[0] == '{' && body[strlen(body) - 1] == '}');
+        /* The JSON must be machine-parseable: the code string round-trips. */
+        char *extracted = agent_json_extract_string(body, "code");
+        AGENT_TEST_ASSERT(extracted != NULL);
+        if (extracted) {
+            AGENT_TEST_ASSERT(strcmp(extracted, code) == 0);
+            free(extracted);
+        }
+        free(body);
+    }
+
+    /* HTML-ish payload: quotes, backslashes, control chars must be escaped. */
+    char *tricky = agent_lean_build_request(
+        "theorem t : \"a\\b\" := by\n  trivial", "core", "s", "lean-x-1-1",
+        NULL, 0, "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
+        DS4_LEAN_CONTRACT_REVISION, "base", 1, NULL,
+        "utility", NULL, NULL, NULL);
+    AGENT_TEST_ASSERT(tricky != NULL);
+    if (tricky) {
+        AGENT_TEST_ASSERT(strstr(tricky, "\\\"a\\\\b\\\"") != NULL);
+        AGENT_TEST_ASSERT(strstr(tricky, "\\n") != NULL);
+        free(tricky);
+    }
+
+    /* A flat declarations array is forwarded; anything else is dropped. */
+    char *with_decl = agent_lean_build_request(
+        "x", "core", "s", "lean-x-1-1", NULL, 0,
+        "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
+        DS4_LEAN_CONTRACT_REVISION, "autonomous", 30, "[\"t\"]",
+        "utility", NULL, NULL, NULL);
+    AGENT_TEST_ASSERT(with_decl != NULL);
+    if (with_decl) {
+        AGENT_TEST_ASSERT(strstr(with_decl, "\"expectedDeclarations\":[\"t\"]") != NULL);
+        AGENT_TEST_ASSERT(strstr(with_decl, "\"policyMode\":\"autonomous\"") != NULL);
+        /* An absent proofId is omitted rather than sent empty: the server's
+         * sanitizer would reject "" and mint one anyway. */
+        AGENT_TEST_ASSERT(strstr(with_decl, "proofId") == NULL);
+        free(with_decl);
+    }
+    char *bad_decl = agent_lean_build_request(
+        "x", "core", "s", "lean-x-1-1", NULL, 0,
+        "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
+        DS4_LEAN_CONTRACT_REVISION, "base", 30,
+        "[\"a\\\"],\\\"command\\\":\\\"rm\"]",
+        "utility", NULL, NULL, NULL);
+    AGENT_TEST_ASSERT(bad_decl != NULL);
+    if (bad_decl) {
+        AGENT_TEST_ASSERT(strstr(bad_decl, "expectedDeclarations") == NULL);
+        free(bad_decl);
+    }
+
+    /* WP-16 §19.1: once the statement is locked, the retry carries the hash. */
+    char *locked = agent_lean_build_request(
+        "theorem t : True := by trivial", "core", "s", "lean-x-1-2",
+        "proof-x-1-1", 1, "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
+        DS4_LEAN_CONTRACT_REVISION, "base", 30, NULL, "proof", "t",
+        "abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789",
+        NULL);
+    AGENT_TEST_ASSERT(locked != NULL);
+    if (locked) {
+        AGENT_TEST_ASSERT(strstr(locked,
+            "\"expectedTargetStatementSha256\":\"abcdef0123456789abcdef0123456789"
+            "abcdef0123456789abcdef0123456789\"") != NULL);
+        free(locked);
+    }
+
+    /* WP-16 §19.1: a utility probe carries no proof identity at all. */
+    char *utility = agent_lean_build_request(
+        "theorem probe : True := by trivial", "core", "s", "lean-x-0-1", NULL,
+        1, "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
+        DS4_LEAN_CONTRACT_REVISION, "base", 30, NULL, "utility", NULL, NULL,
+        NULL);
+    AGENT_TEST_ASSERT(utility != NULL);
+    if (utility) {
+        AGENT_TEST_ASSERT(strstr(utility, "\"taskMode\":\"utility\"") != NULL);
+        AGENT_TEST_ASSERT(strstr(utility, "proofId") == NULL);
+        AGENT_TEST_ASSERT(strstr(utility, "targetDeclaration") == NULL);
+        AGENT_TEST_ASSERT(strstr(utility, "expectedTargetStatementSha256") == NULL);
+        free(utility);
+    }
+
+    /* WP-16 §19.2: a target that is not a declaration name never reaches the
+     * wire — the validator refuses it before the JSON is built. */
+    AGENT_TEST_ASSERT(!agent_lean_valid_declaration_name("t\"],\"command\":\"rm"));
+    AGENT_TEST_ASSERT(!agent_lean_valid_declaration_name("has space"));
+    AGENT_TEST_ASSERT(agent_lean_valid_declaration_name("Cauchy.mean_value'"));
+
+    /* WP-16 §19.3: a valid profile is sent verbatim, never downgraded. */
+    char *mathlib = agent_lean_build_request(
+        "theorem t : True := by trivial", "mathlib", "s", "lean-x-1-3",
+        "proof-x-1-1", 1, "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
+        DS4_LEAN_CONTRACT_REVISION, "base", 30, NULL, "proof", "t", NULL,
+        NULL);
+    AGENT_TEST_ASSERT(mathlib != NULL);
+    if (mathlib) {
+        AGENT_TEST_ASSERT(strstr(mathlib, "\"profile\":\"mathlib\"") != NULL);
+        AGENT_TEST_ASSERT(strstr(mathlib, "\"profile\":\"core\"") == NULL);
+        free(mathlib);
+    }
+
+    /* Embedded NUL cannot survive argument parsing (tool args are C strings),
+     * but the encoder must stop at the first NUL rather than reading past the
+     * declared length. */
+    char nul_code[16];
+    memcpy(nul_code, "abc\0def", 7);
+    char *escaped = agent_json_escape(nul_code, sizeof(nul_code));
+    AGENT_TEST_ASSERT(escaped != NULL);
+    if (escaped) {
+        AGENT_TEST_ASSERT(strcmp(escaped, "\"abc\"") == 0);
+        free(escaped);
+    }
+}
+
+/* ---------------------------------------------------------------------------
+ * R2 transport tests: a thread serving canned HTTP/1.1 responses on an
+ * ephemeral loopback port exercises agent_http_post_json and the lean tool
+ * end to end, proving the transport is curl/shell-free and honors deadlines,
+ * Content-Length, and the response size cap.
+ * ------------------------------------------------------------------------- */
+
+typedef enum {
+    AGENT_HTTP_MOCK_OK,          /* HTTP 200 with a JSON body + Content-Length */
+    AGENT_HTTP_MOCK_ERROR,       /* HTTP 500 with a JSON body */
+    AGENT_HTTP_MOCK_SLOW,        /* holds the connection past the deadline */
+    AGENT_HTTP_MOCK_BAD_STATUS,  /* non-HTTP status line */
+    AGENT_HTTP_MOCK_PARTIAL_CL,  /* advertises more bytes than it sends */
+    AGENT_HTTP_MOCK_TOO_LARGE,   /* body larger than max_body_bytes */
+    AGENT_HTTP_MOCK_NO_CL,       /* body delimited by EOF, no Content-Length */
+    AGENT_HTTP_MOCK_NO_BODY      /* headers only, connection closed */
+} agent_http_mock_mode;
+
+typedef struct {
+    int listen_fd;
+    int port;
+    pthread_t th;
+    volatile bool done;
+    agent_http_mock_mode mode;
+    const char *status_line;     /* override for OK/ERROR */
+    const char *body;            /* override for OK/ERROR */
+    bool echo_run_id;            /* OK mode: echo the request's runId back */
+    /* OK mode: the prompt revision the "server" holds. Non-empty makes the
+     * canned result report a non-blocking prompt drift. */
+    char server_prompt_revision[41];
+    /* echo_run_id mode: vary the canned result without giving up the runId and
+     * revision echoing the client requires before it will read a status at all.
+     * `echo_status` replaces "checked"; `echo_extra` is spliced in as raw JSON
+     * fields (each must start with a comma). */
+    const char *echo_status;
+    const char *echo_extra;
+    /* Response integrity fixtures (WP-11/WP-19). By default the mock answers
+     * about the source, profile and target it was actually sent — the server
+     * half of the echo contract. An override reproduces a server that answers
+     * about something else, which the client must refuse. */
+    const char *echo_source_sha;      /* overrides the digest of request.code */
+    const char *echo_profile;         /* overrides the requested profile */
+    const char *echo_target_sha;      /* overrides the target statement digest */
+    bool echo_target_identity_unmatched;
+    /* A repairable failure: the turn stays open for the next attempt, which is
+     * what a retry fixture needs. */
+    bool echo_orch_repairable;
+    long delay_ms;
+    char *req;                   /* full captured request (headers + body) */
+    char error[128];
+} agent_http_mock;
+
+static void *agent_http_mock_thread(void *arg) {
+    agent_http_mock *m = (agent_http_mock *)arg;
+    struct sockaddr_in cli;
+    socklen_t clen = sizeof(cli);
+    int fd = accept(m->listen_fd, (struct sockaddr *)&cli, &clen);
+    if (fd < 0) {
+        snprintf(m->error, sizeof(m->error), "accept failed: %s", strerror(errno));
+        return NULL;
+    }
+
+    /* Read the request: headers until CRLFCRLF, then Content-Length bytes. A
+     * single recv may carry headers and body together, so count the bytes that
+     * arrive after the header terminator as part of the body. */
+    agent_http_buf req = {0};
+    char chunk[1024];
+    char *sep = NULL;
+    for (;;) {
+        ssize_t n = recv(fd, chunk, sizeof(chunk), 0);
+        if (n <= 0) break;
+        if (!agent_http_buf_append(&req, chunk, (size_t)n, 65536)) break;
+        sep = strstr(req.ptr, "\r\n\r\n");
+        if (sep) break;
+    }
+    size_t content_len = 0;
+    for (char *p = req.ptr; p && *p;) {
+        char *nl = strstr(p, "\r\n");
+        size_t l = nl ? (size_t)(nl - p) : strlen(p);
+        if (l >= 15 && !strncasecmp(p, "Content-Length:", 15))
+            content_len = strtoul(p + 15, NULL, 10);
+        if (!nl) break;
+        p = nl + 2;
+    }
+    size_t body_start = sep ? (size_t)((sep + 4) - req.ptr) : req.len;
+    while (req.len < body_start + content_len) {
+        ssize_t n = recv(fd, chunk, sizeof(chunk), 0);
+        if (n <= 0) break;
+        size_t take = (size_t)n;
+        if (req.len + take > body_start + content_len)
+            take = body_start + content_len - req.len;
+        if (!agent_http_buf_append(&req, chunk, take, 65536)) break;
+    }
+    m->req = req.ptr;
+
+    if (m->delay_ms > 0) usleep((useconds_t)(m->delay_ms * 1000));
+
+    if (m->mode == AGENT_HTTP_MOCK_SLOW) {
+        /* Hold the connection open well past the client deadline. */
+        usleep((useconds_t)(m->delay_ms * 1000));
+        close(fd);
+        return NULL;
+    }
+
+    const char *status = m->status_line ? m->status_line : "HTTP/1.1 200 OK";
+    if (m->mode == AGENT_HTTP_MOCK_BAD_STATUS) {
+        const char *garbage = "NOT-HTTP at all\r\n\r\n";
+        send(fd, garbage, strlen(garbage), MSG_NOSIGNAL);
+        close(fd);
+        return NULL;
+    }
+
+    const char *body = m->body ? m->body : "{\"ok\":true}";
+    char *dyn_body = NULL;
+    if (m->mode == AGENT_HTTP_MOCK_OK && m->echo_run_id && m->req) {
+        char *rid = agent_json_extract_string(m->req, "runId");
+        if (rid) {
+            /* Echo the revision the client sent: the server side of the
+             * contract is "answer for the policy you were given", and the
+             * client rejects a mismatch. Hardcoding one here would only test
+             * the mismatch path. */
+            char *rev = agent_json_extract_string(m->req, "promptRevision");
+            char *creq = agent_json_extract_string(m->req, "contractRevision");
+            /* The echo the client verifies: the digest of the bytes it sent,
+             * the profile it asked for, and — for a proof — the identity of
+             * the declaration it named. */
+            char *req_code = agent_json_extract_string(m->req, "code");
+            char *req_profile = agent_json_extract_string(m->req, "profile");
+            char *req_task_mode = agent_json_extract_string(m->req, "taskMode");
+            char *req_target = agent_json_extract_string(m->req, "targetDeclaration");
+            char code_sha[65] = {0};
+            if (req_code) ds4_sha256_hex(req_code, strlen(req_code), code_sha);
+            /* A stand-in for the executor's statement fingerprint: stable per
+             * declaration name, so a retry that keeps the name keeps the hash. */
+            char target_sha[65] = {0};
+            if (req_target)
+                ds4_sha256_hex(req_target, strlen(req_target), target_sha);
+            char identity_block[400] = {0};
+            bool proof = req_task_mode && !strcmp(req_task_mode, "proof");
+            if (proof)
+                snprintf(identity_block, sizeof(identity_block),
+                         ",\"taskMode\":\"proof\",\"targetDeclaration\":\"%s\","
+                         "\"targetIdentityAlgorithm\":\"lean-target-statement-v1\","
+                         "\"targetStatementSha256\":\"%s\","
+                         "\"targetIdentityMatched\":%s",
+                         req_target ? req_target : "",
+                         m->echo_target_sha ? m->echo_target_sha : target_sha,
+                         m->echo_target_identity_unmatched ? "false" : "true");
+            else
+                snprintf(identity_block, sizeof(identity_block),
+                         ",\"taskMode\":\"utility\",\"targetDeclaration\":null,"
+                         "\"targetStatementSha256\":null,"
+                         "\"targetIdentityMatched\":null");
+            dyn_body = malloc(2560);
+            if (dyn_body) {
+                /* The flat orchestration* keys are part of every real result
+                 * (finalizeLeanResult writes them); a fixture without them
+                 * would test a shape the server never sends.
+                 *
+                 * The mock answers with the prompt revision it was given and the
+                 * contract revision it was given: "answer for the policy you were
+                 * handed" is the server half of the contract, and hardcoding
+                 * either here would only ever exercise the mismatch path. The
+                 * server's own prompt revision is deliberately different, so the
+                 * non-blocking drift path is what the default fixture covers. */
+                snprintf(dyn_body, 2560,
+                         "{\"contractVersion\":\"lean_result_v1\",\"runId\":\"%s\","
+                         "\"status\":\"%s\",\"isError\":false,\"certified\":false,"
+                         "\"promptRevision\":\"%s\","
+                         "\"policyRevision\":\"%s\","
+                         "\"contractRevision\":\"%s\","
+                         "\"serverPromptRevision\":\"%s\","
+                         "\"promptDriftDetected\":%s,"
+                         "\"promptDriftBlocking\":false,"
+                         "\"profile\":\"%s\","
+                         "\"sourceSha256\":\"%s\"%s,"
+                         "\"orchestrationTerminal\":%s,"
+                         "\"orchestrationVerified\":%s,"
+                         "\"orchestrationRetryable\":%s,"
+                         "\"orchestrationFailureClass\":\"%s\","
+                         "\"orchestrationNextAction\":\"publish_verified_result\","
+                         "\"orchestrationStrategyChangeRequired\":false,"
+                         "\"summary\":\"transport ok\"%s}", rid,
+                         m->echo_status ? m->echo_status : "checked",
+                         rev ? rev : "", rev ? rev : "",
+                         creq ? creq : "",
+                         m->server_prompt_revision[0] ? m->server_prompt_revision : "",
+                         m->server_prompt_revision[0] ? "true" : "false",
+                         m->echo_profile ? m->echo_profile
+                                         : (req_profile ? req_profile : "core"),
+                         m->echo_source_sha ? m->echo_source_sha : code_sha,
+                         identity_block,
+                         m->echo_orch_repairable ? "false" : "true",
+                         /* A utility check is never verified, whatever it says. */
+                         (proof && !m->echo_orch_repairable) ? "true" : "false",
+                         m->echo_orch_repairable ? "true" : "false",
+                         m->echo_orch_repairable ? "lean_error" : "",
+                         m->echo_extra ? m->echo_extra : "");
+                body = dyn_body;
+            }
+            free(req_code);
+            free(req_profile);
+            free(req_task_mode);
+            free(req_target);
+            free(creq);
+            free(rev);
+            free(rid);
+        }
+    }
+    size_t body_len = strlen(body);
+    if (m->mode == AGENT_HTTP_MOCK_PARTIAL_CL) body_len = 4096; /* advertise, send 0 */
+    if (m->mode == AGENT_HTTP_MOCK_TOO_LARGE) body_len = 1u << 20; /* 1 MiB */
+    if (m->mode == AGENT_HTTP_MOCK_NO_BODY) body_len = 0; /* empty body */
+
+    char hdr_out[256];
+    int hn;
+    if (m->mode == AGENT_HTTP_MOCK_NO_CL) {
+        hn = snprintf(hdr_out, sizeof(hdr_out), "%s\r\nContent-Type: application/json\r\nConnection: close\r\n\r\n", status);
+        send(fd, hdr_out, (size_t)hn, MSG_NOSIGNAL);
+        send(fd, body, body_len, MSG_NOSIGNAL);
+    } else {
+        hn = snprintf(hdr_out, sizeof(hdr_out),
+                      "%s\r\nContent-Type: application/json\r\nContent-Length: %zu\r\nConnection: close\r\n\r\n",
+                      status, body_len);
+        send(fd, hdr_out, (size_t)hn, MSG_NOSIGNAL);
+        if (m->mode != AGENT_HTTP_MOCK_PARTIAL_CL &&
+            m->mode != AGENT_HTTP_MOCK_NO_BODY) {
+            size_t sent = 0;
+            while (sent < body_len) {
+                size_t take = body_len - sent;
+                if (take > sizeof(chunk)) take = sizeof(chunk);
+                ssize_t s = send(fd, body + sent, take, MSG_NOSIGNAL);
+                if (s <= 0) break; /* client gone (e.g. size cap) */
+                sent += (size_t)s;
+            }
+        }
+    }
+    free(dyn_body);
+    close(fd);
+    return NULL;
+}
+
+static bool agent_http_mock_start(agent_http_mock *m) {
+    /* The caller must have zeroed the struct and set mode/status_line/body/
+     * delay_ms/echo_run_id BEFORE starting the thread: the mock thread reads
+     * those fields with no synchronization, so no field may be written after
+     * pthread_create. */
+
+    int fd = socket(AF_INET, SOCK_STREAM, 0);
+    if (fd < 0) return false;
+    int one = 1;
+    setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, &one, sizeof(one));
+    struct sockaddr_in addr;
+    memset(&addr, 0, sizeof(addr));
+    addr.sin_family = AF_INET;
+    addr.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+    addr.sin_port = 0;
+    if (bind(fd, (struct sockaddr *)&addr, sizeof(addr)) != 0 ||
+        listen(fd, 4) != 0) {
+        close(fd);
+        return false;
+    }
+    socklen_t alen = sizeof(addr);
+    if (getsockname(fd, (struct sockaddr *)&addr, &alen) != 0) {
+        close(fd);
+        return false;
+    }
+    m->listen_fd = fd;
+    m->port = ntohs(addr.sin_port);
+    if (pthread_create(&m->th, NULL, agent_http_mock_thread, m) != 0) {
+        close(fd);
+        return false;
+    }
+    return true;
+}
+
+static void agent_http_mock_stop(agent_http_mock *m) {
+    if (!m || m->done) return;
+    m->done = true;
+    pthread_join(m->th, NULL);
+    if (m->listen_fd >= 0) close(m->listen_fd);
+    free(m->req);
+}
