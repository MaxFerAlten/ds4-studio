+static int agent_publish_authoritative_text(agent_worker *w, char *text,
+                                            const char *status) {
+    ds4_chat_append_message(w->engine, &w->transcript, "assistant", text);
+    w->current_event_type = 0;
+    agent_publish(w, text, strlen(text));
+    free(text);
+    if (status && status[0]) agent_publish_system_status(w, status);
+    w->authoritative_mode = AGENT_AUTHORITATIVE_COMPLETE;
+    agent_set_status(w, AGENT_WORKER_IDLE);
+    return 0;
+}
