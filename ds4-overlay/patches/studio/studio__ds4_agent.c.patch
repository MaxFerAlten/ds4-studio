+        return out;
+    }
+    size_t head = (size_t)(p - src), b = strlen(extra), tail = strlen(p);
+    char *out = xmalloc(head + b + tail + 1);
+    memcpy(out, src, head); memcpy(out + head, extra, b);
+    memcpy(out + head + b, p, tail + 1);
     return out;
 }
 
