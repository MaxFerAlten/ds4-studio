+/* WP-12 — lean_inspect transport semantics. Inspect is optional discovery, so
+ * a transport failure is retryable once and then asks for a different
+ * discovery strategy; it never creates or terminalizes a proof task. */
+static void test_agent_lean_inspect_transport_retry(void) {
+    agent_worker w;
+    memset(&w, 0, sizeof(w));
+    agent_config cfg = {0};
+    cfg.frontend_port = 1; /* nothing listens: every call is a transport failure */
+    w.cfg = &cfg;
+    agent_lean_turn_reset(&w.lean_turn);
+
+    agent_tool_arg args[1] = {
+        {.name = (char *)"symbols", .value = (char *)"[\"Nat.add_comm\"]",
+         .is_string = true},
+    };
+    agent_tool_call call = {
+        .name = (char *)"lean_inspect", .args = args, .argc = 1};
+
+    /* INSPECT-TRANSPORT-01: the first failure is worth one resend. */
+    char *first = agent_tool_lean_inspect_via_http(&w, &call);
+    AGENT_TEST_ASSERT(first != NULL);
+    AGENT_TEST_ASSERT(first && strstr(first, "LEAN_INSPECT_TRANSPORT_FAILED"));
+    AGENT_TEST_ASSERT(first && strstr(first, "\"retryable\":true"));
+    AGENT_TEST_ASSERT(first && strstr(first, "retry-once"));
+    AGENT_TEST_ASSERT(w.lean_inspect_transport_failures == 1);
+    free(first);
+
+    /* INSPECT-TRANSPORT-02: the second consecutive one is not. */
+    char *second = agent_tool_lean_inspect_via_http(&w, &call);
+    AGENT_TEST_ASSERT(second != NULL);
+    AGENT_TEST_ASSERT(second && strstr(second, "\"retryable\":false"));
+    AGENT_TEST_ASSERT(second && strstr(second, "change-discovery-strategy"));
+    AGENT_TEST_ASSERT(second && strstr(second, "Do not guess"));
+    free(second);
+
+    /* INSPECT-TRANSPORT-04: neither failure creates a proof task. */
+    AGENT_TEST_ASSERT(!w.lean_turn.used);
+    AGENT_TEST_ASSERT(!w.lean_turn.proof_id[0]);
+    AGENT_TEST_ASSERT(w.lean_turn.attempt_count == 0);
+    AGENT_TEST_ASSERT(w.lean_turn.state != AGENT_LEAN_VERIFIED);
+    AGENT_TEST_ASSERT(!agent_lean_turn_is_terminal(&w.lean_turn));
+
+    /* INSPECT-TRANSPORT-03: a route that answers clears the retry state. */
+    {
+        agent_http_mock m = {0};
+        m.mode = AGENT_HTTP_MOCK_OK;
+        m.body =
+            "{\"contractVersion\":\"lean_inspect_result_v1\","
+            "\"status\":\"inspected\","
+            "\"symbols\":[{\"name\":\"Nat.add_comm\","
+            "\"output\":\"Nat.add_comm : forall (n m : Nat), n + m = m + n\","
+            "\"status\":\"ok\"}],"
+            "\"displayText\":\"Nat.add_comm : ok\","
+            "\"timedOut\":false}";
+        AGENT_TEST_ASSERT(agent_http_mock_start(&m));
+        cfg.frontend_port = m.port;
+        char *ok = agent_tool_lean_inspect_via_http(&w, &call);
+        AGENT_TEST_ASSERT(ok != NULL);
+        AGENT_TEST_ASSERT(w.lean_inspect_transport_failures == 0);
+        free(ok);
+        agent_http_mock_stop(&m);
+    }
+    printf("LEAN_INSPECT_TRANSPORT_RETRY=PASS\n");
+}
