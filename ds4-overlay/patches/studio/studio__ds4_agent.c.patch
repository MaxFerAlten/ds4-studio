+/* The prompt/contract split at the tool boundary (fix-revision-lean §21, §30).
+ *
+ * Four cases, and the difference between the first two is the whole point of the
+ * split: a server with newer editorial text must not be able to stop a proof,
+ * and a server implementing different lean_check semantics must not be able to
+ * start one. */
+static void test_agent_lean_prompt_and_contract_revisions(void) {
+    static const char *const code = "theorem t : True := by trivial";
+    agent_tool_arg args[4] = {
+        {.name = (char *)"code", .value = (char *)code, .is_string = true},
+        /* Every proof call names the declaration it is proving (WP-10). */
+        {.name = (char *)"task_mode", .value = (char *)"proof", .is_string = true},
+        {.name = (char *)"target_declaration", .value = (char *)"t",
+         .is_string = true},
+        /* §11.2 — a proof call states its target, so the target is not
+         * read off the candidate that is supposed to prove it. */
+        {.name = (char *)"target_statement",
+         .value = (char *)"theorem t : True", .is_string = true},
+    };
+
+    /* C-REV-09: the server holds a different prompt revision. The check runs, the
+     * result is verified, and the drift is reported as non-blocking. */
+    {
+        agent_http_mock m = {0};
+        m.mode = AGENT_HTTP_MOCK_OK;
+        m.echo_run_id = true;
+        snprintf(m.server_prompt_revision, sizeof(m.server_prompt_revision),
+                 "%040d", 7);
+        AGENT_TEST_ASSERT(agent_http_mock_start(&m));
+
+        agent_worker w;
+        memset(&w, 0, sizeof(w));
+        agent_config cfg = {0};
+        cfg.frontend_port = m.port;
+        w.cfg = &cfg;
+        w.lean_prompt = (char *)"session policy text";
+        agent_lean_turn_reset(&w.lean_turn);
+        ds4_kvstore_sha1_bytes_hex(w.lean_prompt, strlen(w.lean_prompt),
+                                   w.lean_policy_revision);
+        agent_worker_init_lean_contract(&w);
+
+        agent_tool_call call = {.name = (char *)"lean_check", .args = args, .argc = 4};
+        char *out = agent_tool_lean_via_http(&w, &call);
+        AGENT_TEST_ASSERT(out != NULL);
+        AGENT_TEST_ASSERT(out && strstr(out, "LEAN_POLICY_DRIFT"));
+        AGENT_TEST_ASSERT(out && strstr(out, "blocking=false"));
+        AGENT_TEST_ASSERT(out && strstr(out, "action=refresh-policy-when-convenient"));
+        /* The reading the model invented for itself is denied in so many words:
+         * it called two SHA-1s of a prompt a Lean/Mathlib version mismatch. */
+        AGENT_TEST_ASSERT(out && strstr(out,
+            "This is not a Lean or Mathlib toolchain mismatch."));
+        AGENT_TEST_ASSERT(out && !strstr(out, "LEAN_POLICY_REVISION_MISMATCH"));
+        AGENT_TEST_ASSERT(out && strstr(out, "lean_check status=checked"));
+        AGENT_TEST_ASSERT(out && strstr(out, "FINALIZATION_ALLOWED=true"));
+        AGENT_TEST_ASSERT(w.lean_turn.state == AGENT_LEAN_VERIFIED);
+        AGENT_TEST_ASSERT(w.lean_prompt_drift_detected);
+        free(out);
+
+        /* The request carried both revisions, and they are not the same length. */
+        AGENT_TEST_ASSERT(m.req && strstr(m.req, "\"promptRevision\":\""));
+        AGENT_TEST_ASSERT(m.req && strstr(m.req, "\"contractRevision\":\""
+                                                 DS4_LEAN_CONTRACT_REVISION "\""));
+        AGENT_TEST_ASSERT(m.req && strstr(m.req, "\"policyMode\":\"base\""));
+        agent_http_mock_stop(&m);
+    }
+
+    /* C-REV-10: an incompatible contract revision is terminal infrastructure
+     * evidence. status=checked in the same body must not rescue it. */
+    {
+        agent_http_mock m = {0};
+        m.mode = AGENT_HTTP_MOCK_OK;
+        m.body =
+            "{\"contractVersion\":\"lean_result_v1\",\"runId\":\"ignored\","
+            "\"status\":\"checked\",\"isError\":false,\"certified\":false,"
+            "\"promptRevision\":\"0000000000000000000000000000000000000000\","
+            "\"contractRevision\":\"" "d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0"
+            "d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0" "\","
+            "\"orchestrationVerified\":true,\"orchestrationTerminal\":true}";
+        AGENT_TEST_ASSERT(agent_http_mock_start(&m));
+
+        agent_worker w;
+        memset(&w, 0, sizeof(w));
+        agent_config cfg = {0};
+        cfg.frontend_port = m.port;
+        w.cfg = &cfg;
+        w.lean_prompt = (char *)"session policy text";
+        agent_lean_turn_reset(&w.lean_turn);
+        ds4_kvstore_sha1_bytes_hex(w.lean_prompt, strlen(w.lean_prompt),
+                                   w.lean_policy_revision);
+        agent_worker_init_lean_contract(&w);
+
+        agent_tool_call call = {.name = (char *)"lean_check", .args = args, .argc = 4};
+        char *out = agent_tool_lean_via_http(&w, &call);
+        AGENT_TEST_ASSERT(out != NULL);
+        /* runId is checked before the contract, so a body with a foreign runId
+         * stops earlier; either way the result must never be a verified check. */
+        AGENT_TEST_ASSERT(out && !strstr(out, "lean_check status=checked"));
+        AGENT_TEST_ASSERT(out && strstr(out, "\"retryable\":false"));
+        AGENT_TEST_ASSERT(w.lean_turn.state != AGENT_LEAN_VERIFIED);
+        free(out);
+        agent_http_mock_stop(&m);
+    }
+
+    /* C-REV-11: the server answers for a prompt revision this session never
+     * sent. That is a response-integrity failure, not a drift. */
+    {
+        agent_http_mock m = {0};
+        m.mode = AGENT_HTTP_MOCK_OK;
+        AGENT_TEST_ASSERT(agent_http_mock_start(&m));
+
+        agent_worker w;
+        memset(&w, 0, sizeof(w));
+        agent_config cfg = {0};
+        cfg.frontend_port = m.port;
+        w.cfg = &cfg;
+        w.lean_prompt = (char *)"session policy text";
+        agent_lean_turn_reset(&w.lean_turn);
+        ds4_kvstore_sha1_bytes_hex(w.lean_prompt, strlen(w.lean_prompt),
+                                   w.lean_policy_revision);
+        agent_worker_init_lean_contract(&w);
+        AGENT_TEST_ASSERT(agent_lean_turn_ensure_run_id(&w));
+
+        char body[640];
+        snprintf(body, sizeof(body),
+                 "{\"contractVersion\":\"lean_result_v1\",\"runId\":\"%s\","
+                 "\"status\":\"checked\",\"isError\":false,\"certified\":false,"
+                 "\"promptRevision\":\"%040d\","
+                 "\"contractRevision\":\"" DS4_LEAN_CONTRACT_REVISION "\","
+                 "\"orchestrationVerified\":true}",
+                 w.lean_turn.run_id, 3);
+        m.body = body;
+        w.lean_turn.run_id[0] = '\0';   /* the tool mints its own id per attempt */
+
+        agent_tool_call call = {.name = (char *)"lean_check", .args = args, .argc = 4};
+        char *out = agent_tool_lean_via_http(&w, &call);
+        AGENT_TEST_ASSERT(out != NULL);
+        AGENT_TEST_ASSERT(out && !strstr(out, "lean_check status=checked"));
+        AGENT_TEST_ASSERT(w.lean_turn.state != AGENT_LEAN_VERIFIED);
+        free(out);
+        agent_http_mock_stop(&m);
+    }
+
+    /* C-REV-12: a build whose contract descriptor never reached the worker must
+     * fail before opening a socket. Nothing listens on port 1, so a request
+     * would surface as a transport error instead of the local contract error. */
+    {
+        agent_worker w;
+        memset(&w, 0, sizeof(w));
+        agent_config cfg = {0};
+        cfg.frontend_port = 1;
+        w.cfg = &cfg;
+        w.lean_prompt = (char *)"session policy text";
+        agent_lean_turn_reset(&w.lean_turn);
+        ds4_kvstore_sha1_bytes_hex(w.lean_prompt, strlen(w.lean_prompt),
+                                   w.lean_policy_revision);
+        AGENT_TEST_ASSERT(!agent_worker_lean_contract_coherent(&w));
+
+        agent_tool_call call = {.name = (char *)"lean_check", .args = args, .argc = 4};
+        char *out = agent_tool_lean_via_http(&w, &call);
+        AGENT_TEST_ASSERT(out != NULL);
+        AGENT_TEST_ASSERT(out &&
+                          strstr(out, "LEAN_CONTRACT_REVISION_LOCAL_INVALID"));
+        AGENT_TEST_ASSERT(out && !strstr(out, "LEAN_HTTP_TRANSPORT_FAILED"));
+        AGENT_TEST_ASSERT(out && strstr(out, "operator-code-fix"));
+        free(out);
+
+        /* A stale one is refused for the same reason as an absent one. */
+        agent_worker_init_lean_contract(&w);
+        w.lean_contract_revision[0] = 'z';
+        AGENT_TEST_ASSERT(!agent_worker_lean_contract_coherent(&w));
+    }
+}
