+/* WP-10: the native client does not parse Lean statements. Identity is the
+ * (declaration, statement digest) pair the Node executor computes and reports;
+ * this side only validates shapes and enforces immutability of the lock. */
+
+/* Same syntactic domain as expectedDeclarations: a bare name, no whitespace,
+ * no semicolons, no fragments of code. */
+static bool agent_lean_valid_declaration_name(const char *s) {
+    if (!s || !s[0]) return false;
+    size_t n = strlen(s);
+    if (n >= 128) return false;
+    if (!(isalpha((unsigned char)s[0]) || s[0] == '_')) return false;
+    for (size_t i = 1; i < n; i++) {
+        unsigned char c = (unsigned char)s[i];
+        if (!(isalnum(c) || c == '_' || c == '.' || c == '\'')) return false;
     }
     return true;
+}
+
+static bool agent_lean_hash64_valid(const char *s) {
+    if (!s) return false;
+    size_t n = strlen(s);
+    if (n != 64) return false;
+    for (size_t i = 0; i < n; i++) {
+        if (!isxdigit((unsigned char)s[i])) return false;
+        if (isalpha((unsigned char)s[i]) && !islower((unsigned char)s[i]))
+            return false;
+    }
+    return true;
+}
+
+/* Lock the proof task's target. Never overwrites an existing lock: a second
+ * proof call naming another declaration is refused, not adopted. */
+static bool agent_lean_turn_lock_target(agent_lean_turn_state *s,
+                                        const char *target_declaration,
+                                        const char *target_statement_sha256,
+                                        const char *algorithm,
+                                        char *err, size_t err_len) {
+    if (!s) { if (err && err_len) snprintf(err, err_len, "no lean turn state"); return false; }
+    if (!agent_lean_valid_declaration_name(target_declaration)) {
+        if (err && err_len)
+            snprintf(err, err_len, "LEAN_TARGET_DECLARATION_INVALID");
+        return false;
+    }
+    /* First useful response: take the lock. */
+    if (!s->target_identity_locked && !s->target_declaration[0]) {
+        snprintf(s->target_declaration, sizeof(s->target_declaration), "%s",
+                 target_declaration);
+        if (agent_lean_hash64_valid(target_statement_sha256)) {
+            snprintf(s->target_statement_sha256,
+                     sizeof(s->target_statement_sha256), "%s",
+                     target_statement_sha256);
+            snprintf(s->target_identity_algorithm,
+                     sizeof(s->target_identity_algorithm), "%s",
+                     algorithm && algorithm[0] ? algorithm : "lean-target-statement-v1");
+            s->target_identity_locked = true;
+        } else {
+            /* Name-only provisional lock: the digest arrives with the first
+             * proof response that carries one (§13.6). */
+            s->target_identity_locked = false;
+        }
+        return true;
+    }
+
+    /* Already locked on a name: it must match exactly. */
+    if (strcmp(target_declaration, s->target_declaration)) {
+        if (err && err_len) snprintf(err, err_len, "LEAN_TARGET_DECLARATION_MISMATCH");
+        return false;
+    }
+    if (agent_lean_hash64_valid(target_statement_sha256)) {
+        if (!s->target_statement_sha256[0]) {
+            /* Provisional name lock upgrades to full identity lock. */
+            snprintf(s->target_statement_sha256,
+                     sizeof(s->target_statement_sha256), "%s",
+                     target_statement_sha256);
+            snprintf(s->target_identity_algorithm,
+                     sizeof(s->target_identity_algorithm), "%s",
+                     algorithm && algorithm[0] ? algorithm : "lean-target-statement-v1");
+            s->target_identity_locked = true;
+            return true;
+        }
+        if (strcmp(target_statement_sha256, s->target_statement_sha256)) {
+            if (err && err_len) snprintf(err, err_len, "LEAN_TARGET_STATEMENT_MISMATCH");
+            return false;
+        }
+        if (algorithm && algorithm[0] && s->target_identity_algorithm[0] &&
+            strcmp(algorithm, s->target_identity_algorithm)) {
+            if (err && err_len)
+                snprintf(err, err_len, "LEAN_TARGET_IDENTITY_ALGORITHM_MISMATCH");
+            return false;
+        }
+    }
+    return true;
+}
