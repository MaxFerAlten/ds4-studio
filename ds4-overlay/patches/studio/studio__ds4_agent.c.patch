+static void test_agent_lean_bridge_real(void) {
+    const char *port_s = getenv("DS4_TEST_LEAN_BRIDGE_PORT");
+    if (!port_s || !port_s[0]) return;
+
+    int port = atoi(port_s);
+    AGENT_TEST_ASSERT(port > 0);
+    const char *revision = getenv("DS4_TEST_LEAN_POLICY_REVISION");
+    AGENT_TEST_ASSERT(revision != NULL && strlen(revision) == 40);
+    if (!revision || strlen(revision) != 40) return;
+
+    agent_worker w;
+    agent_config cfg = {0};
+    cfg.frontend_port = port;
+
+    /* The run id the runtime builds is lean-<first 12 chars of the session
+     * sha>-<sequence>-<nonce>, and the server's sanitizer only accepts 12 hex
+     * characters there. Production session ids are SHAs; the harness ones must
+     * be too, or every request is rejected before it reaches the executor. */
+    #define BRIDGE_SESSION_DEFAULT "aaaaaaaaaaaa0000000000000000000000000007"
+    #define BRIDGE_SESSION_LONG    "bbbbbbbbbbbb0000000000000000000000000008"
+    #define BRIDGE_SESSION_STALE   "cccccccccccc0000000000000000000000000009"
+    #define BRIDGE_SESSION_TIMEOUT "dddddddddddd0000000000000000000000000010"
+
+    /* One worker per case: the turn budget is per turn, and each case is a
+     * separate turn from the runtime's point of view. */
+    /* Load the policy through the production path, so the session state under
+     * test is the one /lean start produces: prompt from disk, revision derived
+     * from its content, coherence verified by the same predicate the
+     * dispatcher uses (piano-rimedio 2). */
+    #define BRIDGE_WORKER_INIT(session_id)                                        \
+        do {                                                                      \
+            memset(&w, 0, sizeof(w));                                             \
+            w.cfg = &cfg;                                                         \
+            agent_lean_turn_reset(&w.lean_turn);                                  \
+            char load_err[256] = {0};                                             \
+            AGENT_TEST_ASSERT(agent_worker_load_lean_policy(                       \
+                &w, false, load_err, sizeof(load_err)));                           \
+            AGENT_TEST_ASSERT(agent_worker_lean_policy_coherent(&w));              \
+            AGENT_TEST_ASSERT(!strcmp(w.lean_policy_revision, revision));          \
+            snprintf(w.session_sha, sizeof(w.session_sha), "%s", session_id);     \
+        } while (0)
+
+    /* E2E-07: the model omits timeout_sec. The old shared parser shipped 3600,
+     * which the server rejects with LEAN_TIMEOUT_INVALID; the contract default
+     * is 30. */
+    BRIDGE_WORKER_INIT(BRIDGE_SESSION_DEFAULT);
+    {
+        agent_tool_arg args[4] = {
+            {.name = (char *)"code",
+             .value = (char *)"theorem bridge_default : 1 + 1 = 2 := by decide",
+             .is_string = true},
+            /* Every proof call names the declaration it is proving (WP-10). */
+            {.name = (char *)"task_mode", .value = (char *)"proof", .is_string = true},
+            {.name = (char *)"target_declaration", .value = (char *)"bridge_default",
+             .is_string = true},
+            /* §11.2 — a proof call states its target, so the target is not
+             * read off the candidate that is supposed to prove it. */
+            {.name = (char *)"target_statement",
+             .value = (char *)"theorem bridge_default : 1 + 1 = 2", .is_string = true},
+        };
+        agent_tool_call call = {.name = (char *)"lean_check", .args = args, .argc = 4};
+        char *out = agent_tool_lean_via_http(&w, &call);
+        if (getenv("DS4_TEST_LEAN_BRIDGE_DEBUG"))
+            fprintf(stderr, "[bridge debug] %s\n", out ? out : "(null)");
+        AGENT_TEST_ASSERT(out != NULL);
+        AGENT_TEST_ASSERT(out && strstr(out, "lean_check status=checked"));
+        AGENT_TEST_ASSERT(out && !strstr(out, "LEAN_TIMEOUT_INVALID"));
+        AGENT_TEST_ASSERT(out && strstr(out, "\"timedOut\":false"));
+        AGENT_TEST_ASSERT(w.lean_turn.state == AGENT_LEAN_VERIFIED);
+        AGENT_TEST_ASSERT(out && strstr(out, "FINALIZATION_ALLOWED=true"));
+        free(out);
+    }
+
+    /* E2E-08: a legitimate run longer than 30s must not be cut by the client.
+     * The old transport hardcoded `curl --max-time 30` regardless of the
+     * request's own timeout. */
+    BRIDGE_WORKER_INIT(BRIDGE_SESSION_LONG);
+    {
+        agent_tool_arg args[5] = {
+            {.name = (char *)"code",
+             .value = (char *)"#eval (IO.sleep 35000 : BaseIO Unit)\n"
+                              "theorem bridge_slow : True := trivial\n",
+             .is_string = true},
+            {.name = (char *)"timeout_sec", .value = (char *)"60", .is_string = false},
+            /* Every proof call names the declaration it is proving (WP-10). */
+            {.name = (char *)"task_mode", .value = (char *)"proof", .is_string = true},
+            {.name = (char *)"target_declaration", .value = (char *)"bridge_slow",
+             .is_string = true},
+            /* §11.2 — a proof call states its target, so the target is not
+             * read off the candidate that is supposed to prove it. */
+            {.name = (char *)"target_statement",
+             .value = (char *)"theorem bridge_slow : True", .is_string = true},
+        };
+        agent_tool_call call = {.name = (char *)"lean_check", .args = args, .argc = 5};
+        time_t started = time(NULL);
+        char *out = agent_tool_lean_via_http(&w, &call);
+        double elapsed = difftime(time(NULL), started);
+        AGENT_TEST_ASSERT(out != NULL);
+        AGENT_TEST_ASSERT(out && !strstr(out, "LEAN_HTTP_TRANSPORT_FAILED"));
+        AGENT_TEST_ASSERT(out && strstr(out, "lean_check status=checked"));
+        AGENT_TEST_ASSERT(elapsed > 30.0); /* it really did outlive the old cap */
+        free(out);
+    }
+
+    /* E2E-09: a stale policy revision must surface as a mismatch, never as a
+     * successful check. */
+    BRIDGE_WORKER_INIT(BRIDGE_SESSION_STALE);
+    memset(w.lean_policy_revision, 'b', 40);
+    w.lean_policy_revision[40] = '\0';
+    {
+        agent_tool_arg args[4] = {
+            {.name = (char *)"code",
+             .value = (char *)"theorem bridge_stale : True := trivial",
+             .is_string = true},
+            /* Every proof call names the declaration it is proving (WP-10). */
+            {.name = (char *)"task_mode", .value = (char *)"proof", .is_string = true},
+            {.name = (char *)"target_declaration", .value = (char *)"bridge_stale",
+             .is_string = true},
+            /* §11.2 — a proof call states its target, so the target is not
+             * read off the candidate that is supposed to prove it. */
+            {.name = (char *)"target_statement",
+             .value = (char *)"theorem bridge_stale : True", .is_string = true},
+        };
+        agent_tool_call call = {.name = (char *)"lean_check", .args = args, .argc = 4};
+        char *out = agent_tool_lean_via_http(&w, &call);
+        if (getenv("DS4_TEST_LEAN_BRIDGE_DEBUG"))
+            fprintf(stderr, "[bridge debug] %s\n", out ? out : "(null)");
+        AGENT_TEST_ASSERT(out != NULL);
+        AGENT_TEST_ASSERT(out && !strstr(out, "lean_check status=checked"));
+        AGENT_TEST_ASSERT(out && strstr(out, "LEAN_POLICY_REVISION_MISMATCH"));
+        free(out);
+    }
+
+    /* LF000-032: a Lean run that really does exhaust its timeout must come back
+     * through the whole bridge as a timeout *result*, not as a dead transport.
+     * Only /api/lean/exec was ever certified for this; doc6's leading hypothesis
+     * was that the result stopped somewhere between the server and the C client,
+     * and nothing on this path proved otherwise. */
+    BRIDGE_WORKER_INIT(BRIDGE_SESSION_TIMEOUT);
+    {
+        agent_tool_arg args[5] = {
+            {.name = (char *)"code",
+             .value = (char *)"#eval (IO.sleep 30000 : BaseIO Unit)\n"
+                              "theorem bridge_timeout : True := trivial\n",
+             .is_string = true},
+            {.name = (char *)"timeout_sec", .value = (char *)"5", .is_string = false},
+            /* Every proof call names the declaration it is proving (WP-10). */
+            {.name = (char *)"task_mode", .value = (char *)"proof", .is_string = true},
+            {.name = (char *)"target_declaration", .value = (char *)"bridge_timeout",
+             .is_string = true},
+            /* §11.2 — a proof call states its target, so the target is not
+             * read off the candidate that is supposed to prove it. */
+            {.name = (char *)"target_statement",
+             .value = (char *)"theorem bridge_timeout : True", .is_string = true},
+        };
+        agent_tool_call call = {.name = (char *)"lean_check", .args = args, .argc = 5};
+        time_t started = time(NULL);
+        char *out = agent_tool_lean_via_http(&w, &call);
+        double elapsed = difftime(time(NULL), started);
+        if (getenv("DS4_TEST_LEAN_BRIDGE_DEBUG"))
+            fprintf(stderr, "[bridge debug] %s\n", out ? out : "(null)");
+        AGENT_TEST_ASSERT(out != NULL);
+        /* The distinction the whole case exists for: a delivered timeout result
+         * versus the client giving up on the connection. */
+        AGENT_TEST_ASSERT(out && !strstr(out, "LEAN_HTTP_TRANSPORT_FAILED"));
+        AGENT_TEST_ASSERT(out && strstr(out, "lean_check status=timeout"));
+        AGENT_TEST_ASSERT(out && strstr(out, "\"timedOut\":true"));
+        AGENT_TEST_ASSERT(out && !strstr(out, "lean_check status=checked"));
+        /* A timeout is repairable, so the turn owes another attempt rather than
+         * ending — and it must never read as a proof. */
+        AGENT_TEST_ASSERT(w.lean_turn.state == AGENT_LEAN_REPAIR_REQUIRED);
+        AGENT_TEST_ASSERT(!w.lean_turn.checked);
+        AGENT_TEST_ASSERT(!strcmp(w.lean_turn.failure_class, "timeout_repairable"));
+        AGENT_TEST_ASSERT(out && strstr(out, "FINALIZATION_ALLOWED=false"));
+        /* It really waited for the server's bound instead of tripping its own. */
+        AGENT_TEST_ASSERT(elapsed >= 4.0);
+        AGENT_TEST_ASSERT(elapsed < 5.0 + (AGENT_LEAN_HTTP_TIMEOUT_MARGIN_MS / 1000.0));
+        free(out);
+    }
+
+    #undef BRIDGE_WORKER_INIT
+    #undef BRIDGE_SESSION_DEFAULT
+    #undef BRIDGE_SESSION_LONG
+    #undef BRIDGE_SESSION_STALE
+    #undef BRIDGE_SESSION_TIMEOUT
+
+    printf("lean bridge real: ok\n");
+}
