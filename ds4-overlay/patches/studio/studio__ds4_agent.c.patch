+/* R11 E2E-07/08/09 — the native bridge against the *real* Node server.
+ *
+ * Driven by tests/test_lean_native_bridge_real.sh, which boots the server and
+ * exports the port plus the live policy revision. Without those the test is a
+ * no-op: the harness, not this file, decides when a live server exists, and
+ * the shell script fails if the marker below is missing from the output. */
+static void test_agent_lean_tool_error_classification(void) {
+    /* Every failure the model can see must say whether retrying can help and
+     * what the one supported action is (§14.2). A generic "Tool error" taught
+     * it to guess: sudo, ds4-admin, a Lean daemon. */
+    struct { const char *code; bool retryable; const char *category; } expect[] = {
+        { "LEAN_CODE_REQUIRED", false, "contract" },
+        { "LEAN_SOURCE_TOO_LARGE", false, "contract" },
+        { "LEAN_TIMEOUT_INVALID", false, "contract" },
+        { "LEAN_HTTP_TRANSPORT_FAILED", true, "transport" },
+        { "LEAN_RUNTIME_UNAVAILABLE", false, "runtime" },
+        { "LEAN_PROMPT_REVISION_ECHO_MISMATCH", false, "state-coherence" },
+        { "LEAN_CONTRACT_REVISION_MISMATCH_SERVER", false, "infrastructure" },
+        { "LEAN_CONTRACT_REVISION_LOCAL_INVALID", false, "contract" },
+        { NULL, false, NULL }
+    };
+    for (int i = 0; expect[i].code; i++) {
+        char *out = agent_lean_tool_error(false, expect[i].code,
+                                          expect[i].category, expect[i].retryable,
+                                          "operator-code-fix", "detail");
+        AGENT_TEST_ASSERT(out != NULL);
+        if (!out) continue;
+        AGENT_TEST_ASSERT(strstr(out, expect[i].code) != NULL);
+        AGENT_TEST_ASSERT(strstr(out, expect[i].category) != NULL);
+        AGENT_TEST_ASSERT(strstr(out, expect[i].retryable ? "\"retryable\":true"
+                                                         : "\"retryable\":false") != NULL);
+        AGENT_TEST_ASSERT(strstr(out, "\"suggestedAction\"") != NULL);
+        free(out);
+    }
+
+    /* Budget exhaustion is FINAL: the loop must not treat it as a retry. */
+    char *final_err = agent_lean_tool_error(true, "LEAN_CALL_LIMIT_REACHED",
+                                            "budget", false,
+                                            "use-existing-results", "budget spent");
+    AGENT_TEST_ASSERT(final_err && !strncmp(final_err, "FINAL:", 6));
+    AGENT_TEST_ASSERT(final_err && strstr(final_err, "\"retryable\":false"));
+    free(final_err);
+
+    /* The local policy states keep their own codes and stay non-retryable. */
+    agent_worker w;
+    memset(&w, 0, sizeof(w));
+    char *not_loaded = agent_lean_policy_incoherent_error(&w);
+    AGENT_TEST_ASSERT(not_loaded && strstr(not_loaded, "LEAN_POLICY_NOT_LOADED"));
+    AGENT_TEST_ASSERT(not_loaded && strstr(not_loaded, "\"retryable\":false"));
+    free(not_loaded);
+
+    w.lean_prompt = (char *)"policy text";
+    char *missing = agent_lean_policy_incoherent_error(&w);
+    AGENT_TEST_ASSERT(missing && strstr(missing, "LEAN_POLICY_REVISION_MISSING"));
+    free(missing);
+
+    memcpy(w.lean_policy_revision,
+           "0123456789abcdef0123456789abcdef01234567", 41);
+    char *stale = agent_lean_policy_incoherent_error(&w);
+    AGENT_TEST_ASSERT(stale &&
+                      strstr(stale, "LEAN_POLICY_REVISION_MISMATCH_LOCAL"));
+    free(stale);
+}
