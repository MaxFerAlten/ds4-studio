+
 /* Run one user turn until the assistant stops or returns a tool call.  Tool
  * results are appended to the transcript and the loop continues, which gives
  * the model native DSML tool iteration without a client/server protocol. */
+/* ---------------------------------------------------------------------------
+ * Authoritative task mode
+ * ------------------------------------------------------------------------- */
+
+static const char *agent_authoritative_mode_name(agent_authoritative_mode m) {
+    switch (m) {
+    case AGENT_AUTHORITATIVE_LEAN_ACTIVE:              return "lean_active";
+    case AGENT_AUTHORITATIVE_LEAN_FINALIZATION_ONLY:   return "lean_finalization_only";
+    case AGENT_AUTHORITATIVE_SAGE_ACTIVE:              return "sage_active";
+    case AGENT_AUTHORITATIVE_SAGE_FINALIZATION_ONLY:   return "sage_finalization_only";
+    case AGENT_AUTHORITATIVE_CONFLICT:                 return "conflict";
+    case AGENT_AUTHORITATIVE_COMPLETE:                 return "complete";
+    case AGENT_AUTHORITATIVE_NONE:
+    default:                                           return "none";
+    }
+}
+
+/* The mode is derived from the domain trackers, never set by the model.  It is
+ * recomputed after every tool round; CONFLICT and COMPLETE are latched, because
+ * a task that has already been answered cannot become open again inside the
+ * same turn. */
+static void agent_refresh_authoritative_mode(agent_worker *w) {
+    if (!w) return;
+    if (w->authoritative_mode == AGENT_AUTHORITATIVE_COMPLETE ||
+        w->authoritative_mode == AGENT_AUTHORITATIVE_CONFLICT)
+        return;
+
+    bool lean_used = w->lean_turn.used &&
+                     agent_lean_autonomous_orchestration_enabled();
+    bool sage_used = w->sage_turn.used;
+
+    if (lean_used && sage_used) {
+        w->authoritative_mode = AGENT_AUTHORITATIVE_CONFLICT;
+        return;
+    }
+    if (lean_used) {
+        w->authoritative_mode = agent_lean_turn_is_terminal(&w->lean_turn) ?
+            AGENT_AUTHORITATIVE_LEAN_FINALIZATION_ONLY :
+            AGENT_AUTHORITATIVE_LEAN_ACTIVE;
+        return;
+    }
+    if (sage_used) {
+        w->authoritative_mode = agent_sage_turn_is_terminal(&w->sage_turn) ?
+            AGENT_AUTHORITATIVE_SAGE_FINALIZATION_ONLY :
+            AGENT_AUTHORITATIVE_SAGE_ACTIVE;
+        return;
+    }
+    w->authoritative_mode = AGENT_AUTHORITATIVE_NONE;
+}
+
+/* This is the gate that makes "Lean budget exhausted, therefore crawl"
+ * impossible.  It is deliberately tool-agnostic: the observed transcript failed
+ * because the block was written per-tool and the model simply reached for a
+ * different one. */
+static bool agent_authoritative_tool_call_forbidden(const agent_worker *w) {
+    if (!w) return false;
+    switch (w->authoritative_mode) {
+    case AGENT_AUTHORITATIVE_LEAN_FINALIZATION_ONLY:
+    case AGENT_AUTHORITATIVE_SAGE_FINALIZATION_ONLY:
+    case AGENT_AUTHORITATIVE_CONFLICT:
+    case AGENT_AUTHORITATIVE_COMPLETE:
+        return true;
+    case AGENT_AUTHORITATIVE_NONE:
+    case AGENT_AUTHORITATIVE_LEAN_ACTIVE:
+    case AGENT_AUTHORITATIVE_SAGE_ACTIVE:
+    default:
+        return false;
+    }
+}
