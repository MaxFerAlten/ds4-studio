+/* ---------------------------------------------------------------------------
+ * lean_check transport
+ *
+ * The C side stays thin on purpose: it owns the policy, the per-turn budget and
+ * the contract check, and nothing else. Every decision about sandboxing, Lake,
+ * temporary files and diagnostics lives in the Node executor.
+ * ------------------------------------------------------------------------- */
+/* The tool-role message injected when the model tried to answer while a
+ * repairable Lean failure was outstanding.  It replaces the discarded prose, so
+ * it must say exactly what to do rather than merely refuse. */
+/* Canonical continuation block injected in place of the discarded prose.
+ * It states the phase and the action; it never asks the user for anything. */
+static char *agent_sage_continuation_guidance(const agent_sage_turn_state *s) {
+    agent_buf b = {0};
+    char line[640];
+    snprintf(line, sizeof(line),
+             "SAGE_ORCHESTRATION\nstate=%s\ncandidateRevision=%d\nnextPhase=%s\n"
+             "retryable=%s\n",
+             agent_sage_state_name(s->state), agent_sage_turn_attempt(s),
+             s->next_phase[0] ? s->next_phase : "validate",
+             s->terminal ? "false" : "true");
+    agent_buf_puts(&b, line);
+    if (s->failure_class[0]) {
+        snprintf(line, sizeof(line), "failureClass=%s\n", s->failure_class);
+        agent_buf_puts(&b, line);
+    }
+    if (s->strategy_change_required) {
+        agent_buf_puts(&b, "strategyChangeRequired=true\n");
+    }
+    if (s->next_action[0]) {
+        snprintf(line, sizeof(line), "nextAction=%s\n", s->next_action);
+        agent_buf_puts(&b, line);
+    }
+    agent_buf_puts(&b,
+        "FINALIZATION_ALLOWED=false\n"
+        "Continue the Sage workflow now with the phase above. Do not answer in "
+        "plain text and do not ask the user to send another message.\n");
+    return agent_buf_take(&b);
+}
+
+/* Terminal notice: what to publish when no mathematics may be published. */
+static char *agent_sage_terminal_notice(const agent_sage_turn_state *s) {
+    agent_buf b = {0};
+    char line[640];
+    snprintf(line, sizeof(line),
+             "SAGE_TERMINAL_NOT_PUBLISHABLE\nstate=%s\nreason=%s\n"
+             "candidateRevision=%d\n",
+             agent_sage_state_name(s->state),
+             s->failure_code[0] ? s->failure_code : "SAGE_NOT_PUBLISHABLE",
+             agent_sage_turn_attempt(s));
+    agent_buf_puts(&b, line);
+    agent_buf_puts(&b,
+        "Publish NOT_PUBLISHABLE quoting this reason. Do not present the "
+        "candidate mathematics as a validated result.\n");
+    return agent_buf_take(&b);
+}
+
+static char *agent_lean_continuation_guidance(const agent_lean_turn_state *s) {
+    agent_buf b = {0};
+    char head[512];
+    snprintf(head, sizeof(head),
+             "LEAN_FINALIZATION_BLOCKED\n"
+             "state=%s attempt=%d/%d failureClass=%s\n"
+             "The last lean_check did not return status=checked, so no proof may "
+             "be claimed and the answer was discarded.\n",
+             agent_lean_state_name(s->state), s->attempt_count, s->max_attempts,
+             s->failure_class[0] ? s->failure_class : "unknown");
+    agent_buf_puts(&b, head);
+
+    if (s->next_action[0]) {
+        agent_buf_puts(&b, "nextAction=");
+        agent_buf_puts(&b, s->next_action);
+        agent_buf_puts(&b, "\n");
+    }
+    if (s->premature_finalization_count >= 2)
+        agent_buf_puts(&b,
+            "Do not restate the previous candidate and do not ask the user to "
+            "continue: emit the corrected Lean source in a lean_check call now.\n");
+    if (s->state == AGENT_LEAN_STRATEGY_CHANGE_REQUIRED)
+        agent_buf_puts(&b,
+            "The same failure has repeated: change proof strategy instead of "
+            "retrying the same tactic.\n");
+    agent_buf_puts(&b, "Call lean_check again in this same turn.\n");
+    return agent_buf_take(&b);
+}
+
+/* The terminal reminder for a proof that ended without verification. */
+static char *agent_lean_terminal_notice(const agent_lean_turn_state *s) {
+    agent_buf b = {0};
+    char msg[512];
+    snprintf(msg, sizeof(msg),
+             "LEAN_TERMINAL_NOT_VERIFIED\n"
+             "state=%s reason=%s attempt=%d/%d\n"
+             "Do not claim the theorem was verified. Answer with STATO: "
+             "NOT_VERIFIED and the exact reason code above.\n",
+             agent_lean_state_name(s->state),
+             s->failure_code[0] ? s->failure_code : "UNKNOWN",
+             s->attempt_count, s->max_attempts);
+    agent_buf_puts(&b, msg);
+    return agent_buf_take(&b);
+}
+
+/* lean_inspect: discover Lean symbol signatures without consuming proof attempts.
+ * Does NOT touch LeanTurnTracker, does NOT set verified, does NOT increment
+ * attempt_count. Budget: max 4 inspect per user turn, 30s each. */
+#define AGENT_LEAN_INSPECT_MAX_PER_TASK 4
+#define AGENT_LEAN_INSPECT_TIMEOUT_SEC 30
+#define AGENT_LEAN_INSPECT_MAX_TIMEOUT_SEC 120
+
+static char *agent_tool_lean_inspect_via_http(agent_worker *w,
+                                              const agent_tool_call *call) {
+    /* Validate symbols array */
+    const char *symbols_json = agent_tool_arg_value(call, "symbols");
+    if (!symbols_json || !symbols_json[0])
+        return agent_lean_tool_error(false, "LEAN_INSPECT_SYMBOLS_REQUIRED",
+                                     "contract", false, "fix-arguments",
+                                     "lean_inspect requires a non-empty symbols array");
+
+    /* Budget check */
+    if (w->lean_inspect_calls >= AGENT_LEAN_INSPECT_MAX_PER_TASK) {
+        char detail[128];
+        snprintf(detail, sizeof(detail),
+                 "lean_inspect budget exhausted (%d/%d calls this turn)",
+                 w->lean_inspect_calls, AGENT_LEAN_INSPECT_MAX_PER_TASK);
+        return agent_lean_tool_error(false, "LEAN_INSPECT_BUDGET_EXHAUSTED",
+                                     "budget", false, "publish-not-verified", detail);
+    }
+
+    /* Parse profile */
+    const char *profile = agent_tool_arg_value(call, "profile");
+    if (profile && strcmp(profile, "core") && strcmp(profile, "mathlib"))
+        profile = NULL;
+
+    /* Parse timeout — default matches the server constant. */
+    int timeout = AGENT_LEAN_INSPECT_TIMEOUT_SEC;
+    const char *timeout_str = agent_tool_arg_value(call, "timeout_sec");
+    if (timeout_str && timeout_str[0]) {
+        int t = atoi(timeout_str);
+        if (t >= 1 && t <= AGENT_LEAN_INSPECT_MAX_TIMEOUT_SEC)
+            timeout = t;
+    }
+
+    w->lean_inspect_calls++;
+
+    /* Build request body for POST /api/lean/inspect */
+    agent_buf body = {0};
+    agent_buf_puts(&body, "{\"symbols\":");
+    agent_buf_puts(&body, symbols_json);
+
+    const char *imports = agent_tool_arg_value(call, "imports");
+    if (imports && imports[0]) {
+        agent_buf_puts(&body, ",\"imports\":");
+        agent_buf_puts(&body, imports);
+    }
+    if (profile) {
+        char profile_block[64];
+        snprintf(profile_block, sizeof(profile_block), ",\"profile\":\"%s\"", profile);
+        agent_buf_puts(&body, profile_block);
+    }
+    {
+        char timeout_block[64];
+        snprintf(timeout_block, sizeof(timeout_block), ",\"timeout_sec\":%d", timeout);
+        agent_buf_puts(&body, timeout_block);
+    }
+    agent_buf_puts(&body, "}");
+
+    char *body_str = agent_buf_take(&body);
+
+    /* HTTP POST to /api/lean/inspect */
+    agent_http_response http = {0};
+    int client_timeout_ms = timeout * 1000 + 5000;
+    bool transport_ok = agent_http_post_json(
+        w->cfg->frontend_port, "/api/lean/inspect", body_str, strlen(body_str),
+        client_timeout_ms, AGENT_LEAN_MAX_RESPONSE_BYTES, &http);
+    free(body_str);
+
+    if (!transport_ok) {
+        /* The first transport failure of the turn is worth resending; a second
+         * consecutive one means the discovery route is down, not the request.
+         * Since inspect is optional (WP-09), neither creates a proof terminal:
+         * the model changes discovery strategy or proves without it. */
+        w->lean_inspect_transport_failures++;
+        bool first = w->lean_inspect_transport_failures <= 1;
+        return agent_lean_tool_error(
+            false, "LEAN_INSPECT_TRANSPORT_FAILED", "transport", first,
+            first ? "retry-once" : "change-discovery-strategy",
+            first ? "the Lean backend did not answer; resend this inspect once"
+                  : "the Lean backend did not answer twice in a row. Do not "
+                    "guess the failed symbol signature: choose a proof strategy "
+                    "that does not depend on that uncertain API, or let "
+                    "lean_check diagnose the concrete candidate");
+    }
+
+    char *response = http.body;
+    http.body = NULL;
+    /* The route answered: whatever it says, the transport is up again. */
+    w->lean_inspect_transport_failures = 0;
+
+    /* Validate response — lean_inspect returns a different contract than
+     * lean_check: { status, profile, symbols, source_sha256, ... } */
+    char *status = agent_json_extract_string(response, "status");
+    if (!status || !status[0]) {
+        free(status);
+        free(response);
+        return agent_lean_tool_error(false, "LEAN_INSPECT_INVALID_RESPONSE",
+                                     "contract", false, "operator-code-fix",
+                                     "lean_inspect returned no status");
+    }
+
+    /* WP02.1 — contractVersion validation: reject unsupported contract
+     * versions. The canonical inspect contract is lean_inspect_result_v1. */
+    char *contract_ver = agent_json_extract_string(response, "contractVersion");
+    if (!contract_ver || strcmp(contract_ver, "lean_inspect_result_v1")) {
+        free(status);
+        free(contract_ver);
+        free(response);
+        return agent_lean_tool_error(false, "LEAN_INSPECT_CONTRACT_UNSUPPORTED",
+                                     "contract", false, "operator-code-fix",
+                                     "lean_inspect returned an unsupported contract version");
+    }
+    free(contract_ver);
+
+    /* Must not verify or consume attempts — inspect never does this, but
+     * defence in depth. */
+    bool verified = agent_json_extract_bool(response, "verified");
+    bool attempt_consumed = agent_json_extract_bool(response, "attemptConsumed");
+    if (verified || attempt_consumed) {
+        free(status);
+        free(response);
+        return agent_lean_tool_error(false, "LEAN_INSPECT_INVARIANT_VIOLATION",
+                                     "internal", false, "operator-code-fix",
+                                     "lean_inspect must not verify or consume attempts");
+    }
+
+    /* Render compact observation — contract fields: status, errorCode,
+     * displayText (WP01.3). The displayText field is a flat multi-line
+     * string the C parser can read without JSON array parsing. */
+    char *error_code = agent_json_extract_string(response, "errorCode");
+    char *error_msg = agent_json_extract_string(response, "message");
+    char *display = agent_json_extract_string(response, "displayText");
+    agent_buf out = {0};
+
+    if (display && display[0]) {
+        /* Canonical path — server provides pre-rendered displayText */
+        agent_buf_puts(&out, display);
+        agent_buf_puts(&out, "\n");
+    } else if (error_code && error_code[0]) {
+        /* Fallback for error responses without displayText */
+        agent_buf_puts(&out, "lean_inspect error: ");
+        agent_buf_puts(&out, error_code);
+        if (error_msg && error_msg[0]) {
+            agent_buf_puts(&out, " — ");
+            agent_buf_puts(&out, error_msg);
+        }
+        agent_buf_puts(&out, "\n");
+    } else {
+        /* Minimal fallback — should not happen with canonical server */
+        agent_buf_puts(&out, "lean_inspect status=");
+        agent_buf_puts(&out, status);
+        agent_buf_puts(&out, "\n");
+    }
+
+    /* WP02.4 — forensic mode: when DS4_LEAN_INSPECT_FORENSIC is set, append
+     * the raw JSON response so operators can inspect the full server output.
+     * Off by default to keep model context lean. */
+    if (getenv("DS4_LEAN_INSPECT_FORENSIC")) {
+        agent_buf_puts(&out, "--- FORENSIC lean_inspect response ---\n");
+        agent_buf_puts(&out, response);
+        agent_buf_puts(&out, "\n--- END FORENSIC ---\n");
+    }
+
+    free(status);
+    free(error_code);
+    free(error_msg);
+    free(display);
+    free(response);
+    return agent_buf_take(&out);
+}
+
+static char *agent_tool_lean_via_http(agent_worker *w, const agent_tool_call *call) {
+    const char *code = agent_tool_arg_value(call, "code");
+    if (!code || !code[0])
+        return agent_lean_tool_error(false, "LEAN_CODE_REQUIRED", "contract", false,
+                                     "fix-arguments",
+                                     "lean_check requires a non-empty code argument");
+
+    size_t code_len = strlen(code);
+    if (code_len > AGENT_LEAN_MAX_SOURCE_BYTES) {
+        char detail[160];
+        snprintf(detail, sizeof(detail),
+                 "%zu bytes exceeds the %d byte limit", code_len,
+                 AGENT_LEAN_MAX_SOURCE_BYTES);
+        return agent_lean_tool_error(false, "LEAN_SOURCE_TOO_LARGE", "contract",
+                                     false, "shrink-source", detail);
+    }
+
+    /* Fail closed: without a loaded policy the model has not been told how to
+     * read the result, so the call is refused rather than sent with an empty
+     * revision the server would not be able to match. */
+    if (!agent_worker_lean_policy_coherent(w))
+        return agent_lean_policy_incoherent_error(w);
+
+    /* A build whose contract descriptor never reached the worker cannot state
+     * which lean_check it implements, so it must not send a request the server
+     * would have to guess about. Distinct from a prompt problem: nothing the
+     * model or the user can do repairs this one. */
+    if (!agent_worker_lean_contract_coherent(w))
+        return agent_lean_tool_error(
+            false, "LEAN_CONTRACT_REVISION_LOCAL_INVALID", "contract", false,
+            "operator-code-fix",
+            "the compiled Lean contract descriptor is unavailable or stale");
+
+    /* The old "two consecutive lean_check calls" ceiling is gone on purpose: a
+     * proof is repaired by consecutive checks, and that guard made the only
+     * legitimate loop look like a runaway one. The budget that remains is the
+     * per-proof attempt/wall-clock one, shared with the Node orchestrator. */
+
+    /* WP-10 §13.4 — task_mode is parsed before any proof state is touched: a
+     * utility probe must be unable to mint, consume or terminalize the turn's
+     * proof task. `theorem test : 1 + 1 = 2` published as the user's Cauchy
+     * proof is exactly what this separation exists to prevent. */
+    const char *task_mode = agent_tool_arg_value(call, "task_mode");
+    if (!task_mode ||
+        (strcmp(task_mode, "proof") && strcmp(task_mode, "utility")))
+        return agent_lean_tool_error(
+            false, "LEAN_TASK_MODE_INVALID", "contract", false, "fix-arguments",
+            "lean_check requires task_mode=proof for the theorem the user asked "
+            "for, or task_mode=utility for a syntax/runtime probe");
+    bool proof_mode = !strcmp(task_mode, "proof");
+
+    const char *target_declaration =
+        agent_tool_arg_value(call, "target_declaration");
+    const char *target_statement =
+        agent_tool_arg_value(call, "target_statement");
+    if (proof_mode) {
+        if (!target_declaration || !target_declaration[0])
+            return agent_lean_tool_error(
+                false, "LEAN_TARGET_DECLARATION_REQUIRED", "contract", false,
+                "fix-arguments",
+                "task_mode=proof requires target_declaration naming the "
+                "theorem or lemma being proved");
+        if (!agent_lean_valid_declaration_name(target_declaration))
+            return agent_lean_tool_error(
+                false, "LEAN_TARGET_DECLARATION_INVALID", "contract", false,
+                "fix-arguments",
+                "target_declaration must be a single Lean declaration name");
+        /* §11.2 — the target may not be derived from the first lean_check.
+         * Without a declared statement a first candidate could define the
+         * task by being the task, then match itself. The server derives the
+         * digest from this header; the C only forwards it. */
+        if (!target_statement || !target_statement[0])
+            return agent_lean_tool_error(
+                false, "LEAN_TASKSPEC_STATEMENT_REQUIRED", "contract", false,
+                "fix-arguments",
+                "task_mode=proof requires target_statement: the theorem as a "
+                "Lean declaration header up to ':= by'. It seals the task "
+                "before any candidate runs; no attempt is spent.");
+        /* One turn proves one theorem: a proof call naming another declaration
+         * is refused before the request is built, not adopted (§13.6). */
+        if (w->lean_turn.target_declaration[0] &&
+            strcmp(target_declaration, w->lean_turn.target_declaration)) {
+            char detail[320];
+            snprintf(detail, sizeof(detail),
+                     "this turn is proving '%s'; target_declaration '%s' would "
+                     "replace the proof task instead of repairing it",
+                     w->lean_turn.target_declaration, target_declaration);
+            return agent_lean_tool_error(
+                false, "LEAN_TARGET_DECLARATION_MISMATCH", "target_identity",
+                false, "restore-target-declaration", detail);
+        }
+    } else if (target_declaration && target_declaration[0]) {
+        return agent_lean_tool_error(
+            false, "LEAN_TARGET_DECLARATION_NOT_ALLOWED", "contract", false,
+            "fix-arguments",
+            "task_mode=utility must not carry a target_declaration: a probe "
+            "cannot become the turn's proof task");
+    }
+    if (!proof_mode && target_statement && target_statement[0])
+        return agent_lean_tool_error(
+            false, "LEAN_TARGET_STATEMENT_NOT_ALLOWED", "contract", false,
+            "fix-arguments",
+            "task_mode=utility must not carry a target_statement: a probe "
+            "does not seal a proof task.");
+
+    /* Hash the exact bytes about to be shipped: the same digest the server
+     * computes, reused both to refuse an unchanged retry and to identify the
+     * source that was verified. */
+    char source_sha256[65];
+    ds4_sha256_hex(code, code_len, source_sha256);
+
+    const char *profile_arg = agent_tool_arg_value(call, "profile");
+    if (profile_arg && strcmp(profile_arg, "core") && strcmp(profile_arg, "mathlib"))
+        profile_arg = NULL;
+
+    /* Proof state — attempt budget, proof id, turn profile — belongs to the
+     * proof task alone; utility runs on a local, ephemeral identity (§13.5). */
+    char utility_run_id[96] = {0};
+    char utility_profile[16] = {0};
+    const char *run_id_sent = NULL;
+    const char *proof_id_sent = NULL;
+    const char *profile_sent = NULL;
+    int attempt_sent = 1;
+
+    if (proof_mode) {
+        char turn_err[192] = {0};
+        if (!agent_lean_turn_before_attempt(&w->lean_turn, source_sha256, false,
+                                            turn_err, sizeof(turn_err))) {
+            bool unchanged = strstr(turn_err, "byte-identical") != NULL;
+            char detail[320];
+            snprintf(detail, sizeof(detail), "%s",
+                     turn_err[0] ? turn_err : "lean proof budget exhausted");
+            return agent_lean_tool_error(
+                true,
+                unchanged ? "LEAN_SOURCE_UNCHANGED_AFTER_FAILURE"
+                          : "LEAN_ATTEMPT_BUDGET_EXHAUSTED",
+                unchanged ? "contract" : "budget", false,
+                unchanged ? "repair-source" : "publish-not-verified", detail);
+        }
+
+        w->lean_consecutive_rounds++;
+        w->lean_total_calls++;
+
+        /* The declaration name locks on the first proof call; the statement
+         * digest can only lock once the server has computed it (§13.6). */
+        if (!w->lean_turn.target_declaration[0])
+            snprintf(w->lean_turn.target_declaration,
+                     sizeof(w->lean_turn.target_declaration), "%s",
+                     target_declaration);
+
+        if (!agent_lean_turn_ensure_proof_id(w))
+            return agent_lean_tool_error(false, "LEAN_PROOF_ID_BUILD_FAILED", "internal",
+                                         false, "operator-code-fix",
+                                         "lean_check could not build a proof id");
+
+        /* One run id per attempt; reusing it would hit the server's replay guard. */
+        w->lean_turn.run_id[0] = '\0';
+        if (!agent_lean_turn_ensure_run_id(w))
+            return agent_lean_tool_error(false, "LEAN_RUN_ID_BUILD_FAILED", "internal",
+                                         false, "operator-code-fix",
+                                         "lean_check could not build a run id");
+
+        snprintf(w->lean_turn.profile, sizeof(w->lean_turn.profile), "%s",
+                 profile_arg ? profile_arg : "core");
+
+        run_id_sent = w->lean_turn.run_id;
+        proof_id_sent = w->lean_turn.proof_id;
+        profile_sent = w->lean_turn.profile;
+        attempt_sent = agent_lean_turn_attempt(&w->lean_turn);
+    } else {
+        w->lean_total_calls++;
+        if (!agent_lean_build_utility_run_id(w, utility_run_id,
+                                             sizeof(utility_run_id)))
+            return agent_lean_tool_error(false, "LEAN_RUN_ID_BUILD_FAILED", "internal",
+                                         false, "operator-code-fix",
+                                         "lean_check could not build a run id");
+        snprintf(utility_profile, sizeof(utility_profile), "%s",
+                 profile_arg ? profile_arg : "core");
+        run_id_sent = utility_run_id;
+        profile_sent = utility_profile;
+    }
+
+    /* Timeout is parsed against the Lean contract: invalid input is a local
+     * tool error and no HTTP request is sent; the value shipped is always
+     * accepted by validateLeanRequest (1..120, default 30). */
+    int timeout = 0;
+    char timeout_err[96] = {0};
+    if (!agent_parse_lean_timeout(agent_tool_arg_value(call, "timeout_sec"),
+                                  &timeout, timeout_err, sizeof(timeout_err))) {
+        char detail[192];
+        snprintf(detail, sizeof(detail),
+                 "timeout_sec must be an integer between 1 and %d",
+                 AGENT_LEAN_MAX_TIMEOUT_SEC);
+        return agent_lean_tool_error(
+            false, timeout_err[0] ? timeout_err : "LEAN_TIMEOUT_INVALID",
+            "contract", false, "fix-arguments", detail);
+    }
+
+    const char *declarations = agent_tool_arg_value(call, "expected_declarations");
+    const char *session = w->session_sha[0] ? w->session_sha : "default";
+
+    char *body = agent_lean_build_request(
+        code, profile_sent, session, run_id_sent, proof_id_sent,
+        attempt_sent, w->lean_policy_revision,
+        w->lean_contract_revision, agent_lean_policy_mode(w),
+        timeout, declarations, task_mode,
+        proof_mode ? w->lean_turn.target_declaration : NULL,
+        /* The expected hash is orchestrator state, never a model argument: it
+         * exists only once a previous result locked the statement (§13.6). */
+        (proof_mode && w->lean_turn.target_identity_locked)
+            ? w->lean_turn.target_statement_sha256 : NULL,
+        proof_mode ? target_statement : NULL);
+    if (!body)
+        return agent_lean_tool_error(false, "LEAN_REQUEST_BUILD_FAILED", "internal",
+                                     false, "operator-code-fix",
+                                     "the lean_check request could not be built");
+
+    /* Native loopback transport: no shell, no curl. The client timeout is the
+     * Lean timeout plus a 5s margin so a legitimate elaboration that runs up
+     * to its own request timeout is never cut off by the transport (the old
+     * fixed 30s curl cap did exactly that). */
+    agent_http_response http = {0};
+    int client_timeout_ms = timeout * 1000 + AGENT_LEAN_HTTP_TIMEOUT_MARGIN_MS;
+    bool transport_ok = agent_http_post_json(
+        w->cfg->frontend_port, "/api/lean/exec", body, strlen(body),
+        client_timeout_ms, AGENT_LEAN_MAX_RESPONSE_BYTES, &http);
+    free(body);
+
+    if (!transport_ok) {
+        if (proof_mode) {
+            agent_lean_turn_record_result(
+                &w->lean_turn, false, false, true, "transport",
+                "The Lean backend did not answer. Resend the same source once; if it "
+                "fails again, publish NOT_VERIFIED with the transport error code.",
+                NULL, false, NULL, NULL);
+            snprintf(w->lean_turn.failure_code, sizeof(w->lean_turn.failure_code),
+                     "%s", http.error[0] ? http.error : "LEAN_HTTP_TRANSPORT_FAILED");
+            /* The one authorized unchanged-source retry (§8.6): the source was never
+             * the problem here, so forgetting its hash lets the same bytes be sent
+             * again. The attempt budget still bounds how often that can happen. */
+            w->lean_turn.last_source_sha256[0] = '\0';
+        }
+        return agent_lean_tool_error(false, "LEAN_HTTP_TRANSPORT_FAILED", "transport",
+                                     true, "retry-once",
+                                     "the Lean backend did not answer");
+    }
+
+    /* From here every exit path must free `response` and record a turn result. */
+    char *response = http.body;
+    http.body = NULL;
+    char *reject = NULL;
+    char *contract = NULL, *run_id = NULL, *revision = NULL, *status = NULL, *summary = NULL;
+    char *contract_revision = NULL, *server_prompt_revision = NULL;
+    /* Response integrity (WP-11) and proof target identity (WP-10 §13.9). */
+    char *server_source_sha = NULL, *server_profile = NULL;
+    char *server_target_decl = NULL, *server_target_sha = NULL;
+    char *server_target_algo = NULL;
+    /* The digest the task was sealed on, as opposed to the one this candidate
+     * states (§11.2). */
+    char *server_task_sha = NULL;
+    bool server_target_matched = false;
+
+    if (http.too_large) {
+        reject = xstrdup("LEAN_RESPONSE_TOO_LARGE");
+        goto done;
+    }
+    if (strlen(response) > AGENT_LEAN_MAX_RESPONSE_BYTES) {
+        reject = xstrdup("LEAN_RESPONSE_TOO_LARGE");
+        goto done;
+    }
+
+    contract = agent_json_extract_string(response, "contractVersion");
+    if (!contract) {
+        /* Not JSON at all, or JSON without our envelope: an error page, a proxy
+         * response, anything. Never treat it as a result. */
+        reject = xstrdup("LEAN_RESPONSE_NOT_JSON");
+        goto done;
+    }
+    if (strcmp(contract, "lean_result_v1")) {
+        reject = xstrdup("LEAN_CONTRACT_UNSUPPORTED");
+        goto done;
+    }
+
+    run_id = agent_json_extract_string(response, "runId");
+    if (!run_id || strcmp(run_id, run_id_sent)) {
+        reject = xstrdup("LEAN_RUN_ID_MISMATCH");
+        goto done;
+    }
+
+    /* The echo check: the server must answer for the revision we sent, not for
+     * the one it happens to have on disk. This is an integrity check on the
+     * response, not a compatibility check — it catches a reply belonging to
+     * another session, which is why it stays terminal. */
+    revision = agent_json_extract_string(response, "promptRevision");
+    if (!revision || strcmp(revision, w->lean_policy_revision)) {
+        reject = xstrdup("LEAN_PROMPT_REVISION_ECHO_MISMATCH");
+        goto done;
+    }
+
+    /* The one revision comparison that refuses a result. A server implementing
+     * different lean_check semantics produces a result whose fields we would
+     * misread, so nothing about it can be trusted — including status=checked. */
+    contract_revision = agent_json_extract_string(response, "contractRevision");
+    if (!contract_revision ||
+        strcmp(contract_revision, DS4_LEAN_CONTRACT_REVISION)) {
+        reject = xstrdup("LEAN_CONTRACT_REVISION_MISMATCH_SERVER");
+        goto done;
+    }
+
+    /* Prompt drift: recorded, reported to the model, and explicitly not a
+     * reason to abandon the proof. The server having newer editorial text says
+     * nothing about whether this elaboration succeeded (§21.4). */
+    server_prompt_revision =
+        agent_json_extract_string(response, "serverPromptRevision");
+    if (agent_json_extract_bool(response, "promptDriftDetected")) {
+        w->lean_prompt_drift_detected = true;
+        snprintf(w->lean_server_prompt_revision,
+                 sizeof(w->lean_server_prompt_revision), "%s",
+                 server_prompt_revision ? server_prompt_revision : "");
+    }
+
+    status = agent_json_extract_string(response, "status");
+    if (!agent_lean_status_valid(status)) {
+        reject = xstrdup("LEAN_STATUS_INVALID");
+        goto done;
+    }
+
+    /* WP-11 — the answer must be about the bytes and the profile that were
+     * actually sent. The observed transcript asked for mathlib and published a
+     * core result with nothing detecting it. A result that never ran Lean
+     * (validation, preflight) legitimately carries no source digest, so the
+     * digest is required exactly where it decides something: status=checked. */
+    server_source_sha = agent_json_extract_string(response, "sourceSha256");
+    if (!strcmp(status, "checked") && !server_source_sha) {
+        reject = xstrdup("LEAN_SOURCE_ECHO_MISMATCH");
+        goto done;
+    }
+    if (server_source_sha && strcmp(server_source_sha, source_sha256)) {
+        reject = xstrdup("LEAN_SOURCE_ECHO_MISMATCH");
+        goto done;
+    }
+    server_profile = agent_json_extract_string(response, "profile");
+    if (!server_profile || strcmp(server_profile, profile_sent)) {
+        reject = xstrdup("LEAN_PROFILE_ECHO_MISMATCH");
+        goto done;
+    }
+
+    /* Target identity travels with every proof result, including a candidate
+     * rejected before the spawn: that rejection still carries a valid
+     * extraction, and locking on it is what stops the next attempt from
+     * substituting the statement (§13.9, §13.10). */
+    if (proof_mode) {
+        server_target_decl = agent_json_extract_string(response, "targetDeclaration");
+        server_target_sha = agent_json_extract_string(response, "targetStatementSha256");
+        /* Two different digests: targetStatementSha256 is what the candidate
+         * states, taskStatementSha256 is what the task was sealed on before
+         * any candidate ran. Locking the former is how a first candidate used
+         * to define the task by being the task. */
+        server_task_sha = agent_json_extract_string(response, "taskStatementSha256");
+        server_target_algo = agent_json_extract_string(response, "targetIdentityAlgorithm");
+        server_target_matched = agent_json_extract_bool(response, "targetIdentityMatched");
+        if (!strcmp(status, "checked") &&
+            (!server_target_decl || !server_target_sha || !server_target_algo ||
+             !server_target_matched)) {
+            reject = xstrdup("LEAN_TARGET_IDENTITY_MISSING");
+            goto done;
+        }
+    }
+
+done:
+    if (reject) {
+        /* A response that does not satisfy the contract is not a check result:
+         * it is terminal infrastructure evidence, never a repairable proof. A
+         * utility probe records nothing: it has no proof task to terminalize. */
+        if (proof_mode) {
+            agent_lean_turn_record_result(
+                &w->lean_turn, true, false, false, "infrastructure",
+                "Do not modify the theorem code. Publish NOT_VERIFIED quoting the "
+                "exact runtime error code.",
+                NULL, false, reject, NULL);
+            snprintf(w->lean_turn.failure_code, sizeof(w->lean_turn.failure_code),
+                     "%s", reject);
+        }
+        /* Three different failures, three different recoveries. Naming them the
+         * same taught the model to guess, and it guessed "Lean toolchain
+         * mismatch" for what was a prompt hash (§39). */
+        bool echo_mismatch =
+            !strcmp(reject, "LEAN_PROMPT_REVISION_ECHO_MISMATCH");
+        bool contract_mismatch =
+            !strcmp(reject, "LEAN_CONTRACT_REVISION_MISMATCH_SERVER");
+        /* WP-11: a result about other bytes, another profile, or another
+         * statement is not a weaker result — it is evidence the two sides
+         * disagree about what was run, so it is never repairable by editing
+         * the proof. */
+        bool integrity_mismatch =
+            !strcmp(reject, "LEAN_SOURCE_ECHO_MISMATCH") ||
+            !strcmp(reject, "LEAN_PROFILE_ECHO_MISMATCH") ||
+            !strcmp(reject, "LEAN_TARGET_IDENTITY_MISSING");
+        const char *category = echo_mismatch ? "state-coherence"
+                             : (contract_mismatch || integrity_mismatch)
+                                 ? "infrastructure"
+                             : "contract";
+        const char *recovery = echo_mismatch ? "reapply-policy"
+                             : "operator-code-fix";
+        const char *detail =
+            echo_mismatch
+                ? "the server answered for a different Lean policy revision than "
+                  "the one this session sent; treat the check as not performed"
+            : contract_mismatch
+                ? "the client and the server implement incompatible lean_check "
+                  "contracts; Lean was not run and the theorem code is not the "
+                  "problem"
+            : integrity_mismatch
+                ? "the Lean backend answered about a different source, profile "
+                  "or declaration than the one this call sent; do not publish "
+                  "anything from it"
+                : "the Lean backend returned a response that does not satisfy "
+                  "lean_result_v1; treat the check as not performed";
+        char *msg = agent_lean_tool_error(false, reject, category, false,
+                                          recovery, detail);
+        free(reject);
+        free(contract); free(run_id); free(revision); free(status);
+        free(contract_revision); free(server_prompt_revision);
+        free(server_source_sha); free(server_profile);
+        free(server_target_decl); free(server_target_sha); free(server_target_algo);
+        free(server_task_sha);
+        free(response);
+        return msg;
+    }
+
+    /* A server that cannot run Lean is not a result to reason about: name it
+     * so the model stops instead of rewriting its proof (§10.3). */
+    if (!strcmp(status, "preflight_failed")) {
+        char *server_code = agent_json_extract_string(response, "errorCode");
+        char detail[320];
+        snprintf(detail, sizeof(detail),
+                 "the Lean runtime is not usable on the server (%s); "
+                 "run /lean preflight to see why",
+                 server_code && server_code[0] ? server_code : "no runtime");
+        if (proof_mode)
+            agent_lean_turn_record_result(
+                &w->lean_turn, true, false, false, "infrastructure",
+                "Do not modify the theorem code. Publish NOT_VERIFIED quoting the "
+                "exact runtime error code.",
+                NULL, false,
+                server_code && server_code[0] ? server_code : "LEAN_RUNTIME_UNAVAILABLE",
+                NULL);
+        free(server_code);
+        free(contract); free(run_id); free(revision); free(status);
+        free(contract_revision); free(server_prompt_revision);
+        free(server_source_sha); free(server_profile);
+        free(server_target_decl); free(server_target_sha); free(server_target_algo);
+        free(server_task_sha);
+        free(response);
+        return agent_lean_tool_error(false, "LEAN_RUNTIME_UNAVAILABLE", "runtime",
+                                     false, "run-lean-preflight", detail);
+    }
+
+    /* The orchestration decision is the server's, computed by the Node
+     * classifier from the run's own evidence. The flat orchestration* keys are
+     * duplicated at the top level of the contract precisely so this parser
+     * stays a flat-key reader (§10.4). */
+    bool orch_terminal = agent_json_extract_bool(response, "orchestrationTerminal");
+    bool orch_verified = agent_json_extract_bool(response, "orchestrationVerified");
+    bool orch_retryable = agent_json_extract_bool(response, "orchestrationRetryable");
+    bool orch_strategy = agent_json_extract_bool(response,
+                                                 "orchestrationStrategyChangeRequired");
+    char *orch_class = agent_json_extract_string(response, "orchestrationFailureClass");
+    char *orch_action = agent_json_extract_string(response, "orchestrationNextAction");
+    char *orch_fingerprint = agent_json_extract_string(response, "orchestrationFingerprint");
+    char *orch_reason = agent_json_extract_string(response, "orchestrationTerminalReason");
+
+    /* Defence in depth: whatever the server said, `verified` requires
+     * status=checked here too. A server that ever disagreed with itself must
+     * not be able to talk this client into publishing a proof. */
+    if (orch_verified && strcmp(status, "checked")) {
+        orch_verified = false;
+        orch_terminal = true;
+        orch_retryable = false;
+    }
+
+    /* A utility probe renders its own result and returns: it never touches the
+     * proof task, so it cannot consume an attempt, cannot terminalize the turn
+     * and cannot be published as the theorem the user asked for (§13.5). */
+    if (!proof_mode) {
+        agent_buf uout = {0};
+        char uheader[256];
+        snprintf(uheader, sizeof(uheader),
+                 "lean_check task_mode=utility status=%s profile=%s\n",
+                 status, profile_sent);
+        agent_buf_puts(&uout, uheader);
+        agent_buf_puts(&uout,
+                       "LEAN_UTILITY_RESULT\n"
+                       "authoritative=false\n"
+                       "verified=false\n"
+                       "proofTaskAffected=false\n"
+                       "This was a diagnostic probe. It proves nothing about the "
+                       "theorem the user asked for and must never be published as "
+                       "the answer. To work on the proof task call lean_check with "
+                       "task_mode=proof and target_declaration.\n\n");
+        summary = agent_json_extract_string(response, "summary");
+        if (summary && summary[0]) {
+            agent_buf_puts(&uout, summary);
+            agent_buf_puts(&uout, "\n");
+        }
+        agent_buf_puts(&uout, "\nFull result:\n");
+        agent_buf_puts(&uout, response);
+        agent_buf_puts(&uout, "\n");
+        free(orch_class); free(orch_action); free(orch_fingerprint); free(orch_reason);
+        free(contract); free(run_id); free(revision); free(status); free(summary);
+        free(contract_revision); free(server_prompt_revision);
+        free(server_source_sha); free(server_profile);
+        free(server_target_decl); free(server_target_sha); free(server_target_algo);
+        free(server_task_sha);
+        free(response);
+        return agent_buf_take(&uout);
+    }
+
+    /* WP-10 §13.10 — lock the statement on the first result that carries one,
