+static void test_agent_skill_registry_limits_clone_and_digest(void) {
+    ds4_agent_skill_registry first;
+    ds4_agent_skill_registry second;
+    ds4_agent_skill_registry clone;
+    ds4_agent_skill_registry_init(&first);
+    ds4_agent_skill_registry_init(&second);
+    char err[128] = {0};
+    bool changed = false;
+
+    ds4_agent_skill_entry alpha =
+        test_agent_skill_entry("alpha", "one", 'a');
+    ds4_agent_skill_entry beta =
+        test_agent_skill_entry("beta", "two", 'b');
+    AGENT_TEST_ASSERT(ds4_agent_skill_registry_upsert(
+        &first, &alpha, &changed, err, sizeof(err)));
+    AGENT_TEST_ASSERT(ds4_agent_skill_registry_upsert(
+        &first, &beta, &changed, err, sizeof(err)));
+
+    beta = test_agent_skill_entry("beta", "two", 'b');
+    alpha = test_agent_skill_entry("alpha", "one", 'a');
+    AGENT_TEST_ASSERT(ds4_agent_skill_registry_upsert(
+        &second, &beta, &changed, err, sizeof(err)));
+    AGENT_TEST_ASSERT(ds4_agent_skill_registry_upsert(
+        &second, &alpha, &changed, err, sizeof(err)));
+    AGENT_TEST_ASSERT(!strcmp(first.aggregate_revision,
+                              second.aggregate_revision));
+
+    AGENT_TEST_ASSERT(ds4_agent_skill_registry_clone(
+        &first, &clone, err, sizeof(err)));
+    AGENT_TEST_ASSERT(clone.items[0].content != first.items[0].content);
+    AGENT_TEST_ASSERT(!strcmp(clone.items[0].content,
+                              first.items[0].content));
+    char old_digest[41];
+    memcpy(old_digest, first.aggregate_revision, sizeof(old_digest));
+    ds4_agent_skill_entry updated =
+        test_agent_skill_entry("alpha", "updated", 'c');
+    AGENT_TEST_ASSERT(ds4_agent_skill_registry_upsert(
+        &first, &updated, &changed, err, sizeof(err)));
+    AGENT_TEST_ASSERT(changed);
+    AGENT_TEST_ASSERT(strcmp(old_digest, first.aggregate_revision) != 0);
+    AGENT_TEST_ASSERT(!strcmp(clone.items[0].content, "one"));
+    ds4_agent_skill_registry_free(&first);
+    ds4_agent_skill_registry_free(&second);
+    ds4_agent_skill_registry_free(&clone);
+
+    ds4_agent_skill_registry_init(&first);
+    for (int i = 0; i < DS4_AGENT_SKILL_ACTIVE_MAX; i++) {
+        char name[16];
+        snprintf(name, sizeof(name), "item%02d", i);
+        ds4_agent_skill_entry item =
+            test_agent_skill_entry_bytes(name, 1, 'x');
+        AGENT_TEST_ASSERT(ds4_agent_skill_registry_upsert(
+            &first, &item, &changed, err, sizeof(err)));
+    }
+    ds4_agent_skill_entry overflow =
+        test_agent_skill_entry_bytes("overflow", 1, 'x');
+    AGENT_TEST_ASSERT(!ds4_agent_skill_registry_upsert(
+        &first, &overflow, &changed, err, sizeof(err)));
+    AGENT_TEST_ASSERT(strstr(err, "SKILL_ACTIVE_LIMIT") != NULL);
+    ds4_agent_skill_entry_free(&overflow);
+    ds4_agent_skill_registry_free(&first);
+
+    ds4_agent_skill_registry_init(&first);
+    for (int i = 0; i < 4; i++) {
+        char name[16];
+        snprintf(name, sizeof(name), "large%d", i);
+        ds4_agent_skill_entry item = test_agent_skill_entry_bytes(
+            name, DS4_AGENT_SKILL_FILE_MAX, (char)('a' + i));
+        AGENT_TEST_ASSERT(ds4_agent_skill_registry_upsert(
+            &first, &item, &changed, err, sizeof(err)));
+    }
+    overflow = test_agent_skill_entry_bytes("extra", 1, 'z');
+    AGENT_TEST_ASSERT(!ds4_agent_skill_registry_upsert(
+        &first, &overflow, &changed, err, sizeof(err)));
+    AGENT_TEST_ASSERT(strstr(err, "SKILL_TOTAL_TOO_LARGE") != NULL);
+    ds4_agent_skill_entry_free(&overflow);
+    ds4_agent_skill_registry_free(&first);
+}
