+typedef enum {
+    AGENT_SLASH_UNKNOWN,
+    AGENT_SLASH_HELP,
+    AGENT_SLASH_SAVE,
+    AGENT_SLASH_COMPACT,
+    AGENT_SLASH_LIST,
+    AGENT_SLASH_QUIT,
+    AGENT_SLASH_EXIT,
+    AGENT_SLASH_NEW,
