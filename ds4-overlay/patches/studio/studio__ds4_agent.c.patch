+/* Execute all tool calls from one DSML block, preserving per-call labels in the
+ * combined result so the model can associate observations with calls. */
+static char *agent_execute_tool_calls(agent_worker *w, const agent_tool_calls *calls) {
+    agent_buf all = {0};
+    int sage_calls = 0;
+    int lean_calls = 0;
+    for (int i = 0; i < calls->len; i++) {
+        if (calls->v[i].name && !strcmp(calls->v[i].name, "sage"))
+            sage_calls++;
+        if (calls->v[i].name && !strcmp(calls->v[i].name, "lean_check"))
+            lean_calls++;
+    }
+    if (sage_calls && calls->len != 1) {
+        return xstrdup("Tool error: SAGE_MIXED_TOOL_BLOCK_FORBIDDEN\n");
+    }
+    if (lean_calls && calls->len != 1) {
+        return xstrdup("Tool error: LEAN_MIXED_TOOL_BLOCK_FORBIDDEN\n");
+    }
+    for (int i = 0; i < calls->len; i++) {
+        /* The repeated-action guard was fully written and tested but never
+         * reached from here, so AGENT_LOOP_GUARD_IDENTICAL_LIMIT described a
+         * behaviour that did not exist.  Fingerprinting happens before the
+         * call runs: a fingerprint the helper declines to build (pagination
+         * that moves forward, a call whose identity is not stable) is not an
+         * action this guard has an opinion about. */
+        char fingerprint[AGENT_LOOP_GUARD_FINGERPRINT_SIZE];
+        if (agent_loop_guard_fingerprint_call(&calls->v[i], fingerprint,
+                                              sizeof(fingerprint))) {
+            agent_loop_guard_record(w, fingerprint);
+            if (w->loop_guard_consecutive_identical >=
+                DS4_AGENT_REPEATED_ACTION_TERMINAL) {
+                char msg[320];
+                snprintf(msg, sizeof(msg),
+                         "Tool error: REPEATED_ACTION_TERMINAL — the same %s call has "
+                         "now run %d times with no new information. Stop repeating "
+                         "it: answer with what was learned, or make ONE different "
+                         "call.\n",
+                         calls->v[i].name ? calls->v[i].name : "tool",
+                         w->loop_guard_consecutive_identical);
+                agent_publish_system_status(w,
+                    "Loop guard: stessa azione ripetuta — arresto.");
+                agent_buf_puts(&all, msg);
+                return agent_buf_take(&all);
+            }
+        }
+        char *res = agent_execute_tool_call(w, &calls->v[i]);
+        {
+            /* §43 — the outcome comes from the executor, not from the model's
+             * account of it. "Tool error:" is this executor's own failure
+             * contract: every tool that fails returns a string starting with
+             * it, so reading that prefix is executor metadata rather than
+             * prose parsing. bash is deliberately excluded — it reports a real
+             * exit code, recorded by the producer that has it, and a guess
+             * here could contradict it. */
+            ds4_agent_epistemic_tool_result status = {0};
