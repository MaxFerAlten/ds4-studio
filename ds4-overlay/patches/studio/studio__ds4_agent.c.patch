+static void test_agent_parse_lean_timeout(void) {
+    /* Contract table from the remediation plan §6.3. */
+    struct { const char *raw; bool ok; int expect; } table[] = {
+        { NULL,  true,  AGENT_LEAN_DEFAULT_TIMEOUT_SEC },
+        { "",    true,  AGENT_LEAN_DEFAULT_TIMEOUT_SEC },
+        { "1",   true,  1 },
+        { "30",  true,  30 },
+        { "120", true,  120 },
+        { "121", false, 0 },
+        { "3600", false, 0 }, /* the old shared-parser default, must never ship */
+        { "nan", false, 0 },
+        { "1.5", false, 0 },
+        { "-5",  false, 0 },
+        { "0",   false, 0 },
+        { "120 ", true, 120 }, /* trailing whitespace tolerated, like other parsers */
+        { " 30", true,  30 },
+        { "30x", false, 0 },
+        { NULL, false, 0 }, /* sentinel */
+    };
+    for (int i = 0; table[i].raw != NULL; i++) { /* sentinel-terminated */
+        int out = -1;
+        char err[96];
+        bool ok = agent_parse_lean_timeout(table[i].raw, &out, err, sizeof(err));
+        if (table[i].ok) {
+            AGENT_TEST_ASSERT(ok);
+            AGENT_TEST_ASSERT(out == table[i].expect);
+            AGENT_TEST_ASSERT(out >= 1 && out <= AGENT_LEAN_MAX_TIMEOUT_SEC);
+            AGENT_TEST_ASSERT(err[0] == '\0');
+        } else {
+            AGENT_TEST_ASSERT(!ok);
+            AGENT_TEST_ASSERT(strstr(err, "LEAN_TIMEOUT_INVALID") != NULL);
+        }
+    }
+
+    /* On success the emitted timeoutSec is always inside the contract; the
+     * old parser could return 3600 for an absent value. */
+    int out = 0;
+    char err[96];
+    AGENT_TEST_ASSERT(agent_parse_lean_timeout(NULL, &out, err, sizeof(err)));
+    AGENT_TEST_ASSERT(out != 3600);
+    AGENT_TEST_ASSERT(out == AGENT_LEAN_DEFAULT_TIMEOUT_SEC);
+}
