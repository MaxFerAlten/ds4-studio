+static const char *agent_lean_state_name(agent_lean_state state) {
+    switch (state) {
+    case AGENT_LEAN_IDLE:                        return "idle";
+    case AGENT_LEAN_CHECKING:                    return "checking";
+    case AGENT_LEAN_REPAIR_REQUIRED:             return "repair_required";
+    case AGENT_LEAN_STRATEGY_CHANGE_REQUIRED:    return "strategy_change_required";
+    case AGENT_LEAN_VERIFIED:                    return "verified";
+    case AGENT_LEAN_INFRASTRUCTURE_BLOCK:        return "infrastructure_block";
+    case AGENT_LEAN_CONTRACT_BLOCK:              return "contract_block";
+    case AGENT_LEAN_BUDGET_EXHAUSTED:            return "budget_exhausted";
+    case AGENT_LEAN_CANCELLED:                   return "cancelled";
+    }
+    return "unknown";
+}
