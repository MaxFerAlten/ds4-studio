+static void test_agent_lean_turn_state(void) {
+    agent_worker w;
+    memset(&w, 0, sizeof(w));
+    w.wake_fd[0] = -1;
+    w.wake_fd[1] = -1;
+    pthread_mutex_init(&w.mu, NULL);
+
+    /* Ensure run ID generation */
+    AGENT_TEST_ASSERT(agent_lean_turn_ensure_run_id(&w));
+    AGENT_TEST_ASSERT(strlen(w.lean_turn.run_id) > 10);
+    AGENT_TEST_ASSERT(strstr(w.lean_turn.run_id, "lean-") != NULL);
+
+    /* Run ID is stable once set */
+    char first_run_id[96];
+    memcpy(first_run_id, w.lean_turn.run_id, sizeof(first_run_id));
+    AGENT_TEST_ASSERT(agent_lean_turn_ensure_run_id(&w));
+    AGENT_TEST_ASSERT(!strcmp(first_run_id, w.lean_turn.run_id));
+
+    /* Attempt counter */
+    AGENT_TEST_ASSERT(agent_lean_turn_attempt(&w.lean_turn) == 0);
+    w.lean_turn.attempt_count = 2;
+    AGENT_TEST_ASSERT(agent_lean_turn_attempt(&w.lean_turn) == 2);
+
+    /* L-C-13: the run id changes per attempt — the server's replay guard would
+     * reject a reused one — while the proof id stays put so the attempts of one
+     * theorem remain groupable. */
+    AGENT_TEST_ASSERT(agent_lean_turn_ensure_proof_id(&w));
+    AGENT_TEST_ASSERT(strstr(w.lean_turn.proof_id, "proof-") == w.lean_turn.proof_id);
+    char first_proof_id[96];
+    memcpy(first_proof_id, w.lean_turn.proof_id, sizeof(first_proof_id));
+
+    w.lean_turn.run_id[0] = '\0';
+    AGENT_TEST_ASSERT(agent_lean_turn_ensure_run_id(&w));
+    AGENT_TEST_ASSERT(strcmp(first_run_id, w.lean_turn.run_id) != 0);
+    AGENT_TEST_ASSERT(agent_lean_turn_ensure_proof_id(&w));
+    AGENT_TEST_ASSERT(!strcmp(first_proof_id, w.lean_turn.proof_id));
+
+    /* A turn reset drops the proof identity: a new user turn is a new task. */
+    agent_lean_turn_reset(&w.lean_turn);
+    AGENT_TEST_ASSERT(w.lean_turn.proof_id[0] == '\0');
+
+    /* WP04: rollback unconsumed attempt */
+    {
+        char err2[256] = {0};
+        agent_lean_turn_state s2;
+        memset(&s2, 0, sizeof(s2));
+        s2.max_attempts = 6;
+        /* Simulate one attempt consumed */
+        AGENT_TEST_ASSERT(agent_lean_turn_before_attempt(&s2, "aaa", false, err2, sizeof(err2)));
+        AGENT_TEST_ASSERT(s2.attempt_count == 1);
+        /* Rollback */
+        agent_lean_turn_rollback_unconsumed_attempt(&s2);
+        AGENT_TEST_ASSERT(s2.attempt_count == 0);
+        AGENT_TEST_ASSERT(s2.last_source_sha256[0] == '\0');
+        /* Next attempt is allowed at attempt=1 */
+        AGENT_TEST_ASSERT(agent_lean_turn_before_attempt(&s2, "bbb", false, err2, sizeof(err2)));
+        AGENT_TEST_ASSERT(s2.attempt_count == 1);
+    }
+
+    /* WP04: candidate_preflight sets REPAIR_REQUIRED, not terminal */
+    {
+        char err2[256] = {0};
+        agent_lean_turn_state s3;
+        memset(&s3, 0, sizeof(s3));
+        s3.max_attempts = 6;
+        AGENT_TEST_ASSERT(agent_lean_turn_before_attempt(&s3, "aaa", false, err2, sizeof(err2)));
+        agent_lean_turn_record_result(&s3, false, false, true,
+                                      "candidate_preflight",
+                                      "Remove placeholders and call lean_check again.",
+                                      NULL, false, NULL, "aaa");
+        AGENT_TEST_ASSERT(s3.state == AGENT_LEAN_REPAIR_REQUIRED);
+        AGENT_TEST_ASSERT(!agent_lean_turn_is_terminal(&s3));
+        AGENT_TEST_ASSERT(agent_lean_turn_must_continue(&s3));
+    }
+
+    /* WP04: contract error sets CONTRACT_BLOCK terminal */
+    {
+        char err2[256] = {0};
+        agent_lean_turn_state s4;
+        memset(&s4, 0, sizeof(s4));
+        s4.max_attempts = 6;
+        AGENT_TEST_ASSERT(agent_lean_turn_before_attempt(&s4, "aaa", false, err2, sizeof(err2)));
+        agent_lean_turn_record_result(&s4, true, false, false,
+                                      "contract",
+                                      "Do not modify the theorem code.",
+                                      NULL, false,
+                                      "NON_RETRYABLE_ERROR", "aaa");
+        AGENT_TEST_ASSERT(s4.state == AGENT_LEAN_CONTRACT_BLOCK);
+        AGENT_TEST_ASSERT(agent_lean_turn_is_terminal(&s4));
+    }
+
+    /* Target-identity guard (WP-10). The name alone is not the identity: the
+     * statement digest computed by the runtime is. A checked result whose
+     * statement is not the locked one must not become terminal VERIFIED, and
+     * the lock must survive so the next attempt still proves the original. */
+    {
+        const char *hash_a =
+            "1111111111111111111111111111111111111111111111111111111111111111";
+        const char *hash_b =
+            "2222222222222222222222222222222222222222222222222222222222222222";
+        char lock_err[96] = {0};
+
+        agent_lean_turn_state s5;
+        memset(&s5, 0, sizeof(s5));
+        AGENT_TEST_ASSERT(agent_lean_turn_lock_target(
+            &s5, "cauchy_mvt", hash_a, "lean-target-statement-v1", lock_err,
+            sizeof(lock_err)));
+        AGENT_TEST_ASSERT(s5.target_identity_locked);
+
+        /* Same name, different statement: refused, and the lock is untouched. */
+        AGENT_TEST_ASSERT(!agent_lean_turn_lock_target(
+            &s5, "cauchy_mvt", hash_b, "lean-target-statement-v1", lock_err,
+            sizeof(lock_err)));
+        AGENT_TEST_ASSERT(!strcmp(lock_err, "LEAN_TARGET_STATEMENT_MISMATCH"));
+        AGENT_TEST_ASSERT(!strcmp(s5.target_statement_sha256, hash_a));
+
+        /* Another declaration name is a different task, never an adoption. */
+        AGENT_TEST_ASSERT(!agent_lean_turn_lock_target(
+            &s5, "trivial_swap", hash_a, "lean-target-statement-v1", lock_err,
+            sizeof(lock_err)));
+        AGENT_TEST_ASSERT(!strcmp(lock_err, "LEAN_TARGET_DECLARATION_MISMATCH"));
+        AGENT_TEST_ASSERT(!strcmp(s5.target_declaration, "cauchy_mvt"));
+
+        /* A verified state whose returned statement is not the locked one is
+         * degraded to repair_required rather than published. */
+        s5.state = AGENT_LEAN_VERIFIED;
+        s5.checked = true;
+        agent_lean_turn_apply_result_identity(&s5, hash_b, true);
+        AGENT_TEST_ASSERT(s5.state == AGENT_LEAN_REPAIR_REQUIRED);
+        AGENT_TEST_ASSERT(!s5.checked);
+        AGENT_TEST_ASSERT(!strcmp(s5.failure_code, "LEAN_TARGET_STATEMENT_MISMATCH"));
+        AGENT_TEST_ASSERT(!strcmp(s5.failure_class, "target_identity"));
+
+        /* The matching statement stays verified and is recorded. */
+        agent_lean_turn_state s6;
+        memset(&s6, 0, sizeof(s6));
+        AGENT_TEST_ASSERT(agent_lean_turn_lock_target(
+            &s6, "cauchy_mvt", hash_a, "lean-target-statement-v1", lock_err,
+            sizeof(lock_err)));
+        s6.state = AGENT_LEAN_VERIFIED;
+        s6.checked = true;
+        agent_lean_turn_apply_result_identity(&s6, hash_a, true);
+        AGENT_TEST_ASSERT(s6.state == AGENT_LEAN_VERIFIED);
+        AGENT_TEST_ASSERT(s6.checked);
+        AGENT_TEST_ASSERT(!strcmp(s6.checked_target_statement_sha256, hash_a));
+
+        /* The server claiming a match it cannot back is not enough either. */
+        agent_lean_turn_state s7;
+        memset(&s7, 0, sizeof(s7));
+        s7.state = AGENT_LEAN_VERIFIED;
+        s7.checked = true;
+        agent_lean_turn_apply_result_identity(&s7, hash_a, true);
+        AGENT_TEST_ASSERT(s7.state == AGENT_LEAN_REPAIR_REQUIRED);
+    }
+
+    pthread_mutex_destroy(&w.mu);
+}
