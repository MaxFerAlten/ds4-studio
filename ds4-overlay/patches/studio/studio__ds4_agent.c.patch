+static ds4_agent_skill_entry test_agent_skill_entry(const char *name,
+                                                    const char *content,
+                                                    char revision_digit) {
+    ds4_agent_skill_entry entry = {0};
+    snprintf(entry.name, sizeof(entry.name), "%s", name);
+    entry.content = xstrdup(content);
+    entry.content_len = strlen(content);
+    memset(entry.revision, revision_digit, DS4_AGENT_SKILL_REVISION_HEX);
+    entry.revision[DS4_AGENT_SKILL_REVISION_HEX] = '\0';
+    entry.kind = DS4_AGENT_SKILL_DYNAMIC;
+    return entry;
+}
+
+static ds4_agent_skill_entry test_agent_skill_entry_bytes(
+    const char *name,
+    size_t content_len,
+    char fill) {
+    ds4_agent_skill_entry entry = {0};
+    snprintf(entry.name, sizeof(entry.name), "%s", name);
+    entry.content = malloc(content_len + 1);
+    AGENT_TEST_ASSERT(entry.content != NULL);
+    if (!entry.content) return entry;
+    memset(entry.content, fill, content_len);
+    entry.content[content_len] = '\0';
+    entry.content_len = content_len;
+    entry.kind = DS4_AGENT_SKILL_DYNAMIC;
+    ds4_kvstore_sha1_bytes_hex(entry.content, content_len, entry.revision);
+    return entry;
+}
