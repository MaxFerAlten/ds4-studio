+    /* L-C-01: reset publishes the shared attempt budget, not a local literal. */
+    AGENT_TEST_ASSERT(s.max_attempts == DS4_LEAN_MAX_ATTEMPTS);
+    AGENT_TEST_ASSERT(s.max_attempts > 3);
+    AGENT_TEST_ASSERT(!s.used);
+    AGENT_TEST_ASSERT(agent_lean_turn_can_finalize(&s));
+    AGENT_TEST_ASSERT(!agent_lean_turn_must_continue(&s));
+
+    char err[192] = {0};
+
+    /* L-C-02: a retryable failure leaves the turn callable and continuing. */
+    AGENT_TEST_ASSERT(agent_lean_turn_before_attempt(&s, "aa", false, err, sizeof(err)));
+    AGENT_TEST_ASSERT(s.state == AGENT_LEAN_CHECKING);
+    AGENT_TEST_ASSERT(s.attempt_count == 1);
+    AGENT_TEST_ASSERT(s.used);
+    agent_lean_turn_record_result(&s, false, false, true, "unsolved_goals",
+                                  "Close the residual goal.", "sha256:one",
+                                  false, NULL, NULL);
+    AGENT_TEST_ASSERT(s.state == AGENT_LEAN_REPAIR_REQUIRED);
+    AGENT_TEST_ASSERT(s.retryable);
+
+    /* L-C-09: prose is not publishable while a repairable failure stands. */
+    AGENT_TEST_ASSERT(!agent_lean_turn_can_finalize(&s));
+    AGENT_TEST_ASSERT(agent_lean_turn_must_continue(&s));
+
+    /* L-C-11: the identical source is refused before the spawn, and refusing
+     * it must not consume an attempt. */
+    AGENT_TEST_ASSERT(!agent_lean_turn_before_attempt(&s, "aa", false, err, sizeof(err)));
+    AGENT_TEST_ASSERT(strstr(err, "byte-identical") != NULL);
+    AGENT_TEST_ASSERT(s.attempt_count == 1);
+    /* …unless the retry is the authorized transient-infrastructure one. */
+    AGENT_TEST_ASSERT(agent_lean_turn_before_attempt(&s, "aa", true, err, sizeof(err)));
+    AGENT_TEST_ASSERT(s.attempt_count == 2);
+
+    /* L-C-12: the same fingerprint twice demands a strategy change. */
+    agent_lean_turn_reset(&s);
+    AGENT_TEST_ASSERT(agent_lean_turn_before_attempt(&s, "s1", false, err, sizeof(err)));
+    agent_lean_turn_record_result(&s, false, false, true, "rewrite_miss",
+                                  "Replace the rw chain.", "sha256:same",
+                                  false, NULL, NULL);
+    AGENT_TEST_ASSERT(s.state == AGENT_LEAN_REPAIR_REQUIRED);
+    AGENT_TEST_ASSERT(s.same_failure_count == 1);
+    AGENT_TEST_ASSERT(agent_lean_turn_before_attempt(&s, "s2", false, err, sizeof(err)));
+    agent_lean_turn_record_result(&s, false, false, true, "rewrite_miss",
+                                  "Replace the rw chain.", "sha256:same",
+                                  false, NULL, NULL);
+    AGENT_TEST_ASSERT(s.same_failure_count == 2);
+    AGENT_TEST_ASSERT(s.state == AGENT_LEAN_STRATEGY_CHANGE_REQUIRED);
+    AGENT_TEST_ASSERT(s.strategy_change_required);
+    AGENT_TEST_ASSERT(s.strategy_generation == 1);
+    AGENT_TEST_ASSERT(!agent_lean_turn_can_finalize(&s));
+
+    /* L-C-13 (F3.1): distinct candidates that keep failing the same way must
+     * escalate too. The transcript in fix-lean-01 cycled invented theorem
+     * names, so every fingerprint differed and the L-C-12 rule above never
+     * fired — the model kept guessing until the attempt budget ran out. */
+    agent_lean_turn_reset(&s);
+    AGENT_TEST_ASSERT(agent_lean_turn_before_attempt(&s, "u1", false, err, sizeof(err)));
+    agent_lean_turn_record_result(&s, false, false, true, "unknown_identifier",
+                                  "Check the namespace.", "sha256:u1",
+                                  false, NULL, NULL);
+    AGENT_TEST_ASSERT(s.same_class_count == 1);
+    AGENT_TEST_ASSERT(s.state == AGENT_LEAN_REPAIR_REQUIRED);
+    AGENT_TEST_ASSERT(agent_lean_turn_before_attempt(&s, "u2", false, err, sizeof(err)));
+    agent_lean_turn_record_result(&s, false, false, true, "unknown_identifier",
+                                  "Check the namespace.", "sha256:u2",
+                                  false, NULL, NULL);
+    /* Different fingerprints throughout: the fingerprint rule stays quiet. */
+    AGENT_TEST_ASSERT(s.same_failure_count == 1);
+    AGENT_TEST_ASSERT(s.same_class_count == 2);
+    AGENT_TEST_ASSERT(s.state == AGENT_LEAN_REPAIR_REQUIRED);
+    AGENT_TEST_ASSERT(agent_lean_turn_before_attempt(&s, "u3", false, err, sizeof(err)));
+    agent_lean_turn_record_result(&s, false, false, true, "unknown_identifier",
+                                  "Check the namespace.", "sha256:u3",
+                                  false, NULL, NULL);
+    AGENT_TEST_ASSERT(s.same_failure_count == 1);
+    AGENT_TEST_ASSERT(s.same_class_count == DS4_LEAN_STRATEGY_CHANGE_AFTER + 1);
+    AGENT_TEST_ASSERT(s.state == AGENT_LEAN_STRATEGY_CHANGE_REQUIRED);
+    AGENT_TEST_ASSERT(s.strategy_change_required);
+
+    /* A class that actually moves is progress: the counter starts over. */
+    agent_lean_turn_reset(&s);
+    AGENT_TEST_ASSERT(agent_lean_turn_before_attempt(&s, "m1", false, err, sizeof(err)));
+    agent_lean_turn_record_result(&s, false, false, true, "unknown_identifier",
+                                  "Check the namespace.", "sha256:m1",
+                                  false, NULL, NULL);
+    AGENT_TEST_ASSERT(agent_lean_turn_before_attempt(&s, "m2", false, err, sizeof(err)));
+    agent_lean_turn_record_result(&s, false, false, true, "unknown_identifier",
+                                  "Check the namespace.", "sha256:m2",
+                                  false, NULL, NULL);
+    AGENT_TEST_ASSERT(s.same_class_count == 2);
+    AGENT_TEST_ASSERT(agent_lean_turn_before_attempt(&s, "m3", false, err, sizeof(err)));
+    agent_lean_turn_record_result(&s, false, false, true, "unsolved_goals",
+                                  "Close the residual goal.", "sha256:m3",
+                                  false, NULL, NULL);
+    AGENT_TEST_ASSERT(s.same_class_count == 1);
+    AGENT_TEST_ASSERT(!s.strategy_change_required);
+    AGENT_TEST_ASSERT(s.state == AGENT_LEAN_REPAIR_REQUIRED);
+
+    /* L-C-06: a timeout is a distinct repairable class, not a false proof. */
+    agent_lean_turn_reset(&s);
+    AGENT_TEST_ASSERT(agent_lean_turn_before_attempt(&s, "t1", false, err, sizeof(err)));
+    agent_lean_turn_record_result(&s, false, false, true, "timeout_repairable",
+                                  "Narrow the imports.", "sha256:t", false,
+                                  NULL, NULL);
+    AGENT_TEST_ASSERT(s.state == AGENT_LEAN_REPAIR_REQUIRED);
+    AGENT_TEST_ASSERT(!s.checked);
+    AGENT_TEST_ASSERT(!strcmp(s.failure_class, "timeout_repairable"));
+
+    /* L-C-03 / L-C-04: attempt 4 is legitimate; attempt 7 is not. */
+    agent_lean_turn_reset(&s);
+    for (int attempt = 1; attempt <= DS4_LEAN_MAX_ATTEMPTS; attempt++) {
+        char sha[32];
+        snprintf(sha, sizeof(sha), "candidate-%d", attempt);
+        AGENT_TEST_ASSERT(agent_lean_turn_before_attempt(&s, sha, false, err, sizeof(err)));
+        AGENT_TEST_ASSERT(s.attempt_count == attempt);
+        if (attempt == 4) AGENT_TEST_ASSERT(!agent_lean_turn_is_terminal(&s));
+        agent_lean_turn_record_result(&s, false, false, true, "proof_failure",
+                                      "Repair it.", NULL, false, NULL, NULL);
+    }
+    AGENT_TEST_ASSERT(s.state == AGENT_LEAN_BUDGET_EXHAUSTED);
+    AGENT_TEST_ASSERT(!agent_lean_turn_before_attempt(&s, "extra", false, err, sizeof(err)));
+    /* A spent budget is terminal: the turn may end, but only as NOT_VERIFIED. */
+    AGENT_TEST_ASSERT(agent_lean_turn_can_finalize(&s));
+    AGENT_TEST_ASSERT(!s.checked);
+
+    /* L-C-05 / L-C-10 / L-C-14: checked is terminal, verified, publishable, and
+     * it records the exact source that was accepted. */
+    agent_lean_turn_reset(&s);
+    AGENT_TEST_ASSERT(agent_lean_turn_before_attempt(&s, "good", false, err, sizeof(err)));
+    agent_lean_turn_record_result(&s, true, true, false, NULL,
+                                  "publish_verified_result", NULL, false, NULL,
+                                  "b9c1");
+    AGENT_TEST_ASSERT(s.state == AGENT_LEAN_VERIFIED);
+    AGENT_TEST_ASSERT(s.checked);
+    AGENT_TEST_ASSERT(agent_lean_turn_can_finalize(&s));
+    AGENT_TEST_ASSERT(!agent_lean_turn_must_continue(&s));
+    AGENT_TEST_ASSERT(!strcmp(s.checked_source_sha256, "b9c1"));
+
+    /* L-C-07: cancellation is its own terminal state, never a proof. */
+    agent_lean_turn_reset(&s);
+    AGENT_TEST_ASSERT(agent_lean_turn_before_attempt(&s, "c1", false, err, sizeof(err)));
+    agent_lean_turn_record_result(&s, true, false, false, "user_cancelled",
+                                  "publish_not_verified_cancelled", NULL, false,
+                                  "USER_CANCELLED", NULL);
+    AGENT_TEST_ASSERT(s.state == AGENT_LEAN_CANCELLED);
+    AGENT_TEST_ASSERT(!s.checked);
+    AGENT_TEST_ASSERT(agent_lean_turn_can_finalize(&s));
+
+    /* L-C-08: an infrastructure block permits a NOT_VERIFIED answer. */
+    agent_lean_turn_reset(&s);
+    AGENT_TEST_ASSERT(agent_lean_turn_before_attempt(&s, "i1", false, err, sizeof(err)));
+    agent_lean_turn_record_result(&s, true, false, false, "infrastructure",
+                                  "publish_not_verified_infrastructure_block",
+                                  NULL, false, "LEAN_SANDBOX_UNAVAILABLE", NULL);
+    AGENT_TEST_ASSERT(s.state == AGENT_LEAN_INFRASTRUCTURE_BLOCK);
+    AGENT_TEST_ASSERT(agent_lean_turn_can_finalize(&s));
+    AGENT_TEST_ASSERT(!agent_lean_turn_must_continue(&s));
+    AGENT_TEST_ASSERT(!strcmp(s.failure_code, "LEAN_SANDBOX_UNAVAILABLE"));
+
+    /* A server that claims verified without status=checked is not believed: the
+     * transport clears the flag before this function is ever reached, so the
+     * only route into VERIFIED is a genuine checked result. */
+    agent_lean_turn_reset(&s);
+    AGENT_TEST_ASSERT(agent_lean_turn_before_attempt(&s, "l1", false, err, sizeof(err)));
+    agent_lean_turn_record_result(&s, true, false, false, "infrastructure",
+                                  "publish_not_verified_infrastructure_block",
+                                  NULL, false, "LEAN_CHECKED_INVARIANT_VIOLATION",
+                                  NULL);
+    AGENT_TEST_ASSERT(!s.checked);
+    AGENT_TEST_ASSERT(s.state != AGENT_LEAN_VERIFIED);
+
+    /* Premature finalizations escalate, then end the turn as NOT_VERIFIED. */
+    agent_lean_turn_reset(&s);
+    AGENT_TEST_ASSERT(agent_lean_turn_before_attempt(&s, "p1", false, err, sizeof(err)));
+    agent_lean_turn_record_result(&s, false, false, true, "unsolved_goals",
+                                  "Close the goal.", "sha256:p", false, NULL, NULL);
+    for (int i = 0; i < DS4_LEAN_MAX_PREMATURE_FINALIZATIONS; i++)
+        AGENT_TEST_ASSERT(agent_lean_turn_record_premature_finalization(&s));
+    AGENT_TEST_ASSERT(!agent_lean_turn_record_premature_finalization(&s));
+    AGENT_TEST_ASSERT(s.state == AGENT_LEAN_BUDGET_EXHAUSTED);
+    AGENT_TEST_ASSERT(agent_lean_turn_can_finalize(&s));
+
+    /* L-C-15: while the proof is unfinished the renderer defers every byte, so
+     * no prefix of a premature answer can reach the client. */
+    agent_lean_turn_reset(&s);
+    AGENT_TEST_ASSERT(agent_lean_turn_before_attempt(&s, "d1", false, err, sizeof(err)));
+    agent_lean_turn_record_result(&s, false, false, true, "syntax",
+                                  "Fix the parser error.", "sha256:d", false,
+                                  NULL, NULL);
+    AGENT_TEST_ASSERT(s.used && !agent_lean_turn_can_finalize(&s));
+
+    /* The guidance the loop substitutes for the discarded prose must name the
+     * state and demand another call rather than merely refusing. */
+    char *guidance = agent_lean_continuation_guidance(&s);
+    AGENT_TEST_ASSERT(guidance != NULL);
+    AGENT_TEST_ASSERT(strstr(guidance, "LEAN_FINALIZATION_BLOCKED") != NULL);
+    AGENT_TEST_ASSERT(strstr(guidance, "Call lean_check again") != NULL);
+    AGENT_TEST_ASSERT(strstr(guidance, "syntax") != NULL);
+    free(guidance);
+
+    char *notice = agent_lean_terminal_notice(&s);
+    AGENT_TEST_ASSERT(notice != NULL);
+    AGENT_TEST_ASSERT(strstr(notice, "LEAN_TERMINAL_NOT_VERIFIED") != NULL);
+    AGENT_TEST_ASSERT(strstr(notice, "Do not claim the theorem was verified") != NULL);
+    free(notice);
+}
