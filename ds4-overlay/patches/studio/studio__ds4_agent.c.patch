+static void test_agent_system_text_orders_dynamic_skills_before_sage(void) {
+    agent_worker w;
+    memset(&w, 0, sizeof(w));
+    ds4_agent_skill_registry_init(&w.dynamic_skills);
+
+    agent_config cfg;
+    memset(&cfg, 0, sizeof(cfg));
+    cfg.gen.system = "BASE";
+    w.cfg = &cfg;
+    w.soul_prompt = xstrdup("SOUL");
+    w.soul_active = true;
+    w.sage_prompt = xstrdup("SAGE");
+
+    char err[128] = {0};
+    bool changed = false;
+    ds4_agent_skill_entry beta =
+        test_agent_skill_entry("beta", "BETA", 'b');
+    ds4_agent_skill_entry alpha =
+        test_agent_skill_entry("alpha", "ALPHA", 'a');
+    AGENT_TEST_ASSERT(ds4_agent_skill_registry_upsert(
+        &w.dynamic_skills, &beta, &changed, err, sizeof(err)));
+    AGENT_TEST_ASSERT(ds4_agent_skill_registry_upsert(
+        &w.dynamic_skills, &alpha, &changed, err, sizeof(err)));
+
+    char *text = agent_worker_build_system_text(&w);
+    AGENT_TEST_ASSERT(text != NULL);
+    const char *soul = strstr(text, DS4_SOUL_BEGIN);
+    const char *alpha_marker =
+        strstr(text, "[BEGIN DS4 ACTIVE SKILL name=alpha");
+    const char *beta_marker =
+        strstr(text, "[BEGIN DS4 ACTIVE SKILL name=beta");
+    const char *sage = strstr(text, DS4_SAGE_BEGIN);
+    AGENT_TEST_ASSERT(soul && alpha_marker && beta_marker && sage);
+    AGENT_TEST_ASSERT(soul < alpha_marker);
+    AGENT_TEST_ASSERT(alpha_marker < beta_marker);
+    AGENT_TEST_ASSERT(beta_marker < sage);
+    AGENT_TEST_ASSERT(test_count_substring(
+        text, "[BEGIN DS4 ACTIVE SKILL name=alpha") == 1);
+
+    free(text);
+    free(w.soul_prompt);
+    free(w.sage_prompt);
+    ds4_agent_skill_registry_free(&w.dynamic_skills);
+}
