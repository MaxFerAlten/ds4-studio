+static void test_agent_search_literal_pipe_regex_retry(void) {
+    char dir[] = "/tmp/ds4_search_testXXXXXX";
+    if (!mkdtemp(dir)) { AGENT_TEST_ASSERT(!"mkdtemp failed"); return; }
+    char fpath[512];
