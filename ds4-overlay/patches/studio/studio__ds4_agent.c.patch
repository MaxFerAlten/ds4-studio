+static void test_agent_skill_registry_orders_and_renders(void) {
+    ds4_agent_skill_registry registry;
+    ds4_agent_skill_registry_init(&registry);
+    char err[128] = {0};
+    bool changed = false;
+
+    ds4_agent_skill_entry b = test_agent_skill_entry("beta", "BETA", 'b');
+    ds4_agent_skill_entry a = test_agent_skill_entry("alpha", "ALPHA", 'a');
+    AGENT_TEST_ASSERT(ds4_agent_skill_registry_upsert(
+        &registry, &b, &changed, err, sizeof(err)));
+    AGENT_TEST_ASSERT(changed);
+    AGENT_TEST_ASSERT(ds4_agent_skill_registry_upsert(
+        &registry, &a, &changed, err, sizeof(err)));
+    AGENT_TEST_ASSERT(changed);
+    AGENT_TEST_ASSERT(registry.len == 2);
+    AGENT_TEST_ASSERT(!strcmp(registry.items[0].name, "alpha"));
+    AGENT_TEST_ASSERT(!strcmp(registry.items[1].name, "beta"));
+    AGENT_TEST_ASSERT(strlen(registry.aggregate_revision) == 40);
+
+    ds4_agent_skill_entry same =
+        test_agent_skill_entry("alpha", "ALPHA", 'a');
+    AGENT_TEST_ASSERT(ds4_agent_skill_registry_upsert(
+        &registry, &same, &changed, err, sizeof(err)));
+    AGENT_TEST_ASSERT(!changed);
+    AGENT_TEST_ASSERT(registry.len == 2);
+
+    char *rendered = NULL;
+    size_t rendered_bytes = 0;
+    AGENT_TEST_ASSERT(ds4_agent_skill_registry_render(
+        &registry, &rendered, &rendered_bytes, err, sizeof(err)));
+    AGENT_TEST_ASSERT(rendered != NULL);
+    AGENT_TEST_ASSERT(rendered_bytes == strlen(rendered));
+    AGENT_TEST_ASSERT(strstr(rendered,
+        "[BEGIN DS4 ACTIVE SKILL name=alpha revision=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa]"));
+    AGENT_TEST_ASSERT(strstr(rendered,
+        "[END DS4 ACTIVE SKILL name=alpha]"));
+    AGENT_TEST_ASSERT(strstr(rendered, "alpha") < strstr(rendered, "beta"));
+    free(rendered);
+
+    AGENT_TEST_ASSERT(ds4_agent_skill_registry_remove(
+        &registry, "alpha", &changed));
+    AGENT_TEST_ASSERT(changed);
+    AGENT_TEST_ASSERT(registry.len == 1);
+    AGENT_TEST_ASSERT(ds4_agent_skill_registry_remove(
+        &registry, "alpha", &changed));
+    AGENT_TEST_ASSERT(!changed);
+    ds4_agent_skill_registry_free(&registry);
+}
