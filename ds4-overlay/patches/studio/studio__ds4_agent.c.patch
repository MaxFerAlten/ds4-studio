+    if (!w) {
+        snprintf(err, err_len, "agent worker is NULL");
+        return false;
+    }
+    if (respect_auto && !agent_sage_policy_auto_enabled()) {
+        agent_worker_clear_sage_policy(w);
+        return true;
+    }
+
+    char read_err[256] = {0};
+    char *prompt = agent_read_sage_skill(read_err, sizeof(read_err));
+    if (!prompt) {
+        agent_worker_clear_sage_policy(w);
+        snprintf(err, err_len, "%s", read_err[0] ? read_err :
+                 "Sage policy is unavailable");
+        return false;
+    }
+
+    char revision[41];
+    ds4_kvstore_sha1_bytes_hex(prompt, strlen(prompt), revision);
+    free(w->sage_prompt);
+    w->sage_prompt = prompt;
+    memcpy(w->sage_policy_revision, revision, sizeof(revision));
+    return true;
+}
+
+static bool agent_worker_restore_sage_policy(agent_worker *w,
+                                             char *err, size_t err_len) {
+    return agent_worker_load_sage_policy(w, true, err, err_len);
+}
+
+static bool agent_worker_activate_sage_policy(agent_worker *w,
+                                              char *err, size_t err_len) {
+    return agent_worker_load_sage_policy(w, false, err, err_len);
+}
+
+/* ---------------------------------------------------------------------------
+ * Lean policy loading
+ * ------------------------------------------------------------------------- */
+
+static bool agent_lean_policy_auto_enabled(void) {
+    const char *value = getenv("DS4_LEAN_POLICY_AUTO");
+    return !value || strcmp(value, "0") != 0;
+}
+
+static char *agent_read_lean_skill(char *err, size_t err_len) {
+    char path[PATH_MAX];
+    if (!agent_skill_path(path, sizeof(path), "lean", err, err_len))
+        return NULL;
+
+    char *data = NULL;
+    size_t len = 0;
+    if (agent_read_file_bytes(path, &data, &len, err, err_len) == 0 && data)
+        return data;
+
+    snprintf(err, err_len, "lean skill file not found at %.200s", path);
+    return NULL;
+}
+
+/* Stamp the compiled contract revision onto the worker and clear any recorded
+ * drift.
+ *
+ * Kept as an explicit step instead of reading the macro at every use site: the
+ * field is what the request carries and what the response is checked against, so
+ * a worker that never received it fails agent_worker_lean_contract_coherent()
+ * rather than silently agreeing with whatever the server says. */
+static void agent_worker_init_lean_contract(agent_worker *w) {
+    if (!w) return;
+    snprintf(w->lean_contract_revision, sizeof(w->lean_contract_revision),
+             "%s", DS4_LEAN_CONTRACT_REVISION);
+    w->lean_server_prompt_revision[0] = '\0';
+    w->lean_prompt_drift_detected = false;
+}
+
+static void agent_worker_clear_lean_policy(agent_worker *w) {
+    if (!w) return;
+    free(w->lean_prompt);
+    w->lean_prompt = NULL;
+    w->lean_policy_revision[0] = '\0';
+    w->lean_server_prompt_revision[0] = '\0';
+    w->lean_prompt_drift_detected = false;
+}
+
+static bool agent_worker_load_lean_policy(agent_worker *w,
+                                          bool respect_auto,
+                                          char *err, size_t err_len) {
+    if (!w) {
+        snprintf(err, err_len, "agent worker is NULL");
+        return false;
+    }
+    if (respect_auto && !agent_lean_policy_auto_enabled()) {
+        agent_worker_clear_lean_policy(w);
+        return true;
+    }
+
+    char read_err[256] = {0};
+    char *prompt = agent_read_lean_skill(read_err, sizeof(read_err));
+    if (!prompt) {
+        agent_worker_clear_lean_policy(w);
+        snprintf(err, err_len, "%s", read_err[0] ? read_err :
+                 "Lean policy is unavailable");
+        return false;
+    }
+
+    char revision[41];
+    ds4_kvstore_sha1_bytes_hex(prompt, strlen(prompt), revision);
+    free(w->lean_prompt);
+    w->lean_prompt = prompt;
+    memcpy(w->lean_policy_revision, revision, sizeof(revision));
+    /* Loading the policy is also what clears a recorded drift: this session now
+     * holds whatever is on disk, so the previous comparison is stale (§23.2). */
+    agent_worker_init_lean_contract(w);
+    return true;
+}
+
+static bool agent_worker_restore_lean_policy(agent_worker *w,
+                                             char *err, size_t err_len) {
+    return agent_worker_load_lean_policy(w, true, err, err_len);
+}
+
+/* The single predicate for "the Lean policy is usable in this session".
+ *
+ * Piano-rimedio 2 §5: the prompt builder advertised lean_check on
+ * `lean_prompt != NULL` while the dispatcher additionally required a
+ * revision, so the model could see a tool it was structurally unable to call.
+ * Every surface — advertisement, dispatch, status, idempotence — now asks this
+ * one question, and it verifies the revision against the content instead of
+ * trusting that it was ever assigned. */
+static bool agent_worker_lean_policy_coherent(const agent_worker *w) {
+    if (!w || !w->lean_prompt || !w->lean_policy_revision[0])
+        return false;
+    if (strlen(w->lean_policy_revision) != DS4_AGENT_SKILL_REVISION_HEX)
+        return false;
+
+    char actual[DS4_AGENT_SKILL_REVISION_HEX + 1];
+    ds4_kvstore_sha1_bytes_hex(w->lean_prompt, strlen(w->lean_prompt), actual);
+    return strcmp(actual, w->lean_policy_revision) == 0;
+}
+
+/* Unlike the prompt, the contract cannot drift compatibly: either both sides
+ * implement the same lean_check semantics or the result of a check means two
+ * different things. This only verifies the local half is present and is the one
+ * this binary was built with. */
+static bool agent_worker_lean_contract_coherent(const agent_worker *w) {
+    return w &&
+           strlen(w->lean_contract_revision) == DS4_LEAN_CONTRACT_REVISION_HEX &&
+           !strcmp(w->lean_contract_revision, DS4_LEAN_CONTRACT_REVISION);
+}
+
+/* Name the actual state instead of the generic LEAN_POLICY_UNAVAILABLE.
+ *
+ * The generic code taught the model to guess: it invented `/lean restart`,
+ * `sudo ds4-admin`, a Lean daemon and Docker. Each state below has exactly one
+ * supported recovery, and the payload says whether retrying is pointless
+ * (piano-rimedio 2 §10, §14.2). */
+static char *agent_lean_policy_incoherent_error(const agent_worker *w) {
+    const char *code;
+    const char *explain;
+    const char *recovery;
+    bool prompt_loaded = w && w->lean_prompt != NULL;
+    bool revision_loaded = w && w->lean_policy_revision[0] != '\0';
+
+    if (!prompt_loaded) {
+        code = "LEAN_POLICY_NOT_LOADED";
+        explain = "the Lean policy is not loaded in this session";
+        recovery = "run /lean start (or /skill lean start) before lean_check";
+    } else if (!revision_loaded) {
+        code = "LEAN_POLICY_REVISION_MISSING";
+        explain = "the Lean policy is loaded but its revision was never "
+                  "recorded, so the server cannot match it";
+        recovery = "run /lean start once: it repairs the session state";
+    } else {
+        code = "LEAN_POLICY_REVISION_MISMATCH_LOCAL";
+        explain = "the recorded Lean policy revision does not match the "
+                  "policy text held by this session";
+        recovery = "run /lean start once: it reapplies the policy";
+    }
+
+    agent_buf out = {0};
+    char header[512];
+    snprintf(header, sizeof(header),
+             "Tool error: %s — %s. Recovery: %s.\n", code, explain, recovery);
+    agent_buf_puts(&out, header);
+    char payload[512];
+    snprintf(payload, sizeof(payload),
+             "{\"code\":\"%s\",\"promptLoaded\":%s,\"revisionLoaded\":%s,"
+             "\"revisionMatchesContent\":false,\"toolAdvertised\":false,"
+             "\"retryable\":false,\"category\":\"state-coherence\","
+             "\"suggestedAction\":\"reapply-policy\"}\n",
+             code,
+             prompt_loaded ? "true" : "false",
+             revision_loaded ? "true" : "false");
+    agent_buf_puts(&out, payload);
+    agent_buf_puts(&out,
+                   "Do not invent recovery commands: there is no /lean restart, "
+                   "no ds4-admin, no Lean daemon and no container to restart.\n");
+    return agent_buf_take(&out);
+}
+
+/* Every lean_check failure carries the same machine-readable classification as
+ * the policy errors above: whether retrying can possibly help, what kind of
+ * failure it is, and the one supported next action. Without it the model
+ * treats every error as transient and burns its turn budget (§14.2). */
+static char *agent_lean_tool_error(bool final,
+                                   const char *code,
+                                   const char *category,
+                                   bool retryable,
+                                   const char *action,
+                                   const char *detail) {
+    agent_buf out = {0};
+    char header[512];
+    snprintf(header, sizeof(header), "%s: %s — %s\n",
+             final ? "FINAL" : "Tool error", code,
+             detail && detail[0] ? detail : "the Lean check could not be performed");
+    agent_buf_puts(&out, header);
+    char payload[384];
+    snprintf(payload, sizeof(payload),
+             "{\"code\":\"%s\",\"retryable\":%s,\"category\":\"%s\","
+             "\"suggestedAction\":\"%s\"}\n",
+             code, retryable ? "true" : "false", category, action);
+    agent_buf_puts(&out, payload);
+    return agent_buf_take(&out);
+}
+
+
+static bool agent_worker_activate_lean_policy(agent_worker *w,
+                                              char *err, size_t err_len) {
+    return agent_worker_load_lean_policy(w, false, err, err_len);
+}
+
+static char *agent_build_default_skills_block(const char *soul,
+                                              const char *ethic,
+                                              const char *structure) {
+    agent_buf b = {0};
+
+    const char *contents[] = {soul, ethic, structure};
+    const char *begins[] = {
+        DS4_SOUL_BEGIN, DS4_ETHIC_BEGIN, DS4_STRUCTURE_BEGIN
+    };
+    const char *ends[] = {
+        DS4_SOUL_END, DS4_ETHIC_END, DS4_STRUCTURE_END
+    };
+    for (size_t i = 0; i < 3; i++) {
+        if (!contents[i]) continue;
+        if (b.len) agent_buf_puts(&b, "\n\n");
+        agent_buf_puts(&b, begins[i]);
+        agent_buf_puts(&b, "\n");
+        agent_buf_puts(&b, contents[i]);
+        if (contents[i][0] &&
+            contents[i][strlen(contents[i]) - 1] != '\n')
+            agent_buf_puts(&b, "\n");
+        agent_buf_puts(&b, ends[i]);
+    }
+
+    return agent_buf_take(&b);
+}
+
+static bool agent_worker_restore_default_skills(agent_worker *w,
+                                                char *err,
+                                                size_t err_len) {
+    if (!w) {
+        snprintf(err, err_len, "agent worker is NULL");
+        return false;
+    }
+
+    if (!agent_default_skills_enabled()) {
+        free(w->soul_prompt);
+        free(w->ethic_prompt);
+        free(w->structure_prompt);
+        w->soul_prompt = NULL;
+        w->ethic_prompt = NULL;
+        w->structure_prompt = NULL;
+        w->default_skills_enabled = false;
+        w->soul_active = false;
+        w->ethic_active = false;
+        w->structure_active = false;
+        w->default_skills_revision[0] = '\0';
+        return true;
+    }
+
+    char soul_err[256] = {0};
+    char ethic_err[256] = {0};
+    char *new_soul = agent_read_soul_skill(soul_err, sizeof(soul_err));
+    if (!new_soul) {
+        snprintf(err, err_len, "%s", soul_err);
+        return false;
+    }
+
+    char *new_ethic = agent_read_ethic_skill(ethic_err, sizeof(ethic_err));
+    if (!new_ethic) {
+        free(new_soul);
+        snprintf(err, err_len, "%s", ethic_err);
+        return false;
+    }
+
+    char structure_err[256] = {0};
+    char *new_structure = agent_read_structure_skill(structure_err, sizeof(structure_err));
+    if (!new_structure) {
+        free(new_soul);
+        free(new_ethic);
+        snprintf(err, err_len, "%s", structure_err);
+        return false;
+    }
+
+    char *block = agent_build_default_skills_block(new_soul, new_ethic, new_structure);
+    if (!block) {
+        free(new_soul);
+        free(new_ethic);
+        free(new_structure);
+        snprintf(err, err_len, "failed to build default skills block");
+        return false;
+    }
+
+    char revision[41];
+    ds4_kvstore_sha1_bytes_hex(block, strlen(block), revision);
+    free(block);
+
+    free(w->soul_prompt);
+    free(w->ethic_prompt);
+    free(w->structure_prompt);
+    w->soul_prompt = new_soul;
+    w->ethic_prompt = new_ethic;
+    w->structure_prompt = new_structure;
+    w->default_skills_enabled = true;
+    w->soul_active = true;
+    w->ethic_active = true;
+    w->structure_active = true;
+    memcpy(w->default_skills_revision, revision, sizeof(revision));
+    return true;
+}
+
+static char *agent_worker_build_system_text_ex(const agent_worker *w,
+                                               char *err,
+                                               size_t err_len) {
+    if ((w->soul_active && !w->soul_prompt) ||
+        (w->ethic_active && !w->ethic_prompt) ||
+        (w->structure_active && !w->structure_prompt)) {
+        snprintf(err, err_len, "default skill state is incomplete");
+        return NULL;
+    }
+
+    char *dynamic_block = NULL;
+    size_t dynamic_bytes = 0;
+    if (!ds4_agent_skill_registry_render(&w->dynamic_skills,
+                                         &dynamic_block,
+                                         &dynamic_bytes,
+                                         err,
+                                         err_len))
+        return NULL;
+
+    agent_buf b = {0};
+    const char *base = w->cfg->gen.system;
+
+    if (base && base[0]) {
+        agent_buf_puts(&b, base);
+    }
+
+    if (w->metacognition_prompt) {
+        if (b.len) agent_buf_puts(&b, "\n\n");
+        agent_buf_puts(&b, DS4_METACOGNITION_BEGIN);
+        agent_buf_puts(&b, "\n");
+        agent_buf_puts(&b, w->metacognition_prompt);
+        if (w->metacognition_prompt[0] &&
+            w->metacognition_prompt[
+                strlen(w->metacognition_prompt) - 1] != '\n')
+            agent_buf_puts(&b, "\n");
+        agent_buf_puts(&b, DS4_METACOGNITION_END);
+    }
+
+    if (w->soul_active || w->ethic_active || w->structure_active) {
+        char *defaults = agent_build_default_skills_block(
+            w->soul_active ? w->soul_prompt : NULL,
+            w->ethic_active ? w->ethic_prompt : NULL,
+            w->structure_active ? w->structure_prompt : NULL);
+        if (b.len) agent_buf_puts(&b, "\n\n");
+        agent_buf_puts(&b, defaults);
+        free(defaults);
+    }
+
+    if (dynamic_bytes) {
+        if (b.len) agent_buf_puts(&b, "\n\n");
+        agent_buf_append(&b, dynamic_block, dynamic_bytes);
+    }
+    free(dynamic_block);
+
+    if (w->sage_prompt) {
+        if (b.len) agent_buf_puts(&b, "\n\n");
+        agent_buf_puts(&b, DS4_SAGE_BEGIN);
+        agent_buf_puts(&b, "\n");
+        agent_buf_puts(&b, w->sage_prompt);
+        if (w->sage_prompt[0] &&
+            w->sage_prompt[strlen(w->sage_prompt) - 1] != '\n')
+            agent_buf_puts(&b, "\n");
+        agent_buf_puts(&b, DS4_SAGE_END);
+    }
+
+    if (w->lean_prompt) {
+        if (b.len) agent_buf_puts(&b, "\n\n");
+        agent_buf_puts(&b, DS4_LEAN_BEGIN);
+        agent_buf_puts(&b, "\n");
+        agent_buf_puts(&b, w->lean_prompt);
+        if (w->lean_prompt[0] &&
+            w->lean_prompt[strlen(w->lean_prompt) - 1] != '\n')
+            agent_buf_puts(&b, "\n");
+        agent_buf_puts(&b, DS4_LEAN_END);
+    }
+
+    return agent_buf_take(&b);
+}
+
+static char *agent_worker_build_system_text(const agent_worker *w) {
+    char err[256] = {0};
+    return agent_worker_build_system_text_ex(w, err, sizeof(err));
+}
+
+static bool agent_worker_build_system_tokens(agent_worker *w,
+                                             ds4_tokens *out,
+                                             char *err,
+                                             size_t err_len) {
     ds4_chat_begin(w->engine, out);
     ds4_think_mode think_mode = effective_think_mode(w->cfg);
     if (ds4_engine_is_qwen4(w->engine)) {
@@ -5129,13 +7748,462 @@
     } else {
