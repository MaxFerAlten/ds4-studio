+static bool agent_test_epistemic_scan_has_code(
+        const ds4_epistemic_scan_result *scan, const char *code) {
+    if (scan == NULL || code == NULL) return false;
+    for (int i = 0; i < scan->finding_count; i++) {
+        if (!strcmp(scan->findings[i].code, code)) return true;
+    }
+    return false;
+}
