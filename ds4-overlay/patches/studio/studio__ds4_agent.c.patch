+/* F2.2 (doc3 E12) — the C dispatcher routes lean_inspect to the corrected
+ * adapter, end to end.
+ *
+ * Every other native inspect test calls agent_tool_lean_inspect_via_http
+ * directly, which is precisely the link E12 doubted: the tool name has to reach
+ * that function through agent_execute_tool_call, and the obligation it arms has
+ * to be the one lean_check later checks. Driving the dispatcher is the whole
+ * point — a wrong route here would still pass every existing inspect test. */
+static void test_agent_lean_inspect_dispatcher(void) {
+    agent_worker w;
+    memset(&w, 0, sizeof(w));
+    agent_config cfg = {0};
+    w.cfg = &cfg;
+    w.lean_prompt = (char *)"dummy policy";
+    agent_lean_turn_reset(&w.lean_turn);
+    ds4_kvstore_sha1_bytes_hex(w.lean_prompt, strlen(w.lean_prompt),
+                               w.lean_policy_revision);
+    agent_worker_init_lean_contract(&w);
+
+    agent_tool_arg check_args[4] = {
+        {.name = (char *)"code", .value = (char *)"theorem t : True := by trivial",
+         .is_string = true},
+        /* Every proof call names the declaration it is proving (WP-10). */
+        {.name = (char *)"task_mode", .value = (char *)"proof", .is_string = true},
+        {.name = (char *)"target_declaration", .value = (char *)"t",
+         .is_string = true},
+        /* §11.2 — a proof call states its target, so the target is not
+         * read off the candidate that is supposed to prove it. */
+        {.name = (char *)"target_statement",
+         .value = (char *)"theorem t : True", .is_string = true},
+    };
+    agent_tool_call check_call = {
+        .name = (char *)"lean_check", .args = check_args, .argc = 4};
+
+    /* WP-09: lean_check no longer requires a prior lean_inspect — discovery
+     * is optional, so the first call goes straight to the executor.
+     * If this passed for the wrong reason the test would prove nothing. */
+    {
+        agent_http_mock m = {0};
+        m.mode = AGENT_HTTP_MOCK_OK;
+        m.echo_run_id = true;
+        AGENT_TEST_ASSERT(agent_http_mock_start(&m));
+        cfg.frontend_port = m.port;
+
+        char *out = agent_execute_tool_call(&w, &check_call);
+        AGENT_TEST_ASSERT(out != NULL);
+        AGENT_TEST_ASSERT(out && !strstr(out, "LEAN_OBLIGATION_MISSING"));
+        AGENT_TEST_ASSERT(out && strstr(out, "lean_check status=checked"));
+        free(out);
+        agent_http_mock_stop(&m);
+    }
+
+    /* lean_inspect through the dispatcher reaches the inspect adapter: the
+     * reply is rendered from lean_inspect_result_v1, not from a proof result.
+     * The turn is reset first so the assertions below are about inspect and
+     * not about the proof the previous block legitimately verified. */
+    agent_lean_turn_reset(&w.lean_turn);
+    {
+        agent_http_mock m = {0};
+        m.mode = AGENT_HTTP_MOCK_OK;
+        m.body =
+            "{\"contractVersion\":\"lean_inspect_result_v1\","
+            "\"status\":\"inspected\","
+            "\"symbols\":[{\"name\":\"Nat.add_comm\","
+            "\"output\":\"Nat.add_comm : forall (n m : Nat), n + m = m + n\","
+            "\"status\":\"ok\"}],"
+            "\"displayText\":\"Nat.add_comm : forall (n m : Nat), n + m = m + n\","
+            "\"timedOut\":false}";
+        AGENT_TEST_ASSERT(agent_http_mock_start(&m));
+        cfg.frontend_port = m.port;
+
+        agent_tool_arg args[1] = {
+            {.name = (char *)"symbols", .value = (char *)"[\"Nat.add_comm\"]",
+             .is_string = true},
+        };
+        agent_tool_call call = {
+            .name = (char *)"lean_inspect", .args = args, .argc = 1};
+        char *out = agent_execute_tool_call(&w, &call);
+        AGENT_TEST_ASSERT(out != NULL);
+        AGENT_TEST_ASSERT(out && strstr(out, "Nat.add_comm : forall"));
+        AGENT_TEST_ASSERT(out && !strstr(out, "Tool error:"));
+        /* Never the proof executor's shape: inspect neither checks nor verifies. */
+        AGENT_TEST_ASSERT(out && !strstr(out, "lean_check status="));
+        AGENT_TEST_ASSERT(out && !strstr(out, "LEAN_ORCHESTRATION"));
+        AGENT_TEST_ASSERT(w.lean_turn.state != AGENT_LEAN_VERIFIED);
+        /* The request really went to the inspect endpoint. */
+        AGENT_TEST_ASSERT(m.req && strstr(m.req, "/api/lean/inspect"));
+        free(out);
+        agent_http_mock_stop(&m);
+    }
+
+}
