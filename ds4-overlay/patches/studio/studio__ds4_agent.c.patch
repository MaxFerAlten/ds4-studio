+static char *agent_prompt_insert_before(const char *src, const char *marker,
+                                        const char *extra) {
+    if (!extra || !extra[0]) return xstrdup(src);
+    const char *p = strstr(src, marker);
+    if (!p) {
+        size_t a = strlen(src), b = strlen(extra);
+        char *out = xmalloc(a + b + 1);
