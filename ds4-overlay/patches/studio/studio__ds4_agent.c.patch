+/* The guidance must escalate rather than repeat one syntax reminder: repeating
+ * the same reminder is what the reproduction transcript shows failing. */
+static void test_agent_protocol_guidance_escalates(void) {
+    ds4_agent_protocol_guard g;
+    ds4_agent_protocol_guard_reset(&g);
+    const char *err = "tool calling is not allowed inside <think></think>";
+
+    (void)ds4_agent_protocol_guard_record(&g, DS4_AGENT_PROTOCOL_FAILURE_DSML_IN_THINK,
+                                      err);
+    char *repair = ds4_agent_protocol_repair_guidance(
+        &g, DS4_AGENT_PROTOCOL_FAILURE_DSML_IN_THINK, err);
+    AGENT_TEST_ASSERT(strstr(repair, "TOOL_PROTOCOL_REPAIR_REQUIRED") != NULL);
+    AGENT_TEST_ASSERT(strstr(repair, "code=DSML_TOOL_INSIDE_THINK") != NULL);
+    AGENT_TEST_ASSERT(strstr(repair, "sameFailureCount=1") != NULL);
+    AGENT_TEST_ASSERT(strstr(repair, "terminal=false") != NULL);
+    AGENT_TEST_ASSERT(strstr(repair, "Close </think>") != NULL);
+
+    (void)ds4_agent_protocol_guard_record(&g, DS4_AGENT_PROTOCOL_FAILURE_DSML_IN_THINK,
+                                      err);
+    char *strategy = ds4_agent_protocol_strategy_guidance(
+        &g, DS4_AGENT_PROTOCOL_FAILURE_DSML_IN_THINK, err);
+    AGENT_TEST_ASSERT(
+        strstr(strategy, "TOOL_PROTOCOL_STRATEGY_CHANGE_REQUIRED") != NULL);
+    AGENT_TEST_ASSERT(strstr(strategy, "sameFailureCount=2") != NULL);
+    AGENT_TEST_ASSERT(
+        strstr(strategy, "Do not attempt another tool call") != NULL);
+    AGENT_TEST_ASSERT(strcmp(repair, strategy) != 0);
+
+    (void)ds4_agent_protocol_guard_record(&g, DS4_AGENT_PROTOCOL_FAILURE_DSML_IN_THINK,
+                                      err);
+    char *terminal = ds4_agent_protocol_terminal_notice(
+        &g, DS4_AGENT_PROTOCOL_FAILURE_DSML_IN_THINK, err);
+    AGENT_TEST_ASSERT(strstr(terminal, "TOOL_PROTOCOL_TERMINAL") != NULL);
+    AGENT_TEST_ASSERT(strstr(terminal, "code=TOOL_CONTRACT_FAILURE") != NULL);
+    AGENT_TEST_ASSERT(strstr(terminal, "terminal=true") != NULL);
+    AGENT_TEST_ASSERT(strstr(terminal, "sameFailureCount=3") != NULL);
+
+    free(repair);
+    free(strategy);
+    free(terminal);
+
+    /* PROTO-E2E-01 in counter form: replaying the observed transcript, the
+     * runtime spends at most three protocol rounds before it stops. */
+    ds4_agent_protocol_guard_reset(&g);
+    int rounds = 0;
+    for (int i = 0; i < 50; i++) {
