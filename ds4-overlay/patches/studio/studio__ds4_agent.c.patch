+typedef struct {
+    char joined[8192];
+    size_t joined_len;
+    size_t emits;
+    size_t invalid_emits;
+} agent_utf8_frame_probe;
+
+static void agent_utf8_frame_probe_cb(void *ud, const char *s, size_t n) {
+    agent_utf8_frame_probe *p = ud;
+    p->emits++;
+    if (!ds4_utf8_validate(s, n)) p->invalid_emits++;
+    if (p->joined_len + n + 1 > sizeof(p->joined)) return;
+    memcpy(p->joined + p->joined_len, s, n);
+    p->joined_len += n;
+    p->joined[p->joined_len] = '\0';
+}
+
+static void test_ds4_utf8_stream_feed_framing(void) {
+    /* §34 — the framing helper on its own, so a failure here points at the
+     * boundary rather than at the renderer that feeds it. */
+    const char *sentinel = AGENT_UTF8_SENTINEL;
+    size_t len = strlen(sentinel);
+
+    static const size_t chunks[] = {1, 2, 3, 4, 5, 7, 11, 64};
+    for (size_t ci = 0; ci < sizeof(chunks) / sizeof(chunks[0]); ci++) {
+        agent_utf8_frame_probe p;
+        memset(&p, 0, sizeof(p));
+        ds4_utf8_stream_state st;
+        ds4_utf8_stream_reset(&st);
+        for (size_t i = 0; i < len; i += chunks[ci]) {
+            size_t n = len - i < chunks[ci] ? len - i : chunks[ci];
+            AGENT_TEST_ASSERT(ds4_utf8_stream_feed(&st, sentinel + i, n,
+                                                   agent_utf8_frame_probe_cb, &p));
+        }
+        AGENT_TEST_ASSERT(ds4_utf8_stream_finished(&st));
+        AGENT_TEST_ASSERT(p.invalid_emits == 0);
+        AGENT_TEST_ASSERT(p.joined_len == len);
+        AGENT_TEST_ASSERT(memcmp(p.joined, sentinel, len) == 0);
+    }
+
+    /* A held tail must not be reported as finished, and must not be emitted. */
+    {
+        agent_utf8_frame_probe p;
+        memset(&p, 0, sizeof(p));
+        ds4_utf8_stream_state st;
+        ds4_utf8_stream_reset(&st);
+        const unsigned char head[] = {0xE2, 0x84};   /* first two bytes of R */
+        AGENT_TEST_ASSERT(ds4_utf8_stream_feed(&st, (const char *)head, 2,
+                                               agent_utf8_frame_probe_cb, &p));
+        AGENT_TEST_ASSERT(p.emits == 0);
+        AGENT_TEST_ASSERT(!ds4_utf8_stream_finished(&st));
+        const unsigned char tail[] = {0x9D};
+        AGENT_TEST_ASSERT(ds4_utf8_stream_feed(&st, (const char *)tail, 1,
+                                               agent_utf8_frame_probe_cb, &p));
+        AGENT_TEST_ASSERT(ds4_utf8_stream_finished(&st));
+        AGENT_TEST_ASSERT(p.joined_len == 3);
+        AGENT_TEST_ASSERT(memcmp(p.joined, "\xE2\x84\x9D", 3) == 0);
+    }
+
+    /* §35 — invalid input fails closed instead of turning into U+FFFD. */
+    {
+        agent_utf8_frame_probe p;
+        memset(&p, 0, sizeof(p));
+        ds4_utf8_stream_state st;
+        ds4_utf8_stream_reset(&st);
+        const unsigned char lone[] = {0x80};
+        AGENT_TEST_ASSERT(!ds4_utf8_stream_feed(&st, (const char *)lone, 1,
+                                                agent_utf8_frame_probe_cb, &p));
+
+        ds4_utf8_stream_reset(&st);
+        memset(&p, 0, sizeof(p));
+        const unsigned char broken[] = {0xE2, 0x84, 0x41};  /* tail replaced */
+        AGENT_TEST_ASSERT(!ds4_utf8_stream_feed(&st, (const char *)broken, 3,
+                                                agent_utf8_frame_probe_cb, &p));
+
+        ds4_utf8_stream_reset(&st);
+        memset(&p, 0, sizeof(p));
+        const unsigned char surrogate[] = {0xED, 0xA0, 0x80};
+        AGENT_TEST_ASSERT(!ds4_utf8_stream_feed(&st, (const char *)surrogate, 3,
+                                                agent_utf8_frame_probe_cb, &p));
+        AGENT_TEST_ASSERT(p.joined_len == 0);
+    }
+}
+
+static void test_renderer_plain_utf8_fragmentation(void) {
+    /* §28 — one byte per call, the shape the tool visualizer really uses. */
+    const char *sentinel = AGENT_UTF8_SENTINEL;
+    size_t len = strlen(sentinel);
+    agent_utf8_publish_probe p;
+
+    agent_utf8_probe_render(&p, sentinel, len, 1);
+
+    AGENT_TEST_ASSERT(!p.overflow);
+    AGENT_TEST_ASSERT(p.joined_len == len);
+    AGENT_TEST_ASSERT(memcmp(p.joined, sentinel, len) == 0);
+    /* The point of the test: no published chunk may carry a partial glyph. */
+    AGENT_TEST_ASSERT(p.invalid_chunks == 0);
+    AGENT_TEST_ASSERT(strstr(p.joined, "\xEF\xBF\xBD") == NULL);
+}
+
+static void test_renderer_plain_utf8_split_matrix(void) {
+    /* §29/§30 — every split position and a spread of chunk sizes, so the fix
+     * cannot be a special case for chunk==1. */
+    const char *sentinel = AGENT_UTF8_SENTINEL;
+    size_t len = strlen(sentinel);
+    agent_utf8_publish_probe p;
+
+    static const size_t chunks[] = {1, 2, 3, 4, 5, 7, 11, 64};
+    for (size_t ci = 0; ci < sizeof(chunks) / sizeof(chunks[0]); ci++) {
+        agent_utf8_probe_render(&p, sentinel, len, chunks[ci]);
+        AGENT_TEST_ASSERT(!p.overflow);
+        AGENT_TEST_ASSERT(p.joined_len == len);
+        AGENT_TEST_ASSERT(memcmp(p.joined, sentinel, len) == 0);
+        AGENT_TEST_ASSERT(p.invalid_chunks == 0);
+    }
+
+    /* Two calls, split at every byte offset including mid-sequence. */
+    for (size_t k = 0; k <= len; k++) {
+        agent_worker w;
+        memset(&w, 0, sizeof(w));
+        pthread_mutex_init(&w.mu, NULL);
+        w.wake_fd[0] = -1;
+        w.wake_fd[1] = -1;
+        w.publish_cb = agent_utf8_publish_probe_cb;
+        w.publish_ud = &p;
+
+        agent_token_renderer r;
+        memset(&r, 0, sizeof(r));
+        r.worker = &w;
+
+        memset(&p, 0, sizeof(p));
+        renderer_plain(&r, sentinel, k);
+        renderer_plain(&r, sentinel + k, len - k);
+        renderer_flush_utf8(&r);
+
+        AGENT_TEST_ASSERT(!p.overflow);
+        AGENT_TEST_ASSERT(p.joined_len == len);
+        AGENT_TEST_ASSERT(memcmp(p.joined, sentinel, len) == 0);
+        AGENT_TEST_ASSERT(p.invalid_chunks == 0);
+
+        free(w.out);
+        pthread_mutex_destroy(&w.mu);
+    }
+}
