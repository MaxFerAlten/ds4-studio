+static void agent_apply_logit_guards_compat(agent_worker *w,
+                                            const int *repeat_tokens,
+                                            int repeat_count,
+                                            float penalty,
+                                            const int *banned_tokens,
+                                            int banned_count) {
+    if (!w || !w->session) return;
+
+#if defined(__GNUC__) || defined(__clang__)
+    /* DS4-Studio cores that provide the native O(window) mutators keep the
+     * fast path.  Weak references stay NULL when building against upstream. */
+    if (ds4_session_penalize_logits && ds4_session_ban_logits) {
+        if (repeat_count > 0 && penalty > 1.0f)
+            ds4_session_penalize_logits(w->session, repeat_tokens,
+                                        repeat_count, penalty);
+        if (banned_count > 0)
+            ds4_session_ban_logits(w->session, banned_tokens, banned_count);
+        return;
+    }
+#endif
+
+    /* Upstream-compatible fallback.  It is used only when the optional native
+     * helpers are unavailable; copy/set_logits are part of the upstream API. */
+    int n_vocab = ds4_engine_vocab_size(w->engine);
+    if (n_vocab <= 0) return;
+    float *logits = xmalloc((size_t)n_vocab * sizeof(*logits));
+    int copied = ds4_session_copy_logits(w->session, logits, n_vocab);
+    if (copied != n_vocab) {
+        free(logits);
+        return;
+    }
+    if (repeat_tokens && repeat_count > 0 && penalty > 1.0f) {
+        for (int i = 0; i < repeat_count; i++) {
+            int t = repeat_tokens[i];
+            if (t < 0 || t >= n_vocab || !isfinite(logits[t])) continue;
+            float v = logits[t];
+            logits[t] = v > 0.0f ? v / penalty : v * penalty;
+        }
+    }
+    if (banned_tokens && banned_count > 0) {
+        for (int i = 0; i < banned_count; i++) {
+            int t = banned_tokens[i];
+            if (t >= 0 && t < n_vocab) logits[t] = -1e30f;
+        }
+    }
+    (void)ds4_session_set_logits(w->session, logits, n_vocab);
+    free(logits);
+}
