--- a/ds4_server.c
+++ b/ds4_server.c
@@ -22194,6 +22194,21 @@ static void test_kv_cache_eviction_score_decays_stale_hits(void) {
     TEST_ASSERT(f_on == 1.0 * (double)fresh.tokens / (double)fresh.file_size);
 }
 
+static void test_kv_cache_eviction_fresh_checkpoint_outranks_day_old_hit(void) {
+    /* A live session saved to disk before a side request (hits=0, stored
+     * now) must outlive a prompt that was hit once a day ago, even at a
+     * slightly better density: the session is restored seconds later. */
+    const uint64_t now = 1000u + 4u * KV_CACHE_HIT_HALF_LIFE_SECONDS;
+    kv_entry stale = {.tokens = 1100, .hits = 1, .file_size = 4096, .last_used = 1000};
+    kv_entry fresh = {.tokens = 1000, .hits = 0, .file_size = 4096, .last_used = now};
+    TEST_ASSERT(kv_entry_eviction_score(&stale, NULL, now, NULL) <
+                kv_entry_eviction_score(&fresh, NULL, now, NULL));
+    /* Just used, a hit still counts double. */
+    kv_entry hot = {.tokens = 1000, .hits = 1, .file_size = 4096, .last_used = now};
+    TEST_ASSERT(kv_entry_eviction_score(&hot, NULL, now, NULL) ==
+                2.0 * kv_entry_eviction_score(&fresh, NULL, now, NULL));
+}
