diff --git a/ds4_kvstore.c b/ds4_kvstore.c
index d9d3311..7db3cb5 100644
--- a/ds4_kvstore.c
+++ b/ds4_kvstore.c
@@ -543,15 +543,24 @@ double ds4_kvstore_entry_eviction_score(
     if (!e || e->file_size == 0) return 0.0;
     (void)live;
     double effective_hits = (double)e->hits;
+    /* The +1 every entry starts with ages like its hits.  Undecayed, any entry
+     * with one old hit outranked a checkpoint stored seconds ago (hits=0), so
+     * a full disk cache evicted the live session saved for an imminent
+     * restore and kept prompts from days before. */
+    double prior = 1.0;
     uint64_t used_at = e->last_used ? e->last_used : e->created_at;
     if (used_at == 0) {
         effective_hits = 0.0;
     } else if (now > used_at) {
         double elapsed = (double)(now - used_at);
-        effective_hits *= exp2(-elapsed / (double)DS4_KVSTORE_HIT_HALF_LIFE_SECONDS);
+        double decay = exp2(-elapsed / (double)DS4_KVSTORE_HIT_HALF_LIFE_SECONDS);
+        effective_hits *= decay;
         if (effective_hits < KV_CACHE_MIN_EFFECTIVE_HITS) effective_hits = 0.0;
+        /* Floored, so entries equally old still rank by density instead of
+         * all reaching 0 and tying. */
+        prior = decay > KV_CACHE_MIN_EFFECTIVE_HITS ? decay : KV_CACHE_MIN_EFFECTIVE_HITS;
     }
-    double score = (effective_hits + 1.0) *
+    double score = (effective_hits + prior) *
                    (double)e->tokens / (double)e->file_size;
     if (kv_cache_reason_is_anchor(e->reason))
         score *= KV_CACHE_ANCHOR_REASON_SCORE_FACTOR;
