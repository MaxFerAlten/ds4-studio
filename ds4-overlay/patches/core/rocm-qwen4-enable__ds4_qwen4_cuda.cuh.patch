diff --git a/ds4_qwen4_cuda.cuh b/ds4_qwen4_cuda.cuh
--- a/ds4_qwen4_cuda.cuh
+++ b/ds4_qwen4_cuda.cuh
@@ -1,8 +1,21 @@
 /* Qwen3.8 Flash Next. Included by ds4_cuda.cu so model residency, streams
  * and temporary allocations have the same lifetime as the other CUDA paths. */
-
-#include "ds4_qwen4_vision.h"
-
-namespace qwen4_cuda {
+
+#include "ds4_qwen4_vision.h"
+
+/* overlay rocm-qwen4-enable: HIP rejects a 32-bit __shfl_*_sync mask at
+ * compile time ("The mask must be a 64-bit integer"), because on a 64-lane
+ * wavefront 0xffffffff would silently describe half a wave. The literal is
+ * therefore named rather than widened in place, so the CUDA build keeps the
+ * exact value it had. Safe in both: every laneMask in this file is <= 16 and
+ * cannot cross a 32-lane boundary, and no kernel here reads warpSize -- lane
+ * indices are all threadIdx.x & 31 or threadIdx.x / 32. */
+#ifdef __HIP_PLATFORM_AMD__
+#define DS4_QWEN4_WARP_MASK 0xffffffffffffffffull
+#else
+#define DS4_QWEN4_WARP_MASK 0xffffffffu
+#endif
+
+namespace qwen4_cuda {
 
 __device__ __forceinline__ float sum(float x);
@@ -243,5 +243,5 @@
     for (unsigned d = col; d < D; d += 16)
         if (qr < group) mx = fmaxf(mx,fabsf(q[((uint64_t)t*H+h)*D+d]*scale));
-    for (unsigned off = 8; off; off /= 2) mx = fmaxf(mx,__shfl_xor_sync(0xffffffff,mx,off,16));
+    for (unsigned off = 8; off; off /= 2) mx = fmaxf(mx,__shfl_xor_sync(DS4_QWEN4_WARP_MASK,mx,off,16));
     const int exp = mx > 0 ? max(-120,min(120,(int)((__float_as_uint(mx)>>23)&255)-127)) : 0;
     const float inv = ldexpf(1,-exp);
@@ -290,5 +290,5 @@
             peak = fmaxf(peak,prob[i]);
         }
-        for (unsigned off = 8; off; off /= 2) peak = fmaxf(peak,__shfl_xor_sync(0xffffffff,peak,off,16));
+        for (unsigned off = 8; off; off /= 2) peak = fmaxf(peak,__shfl_xor_sync(DS4_QWEN4_WARP_MASK,peak,off,16));
         const float old = expf(max_score[qr]-peak);
         float total = 0;
@@ -298,5 +298,5 @@
             total += prob[i];
         }
-        for (unsigned off = 8; off; off /= 2) total += __shfl_xor_sync(0xffffffff,total,off,16);
+        for (unsigned off = 8; off; off /= 2) total += __shfl_xor_sync(DS4_QWEN4_WARP_MASK,total,off,16);
         __syncthreads();
         if (!col) {
@@ -376,5 +376,5 @@
 
 __device__ __forceinline__ float sum(float x) {
-    for (int d = 16; d; d >>= 1) x += __shfl_xor_sync(0xffffffff, x, d);
+    for (int d = 16; d; d >>= 1) x += __shfl_xor_sync(DS4_QWEN4_WARP_MASK, x, d);
     return x;
 }
@@ -1587,8 +1587,8 @@
         }
     }
-    for (unsigned off = 1; off <= 4; off *= 2) a += __shfl_xor_sync(0xffffffff, a, off);
-    float v = stream < hc ? sigmoid(a) * xn[((uint64_t)tok * hc + stream) * E + d] : 0;
-    v += __shfl_xor_sync(0xffffffff, v, 8);
-    v += __shfl_xor_sync(0xffffffff, v, 16);
+    for (unsigned off = 1; off <= 4; off *= 2) a += __shfl_xor_sync(DS4_QWEN4_WARP_MASK, a, off);
+    float v = stream < hc ? sigmoid(a) * xn[((uint64_t)tok * hc + stream) * E + d] : 0;
+    v += __shfl_xor_sync(DS4_QWEN4_WARP_MASK, v, 8);
+    v += __shfl_xor_sync(DS4_QWEN4_WARP_MASK, v, 16);
     if (!lane) out[(uint64_t)tok * E + d] = v / hc;
 }
