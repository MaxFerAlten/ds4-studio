@@ -37,3 +37,11 @@
 
 extern "C" uint64_t ds4_gpu_tp_big_gate_kick(...) { return 0; }
 ROCM_UNAVAILABLE_INT(ds4_gpu_tp_big_gate_wait)
+
+/* overlay rocm-deepseek41: tensor parallelism has no ROCm implementation, and
+ * the V4.1 support gate refuses any TP configuration before these can run.
+ * They exist so the V4.1 code paths link on ROCm. ds4_gpu_tp_failed() reports
